---
import {
  SITE_URL,
  ENTITY_CONFIG,
  getCanonicalUrl,
  buildOrganizationSchema,
  buildWebSiteSchema,
  buildSiteNavigationSchema,
  buildLocalBusinessSchema,
  buildSoftwareApplicationSchema,
  buildBreadcrumbSchema,
  buildFaqSchema,
  buildHowToSchema,
  buildBlogPostingSchema,
  buildServiceSchema
} from '../lib/seoConfig';

export interface Props {
  title: string;
  description: string;
  keywords?: string;
  image?: string;
  canonicalURL?: string;
  noindex?: boolean;
  isHome?: boolean;
  faqItems?: Array<{ question: string; answer: string }>;
  breadcrumbs?: Array<{ name: string; url: string }>;
  howToData?: {
    title: string;
    description: string;
    steps: Array<{ name: string; text: string; url?: string }>;
  };
  articleData?: {
    title: string;
    description: string;
    url: string;
    datePublished: string;
    dateModified?: string;
    category?: string;
    image?: string;
    authorName?: string;
  };
  serviceData?: {
    name: string;
    description: string;
    url: string;
    serviceType?: string;
  };
}

const {
  title,
  description,
  keywords = 'eDrops, water jar delivery app, 20L water jar subscription software, water delivery business software, bulk water delivery platform, mineral water delivery app, packaged drinking water distribution, water plant management software',
  image = '/og-image.jpg',
  canonicalURL,
  noindex = false,
  isHome = false,
  faqItems = [],
  breadcrumbs = [],
  howToData,
  articleData,
  serviceData
} = Astro.props;

const fullCanonicalURL = getCanonicalUrl(canonicalURL || Astro.url.href);
const absoluteImageUrl = image.startsWith('http') ? image : `${SITE_URL}${image.startsWith('/') ? '' : '/'}${image}`;

// Build structured data schemas
const organizationSchema = buildOrganizationSchema();
const webSiteSchema = buildWebSiteSchema();
const siteNavigationSchema = buildSiteNavigationSchema();
const softwareSchema = buildSoftwareApplicationSchema(description);
const localBusinessSchema = isHome ? buildLocalBusinessSchema() : null;
const breadcrumbSchema = breadcrumbs.length > 0 ? buildBreadcrumbSchema(breadcrumbs) : null;
const faqSchema = buildFaqSchema(faqItems, fullCanonicalURL);
const howToSchema = howToData ? buildHowToSchema(howToData.title, howToData.description, howToData.steps) : null;
const articleSchema = articleData ? buildBlogPostingSchema(articleData) : null;
const serviceSchema = serviceData ? buildServiceSchema(serviceData) : null;
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<link rel="canonical" href={fullCanonicalURL} />

<!-- Robots / Crawlers Directives -->
{noindex ? (
  <meta name="robots" content="noindex, follow" />
  <meta name="googlebot" content="noindex, follow" />
  <meta name="bingbot" content="noindex, follow" />
) : (
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
  <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
  <meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
)}

<!-- Entity & Author Knowledge Graph Meta -->
<meta name="author" content={ENTITY_CONFIG.brandName} />
<meta name="publisher" content={ENTITY_CONFIG.legalName} />
<meta name="application-name" content={ENTITY_CONFIG.brandName} />
<meta name="apple-mobile-web-app-title" content={ENTITY_CONFIG.brandName} />
<meta name="format-detection" content="telephone=no" />
<meta name="geo.region" content="IN-KL" />
<meta name="geo.placename" content="Kochi, Kerala, India" />
<meta name="geo.position" content={`${ENTITY_CONFIG.geo.latitude};${ENTITY_CONFIG.geo.longitude}`} />
<meta name="ICBM" content={`${ENTITY_CONFIG.geo.latitude}, ${ENTITY_CONFIG.geo.longitude}`} />

<!-- Open Graph / Facebook / LinkedIn / WhatsApp -->
<meta property="og:type" content={articleData ? 'article' : 'website'} />
<meta property="og:site_name" content={ENTITY_CONFIG.brandName} />
<meta property="og:url" content={fullCanonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={absoluteImageUrl} />
<meta property="og:image:secure_url" content={absoluteImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:alt" content="eDrops™ — 20L Water Jar Delivery & Subscription Software" />
<meta property="og:locale" content="en_IN" />

<!-- Twitter / X Cards -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@edrops_in" />
<meta name="twitter:creator" content="@edrops_in" />
<meta name="twitter:url" content={fullCanonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteImageUrl} />
<meta name="twitter:image:alt" content="eDrops™ — 20L Water Jar Delivery & Subscription Software" />

<!-- JSON-LD Structured Data for Rich Search Results -->
<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(webSiteSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(siteNavigationSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />

{localBusinessSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
)}

{breadcrumbSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
)}

{faqSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
)}

{howToSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
)}

{articleSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
)}

{serviceSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
)}

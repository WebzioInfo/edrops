---
import '../styles/navigation.css';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navLinks = [
  { href: '#how-it-works', label: 'How it Works' },
  { href: '#purpose-built', label: 'Purpose Built' },
  { href: '#why-it-works', label: 'Why it Works' },
  { href: '#for-business', label: 'For Business' },
];
---

<!-- Skip to content link (accessibility) -->
<a href="#main-content" class="nav-skip-link">Skip to content</a>

<!-- The Floating Island -->
<header id="nav-island" class="nav-island nav-island--entering" role="banner">
  <nav class="nav-island__surface" aria-label="Main navigation">
    
    <!-- Logo -->
    <a href="/" class="nav-island__logo" aria-label="Edrops home">
      <img src="/edrops-logo-full.png" alt="Edrops" class="nav-island__logo-full" />
      <img src="/edrops-icon-only.png" alt="Edrops" class="nav-island__logo-icon" />
    </a>

    <!-- Desktop Navigation Links -->
    <ul class="nav-island__links" role="list">
      {navLinks.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class="nav-island__link"
            data-nav-anchor={href.replace('#', '')}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>

    <!-- CTA Group -->
    <div class="nav-island__cta-group">
      <a href="https://app.edrops.in" class="nav-island__cta">
        Open App
      </a>
      
      <!-- Mobile Toggle -->
      <button
        type="button"
        class="nav-island__mobile-toggle"
        id="nav-mobile-toggle"
        aria-expanded="false"
        aria-controls="nav-mobile-menu"
        aria-label="Open navigation menu"
      >
        <span class="nav-island__toggle-icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </nav>
</header>

<!-- Mobile Menu Overlay -->
<div class="nav-island__mobile-menu" id="nav-mobile-menu" role="dialog" aria-label="Navigation menu" aria-modal="true">
  <div class="nav-island__mobile-backdrop" id="nav-mobile-backdrop"></div>
  <div class="nav-island__mobile-panel">
    <ul class="nav-island__mobile-links" role="list">
      {navLinks.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class="nav-island__mobile-link"
            data-nav-anchor={href.replace('#', '')}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
    <div class="nav-island__mobile-divider"></div>
    <div class="nav-island__mobile-cta-group">
      <a href="https://app.edrops.in" class="nav-island__mobile-cta">
        Open App
      </a>
    </div>
  </div>
</div>

<script>
  // ─── Scroll Detection & Header Collapse ───
  const island = document.getElementById('nav-island');
  if (island) {
    let isCollapsed = false;
    let ticking = false;
    const SCROLL_THRESHOLD = 50;

    const onScroll = () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          const scrollY = window.scrollY || window.pageYOffset;
          const shouldCollapse = scrollY > SCROLL_THRESHOLD;
          
          if (shouldCollapse !== isCollapsed) {
            isCollapsed = shouldCollapse;
            island.classList.toggle('nav-island--collapsed', isCollapsed);
          }
          ticking = false;
        });
        ticking = true;
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });

    // Remove entering animation class after it plays
    island.addEventListener('animationend', () => {
      island.classList.remove('nav-island--entering');
    }, { once: true });

    // Check initial scroll position
    if (window.scrollY > SCROLL_THRESHOLD) {
      island.classList.add('nav-island--collapsed');
      island.classList.remove('nav-island--entering');
      isCollapsed = true;
    }
  }

  // ─── Mobile Menu ───
  const toggle = document.getElementById('nav-mobile-toggle');
  const menu = document.getElementById('nav-mobile-menu');
  const backdrop = document.getElementById('nav-mobile-backdrop');

  let isOpen = false;

  const openMenu = () => {
    if (!island || !toggle || !menu) return;
    isOpen = true;
    island.classList.add('nav-island--mobile-open');
    menu.classList.add('nav-island__mobile-menu--open');
    toggle.setAttribute('aria-expanded', 'true');
    toggle.setAttribute('aria-label', 'Close navigation menu');
    document.body.classList.add('nav-mobile-open');
  };

  const closeMenu = () => {
    if (!island || !toggle || !menu) return;
    isOpen = false;
    island.classList.remove('nav-island--mobile-open');
    menu.classList.remove('nav-island__mobile-menu--open');
    toggle.setAttribute('aria-expanded', 'false');
    toggle.setAttribute('aria-label', 'Open navigation menu');
    document.body.classList.remove('nav-mobile-open');
  };

  if (toggle) {
    toggle.addEventListener('click', () => {
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });
  }

  if (backdrop) {
    backdrop.addEventListener('click', closeMenu);
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen) {
      closeMenu();
      toggle?.focus();
    }
  });

  const mediaQuery = window.matchMedia('(min-width: 768px)');
  mediaQuery.addEventListener('change', (e) => {
    if (e.matches && isOpen) {
      closeMenu();
    }
  });

  // ─── Active Section Scroll Spy & Smooth Scroll ───
  const navLinks = Array.from(document.querySelectorAll('[data-nav-anchor]')) as HTMLAnchorElement[];
  const sectionIds = ['how-it-works', 'purpose-built', 'why-it-works', 'for-business'];
  const sections = sectionIds
    .map(id => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  const updateActiveSection = () => {
    const scrollPosition = window.scrollY + 160;
    let currentActiveId = '';

    for (const section of sections) {
      const top = section.offsetTop;
      const height = section.offsetHeight;
      if (scrollPosition >= top && scrollPosition < top + height) {
        currentActiveId = section.id;
      }
    }

    // Bottom of page check
    if ((window.innerHeight + window.scrollY) >= document.documentElement.scrollHeight - 60) {
      if (sections.length > 0) {
        currentActiveId = sections[sections.length - 1].id;
      }
    }

    navLinks.forEach(link => {
      const anchor = link.getAttribute('data-nav-anchor');
      const isActive = Boolean(anchor && anchor === currentActiveId);
      link.classList.toggle('nav-island__link--active', isActive);
      link.classList.toggle('nav-island__mobile-link--active', isActive);
      if (isActive) {
        link.setAttribute('aria-current', 'true');
      } else {
        link.removeAttribute('aria-current');
      }
    });
  };

  window.addEventListener('scroll', updateActiveSection, { passive: true });
  window.addEventListener('load', updateActiveSection);
  updateActiveSection();

  // Close mobile menu on clicking any nav anchor link
  navLinks.forEach(link => {
    link.addEventListener('click', (e) => {
      const href = link.getAttribute('href');
      if (href && href.startsWith('#')) {
        const target = document.querySelector(href);
        if (target) {
          e.preventDefault();
          target.scrollIntoView({ behavior: 'smooth' });
          if (isOpen) {
            closeMenu();
          }
        }
      }
    });
  });
</script>

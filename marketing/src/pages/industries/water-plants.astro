---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Industries', url: '/industries/' },
  { name: 'Water Plants', url: '/industries/water-plants/' }
];

const serviceData = {
  name: 'eDrops Water Bottling Plant Management Software',
  description: 'Manage 20L water jar production lines, distributor vehicle dispatches, jar shrinkage reconciliation, and plant revenue accounting.',
  url: '/industries/water-plants/',
  serviceType: 'Manufacturing & Distribution Software'
};
---

<BaseLayout
  title="Water Plant Management Software | 20L Jar Production & Dispatch | eDrops™"
  description="Manage jar dispatch, delivery subscriptions, prepaid balances, staff, and reports for water plants with eDrops software."
  keywords="Water plant management software, 20L water bottling ERP, jar dispatch software, water factory management"
  breadcrumbs={breadcrumbs}
  serviceData={serviceData}
>
  <Navigation />

  <main class="mx-auto max-w-5xl px-5 pt-32 pb-24 text-edrops-ocean min-h-screen">
    <!-- Breadcrumb visual navigation -->
    <nav aria-label="Breadcrumb" class="mb-8">
      <ol class="flex items-center space-x-2 text-xs font-semibold text-edrops-slate">
        <li><a href="/" class="hover:text-edrops-primary transition-colors">Home</a></li>
        <li class="text-edrops-muted">/</li>
        <li><a href="/industries/" class="hover:text-edrops-primary transition-colors">Industries</a></li>
        <li class="text-edrops-muted">/</li>
        <li class="text-edrops-ocean font-bold" aria-current="page">Water Plants</li>
      </ol>
    </nav>

    <div class="space-y-10 max-w-3xl">
      <header class="space-y-4">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-edrops-primary">Production & Dispatch</span>
        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-edrops-ocean leading-tight">
          Water plant management built for 20L jar operations.
        </h1>
        <p class="text-lg text-edrops-slate leading-relaxed">
          eDrops helps water plants manage prepaid jar balances, customer subscriptions, route dispatch, staff actions, reports, and low-balance recharge opportunities from one unified platform.
        </p>
      </header>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-4">
        <div class="p-6 rounded-2xl bg-white border border-edrops-border shadow-xs space-y-2">
          <h2 class="text-lg font-bold text-edrops-ocean">Distributor Network Sync</h2>
          <p class="text-sm text-edrops-slate leading-relaxed">
            Manage allocations to downstream distributors and track outstanding bottle inventory across regions.
          </p>
        </div>
        <div class="p-6 rounded-2xl bg-white border border-edrops-border shadow-xs space-y-2">
          <h2 class="text-lg font-bold text-edrops-ocean">Batch & Route Dispatch</h2>
          <p class="text-sm text-edrops-slate leading-relaxed">
            Plan vehicle loading and delivery routes to ensure maximum truck capacity utilization and minimal empty miles.
          </p>
        </div>
      </div>

      <div class="pt-6">
        <a href="https://app.edrops.in" class="inline-flex rounded-full bg-edrops-secondary text-white text-sm font-bold px-8 py-3.5 shadow-md hover:bg-edrops-secondary-hover transition-colors">
          Schedule Plant Demo
        </a>
      </div>
    </div>
  </main>
</BaseLayout>

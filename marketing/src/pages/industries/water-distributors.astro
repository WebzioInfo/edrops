---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Industries', url: '/industries/' },
  { name: 'Water Distributors', url: '/industries/water-distributors/' }
];

const serviceData = {
  name: 'eDrops Water Distribution Software for Multi-Route Operations',
  description: 'Water distribution software for multi-route branch operations, driver tracking, customer subscriptions, and financial audit logs.',
  url: '/industries/water-distributors/',
  serviceType: 'Water Distribution Management Software'
};
---

<BaseLayout
  title="Water Distribution Software | Multi-Route & Branch Operations | eDrops™"
  description="Water distribution software for branch operations, staff delivery tracking, customer subscriptions, and analytics with eDrops."
  keywords="Water distribution software, water supplier software, bottled water distributor management, delivery fleet tracking"
  breadcrumbs={breadcrumbs}
  serviceData={serviceData}
>
  <Navigation />

  <main class="mx-auto max-w-5xl px-5 pt-32 pb-24 text-edrops-ocean min-h-screen">
    <!-- Breadcrumb visual navigation -->
    <nav aria-label="Breadcrumb" class="mb-8">
      <ol class="flex items-center space-x-2 text-xs font-semibold text-edrops-slate">
        <li><a href="/" class="hover:text-edrops-primary transition-colors">Home</a></li>
        <li class="text-edrops-muted">/</li>
        <li><a href="/industries/" class="hover:text-edrops-primary transition-colors">Industries</a></li>
        <li class="text-edrops-muted">/</li>
        <li class="text-edrops-ocean font-bold" aria-current="page">Water Distributors</li>
      </ol>
    </nav>

    <div class="space-y-10 max-w-3xl">
      <header class="space-y-4">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-edrops-primary">Fleet & Routes</span>
        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-edrops-ocean leading-tight">
          Water distribution software for route clarity.
        </h1>
        <p class="text-lg text-edrops-slate leading-relaxed">
          eDrops supports distributors with branch-ready data models, driver delivery workspaces, real-time customer balances, audit logs, and operational analytics.
        </p>
      </header>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-4">
        <div class="p-6 rounded-2xl bg-white border border-edrops-border shadow-xs space-y-2">
          <h2 class="text-lg font-bold text-edrops-ocean">Multi-Route Dispatch</h2>
          <p class="text-sm text-edrops-slate leading-relaxed">
            Assign delivery sectors to specific drivers with live doorstep completion confirmation.
          </p>
        </div>
        <div class="p-6 rounded-2xl bg-white border border-edrops-border shadow-xs space-y-2">
          <h2 class="text-lg font-bold text-edrops-ocean">Financial Integrity</h2>
          <p class="text-sm text-edrops-slate leading-relaxed">
            Eliminate cash leakages with automated prepaid deductions and immutable balance audit trails.
          </p>
        </div>
      </div>

      <div class="pt-6">
        <a href="https://app.edrops.in" class="inline-flex rounded-full bg-edrops-secondary text-white text-sm font-bold px-8 py-3.5 shadow-md hover:bg-edrops-secondary-hover transition-colors">
          Get Started as a Distributor
        </a>
      </div>
    </div>
  </main>
</BaseLayout>

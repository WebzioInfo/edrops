---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Industries', url: '/industries/' },
  { name: 'Delivery Network', url: '/industries/water-distributors/' }
];
---

<BaseLayout
  title="Delivery Network – 20L Water Jar Delivery – eDrops"
  description="Discover how eDrops organizes local delivery networks to ensure fast, dependable 20L water jar delivery across Kondotty and Malappuram."
  breadcrumbs={breadcrumbs}
  noindex={true}
>
  <Navigation />

  <main class="mx-auto max-w-5xl px-5 pt-32 pb-24 text-edrops-ocean min-h-screen">
    <!-- Breadcrumb visual navigation -->
    <nav aria-label="Breadcrumb" class="mb-8">
      <ol class="flex items-center space-x-2 text-xs font-semibold text-edrops-slate">
        <li><a href="/" class="hover:text-edrops-primary transition-colors">Home</a></li>
        <li class="text-edrops-muted">/</li>
        <li><a href="/industries/" class="hover:text-edrops-primary transition-colors">Industries</a></li>
        <li class="text-edrops-muted">/</li>
        <li class="text-edrops-ocean font-bold" aria-current="page">Delivery Network</li>
      </ol>
    </nav>

    <div class="space-y-10 max-w-3xl">
      <header class="space-y-4">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-edrops-primary">Local Reach</span>
        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-edrops-ocean leading-tight">
          Dependable local water delivery network
        </h1>
        <p class="text-lg text-edrops-slate leading-relaxed">
          eDrops coordinates dedicated local delivery partners to bring pure 20L water jars straight to your doorstep on a consistent schedule.
        </p>
      </header>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-4">
        <div class="p-6 rounded-2xl bg-white border border-edrops-border shadow-xs space-y-2">
          <h2 class="text-lg font-bold text-edrops-ocean">Organized Local Coverage</h2>
          <p class="text-sm text-edrops-slate leading-relaxed">
            Local neighborhoods are served on fixed days for reliable, on-time jar swaps.
          </p>
        </div>
        <div class="p-6 rounded-2xl bg-white border border-edrops-border shadow-xs space-y-2">
          <h2 class="text-lg font-bold text-edrops-ocean">Doorstep Verification</h2>
          <p class="text-sm text-edrops-slate leading-relaxed">
            Every delivery is confirmed digitally upon jar swap so your account remains 100% accurate.
          </p>
        </div>
      </div>

      <div class="pt-6">
        <a href="https://app.edrops.in" class="inline-flex rounded-full bg-edrops-secondary text-white text-sm font-bold px-8 py-3.5 shadow-md hover:bg-edrops-secondary-hover transition-colors">
          Order Water Jars Online
        </a>
      </div>
    </div>
  </main>
</BaseLayout>

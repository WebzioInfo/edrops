---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Industries', url: '/industries/' },
  { name: 'Water Plans', url: '/industries/water-subscription-companies/' }
];
---

<BaseLayout
  title="Water Plans – 20L Water Jar Delivery – eDrops"
  description="Explore convenient 20L water jar delivery plans with eDrops. Enjoy doorstep delivery, flexible scheduling, and simple prepaid wallet recharges."
  breadcrumbs={breadcrumbs}
  noindex={true}
>
  <Navigation />

  <main class="mx-auto max-w-5xl px-5 pt-32 pb-24 text-edrops-ocean min-h-screen">
    <!-- Breadcrumb visual navigation -->
    <nav aria-label="Breadcrumb" class="mb-8">
      <ol class="flex items-center space-x-2 text-xs font-semibold text-edrops-slate">
        <li><a href="/" class="hover:text-edrops-primary transition-colors">Home</a></li>
        <li class="text-edrops-muted">/</li>
        <li><a href="/industries/" class="hover:text-edrops-primary transition-colors">Industries</a></li>
        <li class="text-edrops-muted">/</li>
        <li class="text-edrops-ocean font-bold" aria-current="page">Water Plans</li>
      </ol>
    </nav>

    <div class="space-y-10 max-w-3xl">
      <header class="space-y-4">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-edrops-primary">Home & Office</span>
        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-edrops-ocean leading-tight">
          Reliable 20L water jar delivery plans
        </h1>
        <p class="text-lg text-edrops-slate leading-relaxed">
          The eDrops application gives you a visual, hassle-free way to keep drinking water stocked: check remaining jars at a glance and receive prompt doorstep swaps.
        </p>
      </header>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-4">
        <div class="p-6 rounded-2xl bg-white border border-edrops-border shadow-xs space-y-2">
          <h2 class="text-lg font-bold text-edrops-ocean">Visual Balance Tracker</h2>
          <p class="text-sm text-edrops-slate leading-relaxed">
            Check your remaining water jar balance anytime on mobile with complete clarity on upcoming delivery dates.
          </p>
        </div>
        <div class="p-6 rounded-2xl bg-white border border-edrops-border shadow-xs space-y-2">
          <h2 class="text-lg font-bold text-edrops-ocean">Flexible Schedules</h2>
          <p class="text-sm text-edrops-slate leading-relaxed">
            Set your frequency to daily, alternate days, or weekly. Pause anytime during travel with zero penalties.
          </p>
        </div>
      </div>

      <div class="pt-6">
        <a href="https://app.edrops.in" class="inline-flex rounded-full bg-edrops-secondary text-white text-sm font-bold px-8 py-3.5 shadow-md hover:bg-edrops-secondary-hover transition-colors">
          Order 20L Water Jars
        </a>
      </div>
    </div>
  </main>
</BaseLayout>

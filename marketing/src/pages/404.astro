---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
---

<BaseLayout
  title="404 — Page Not Found | eDrops™ Official Website"
  description="The requested page could not be found on eDrops. Use our quick links to navigate back to active 20L water jar delivery solutions and portals."
  noindex={true}
>
  <Navigation />

  <main class="flex min-h-screen items-center justify-center px-5 pt-28 pb-16 text-edrops-ocean">
    <section class="max-w-2xl w-full rounded-[2.5rem] bg-white border border-edrops-border/80 p-8 sm:p-12 text-center shadow-lg shadow-edrops-primary/[0.04]">
      <span class="inline-block px-4 py-1.5 rounded-full bg-edrops-primary/10 text-xs font-black uppercase tracking-[0.24em] text-edrops-primary">
        Status 404
      </span>
      <h1 class="mt-6 text-4xl sm:text-5xl font-extrabold tracking-tight text-edrops-ocean">
        This flow dried up.
      </h1>
      <p class="mt-4 text-base text-edrops-slate max-w-md mx-auto leading-relaxed">
        The link you followed may be broken or the page has moved. Explore our core services or return to the homepage:
      </p>

      <!-- Quick Helpful Navigation Links -->
      <div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-3 text-left">
        <a href="/" class="p-3.5 rounded-xl bg-edrops-light/60 hover:bg-edrops-light transition-colors text-center border border-edrops-border/60">
          <span class="block text-xs font-bold text-edrops-ocean">Home</span>
          <span class="text-[11px] text-edrops-slate">Main Page</span>
        </a>
        <a href="/features/" class="p-3.5 rounded-xl bg-edrops-light/60 hover:bg-edrops-light transition-colors text-center border border-edrops-border/60">
          <span class="block text-xs font-bold text-edrops-ocean">Features</span>
          <span class="text-[11px] text-edrops-slate">Platform Tools</span>
        </a>
        <a href="/pricing/" class="p-3.5 rounded-xl bg-edrops-light/60 hover:bg-edrops-light transition-colors text-center border border-edrops-border/60">
          <span class="block text-xs font-bold text-edrops-ocean">Pricing</span>
          <span class="text-[11px] text-edrops-slate">Plans & Rates</span>
        </a>
        <a href="/faq/" class="p-3.5 rounded-xl bg-edrops-light/60 hover:bg-edrops-light transition-colors text-center border border-edrops-border/60">
          <span class="block text-xs font-bold text-edrops-ocean">FAQ</span>
          <span class="text-[11px] text-edrops-slate">Common Help</span>
        </a>
      </div>

      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/" class="w-full sm:w-auto inline-flex items-center justify-center rounded-full bg-edrops-secondary text-white text-sm font-bold px-8 py-3.5 shadow-md hover:bg-edrops-secondary-hover transition-colors">
          Back to Homepage
        </a>
        <a href="/contact/" class="w-full sm:w-auto inline-flex items-center justify-center rounded-full bg-edrops-light text-edrops-ocean text-sm font-bold px-8 py-3.5 border border-edrops-border hover:bg-white transition-colors">
          Contact Support
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

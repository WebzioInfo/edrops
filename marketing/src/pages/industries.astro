---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Industries', url: '/industries/' }
];

const industrySolutions = [
  {
    title: 'Water Bottling Plants & RO Units',
    href: '/industries/water-plants/',
    description: 'Manage daily bottling batches, distributor allocations, route dispatches, and empty jar tracking.'
  },
  {
    title: 'Water Distributors',
    href: '/industries/water-distributors/',
    description: 'Multi-route fleet coordination, branch-ready data models, driver workspaces, and operational analytics.'
  },
  {
    title: 'Water Agencies',
    href: '/industries/water-agencies/',
    description: 'Replace paper notebooks with digital subscription schedules, balance intelligence, and delivery proof.'
  },
  {
    title: 'Water Subscription Companies',
    href: '/industries/water-subscription-companies/',
    description: 'Deliver modern customer experiences with scheduled deliveries, prepaid wallets, and zero invoice friction.'
  }
];
---

<BaseLayout
  title="eDrops™ Industry Solutions | Software for Water Plants, Distributors & Agencies"
  description="Discover how eDrops powers water packaging plants, distribution agencies, bulk suppliers, and subscription water delivery fleets across India."
  keywords="Water distribution software, water plant management software, water agency delivery software, commercial bottled water platform"
  breadcrumbs={breadcrumbs}
>
  <Navigation />

  <main id="main-content" class="pt-32 pb-24 px-5 max-w-6xl mx-auto min-h-screen">
    <!-- Breadcrumb visual navigation -->
    <nav aria-label="Breadcrumb" class="mb-8">
      <ol class="flex items-center space-x-2 text-xs font-semibold text-edrops-slate">
        <li><a href="/" class="hover:text-edrops-primary transition-colors">Home</a></li>
        <li class="text-edrops-muted">/</li>
        <li class="text-edrops-ocean font-bold" aria-current="page">Industries</li>
      </ol>
    </nav>

    <div class="space-y-12">
      <header class="max-w-3xl space-y-4">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-edrops-primary">Vertical Solutions</span>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-edrops-ocean tracking-tight">
          Industries We Serve
        </h1>
        <p class="text-lg text-edrops-slate leading-relaxed">
          Tailored software architectures designed for every tier of the packaged drinking water supply chain.
        </p>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4">
        {industrySolutions.map((sol) => (
          <article class="p-8 rounded-2xl bg-white border border-edrops-border shadow-xs hover:border-edrops-primary/40 hover:shadow-md transition-all flex flex-col justify-between">
            <div class="space-y-3">
              <h2 class="text-xl font-bold text-edrops-ocean">
                <a href={sol.href} class="hover:text-edrops-primary transition-colors">
                  {sol.title}
                </a>
              </h2>
              <p class="text-sm text-edrops-slate leading-relaxed">
                {sol.description}
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-edrops-border/40">
              <a href={sol.href} class="text-xs font-bold text-edrops-primary hover:underline inline-flex items-center gap-1">
                Explore industry solution <span>→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </main>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import '../styles/capabilities.css';
import '../styles/journey.css';

const metrics = [
  ['99.4%', 'On-time delivery rate'],
  ['3×', 'Faster route planning'],
  ['100%', 'Prepaid cashflow'],
  ['0', 'Outstanding invoices'],
];
---

<BaseLayout
  title="Edrops — The Operating System for Modern Water Businesses"
  description="Edrops is the premium platform for 20L water subscription businesses. Prepaid wallets, automated deliveries, route intelligence, and customer trust — beautifully unified."
>

  <Navigation />

  <main id="main-content" class="overflow-hidden">

    {/* ═══════════════════════════════════════
        HERO — THE BRAND STATEMENT
        ═══════════════════════════════════════ */}
    <section class="hero-atmosphere relative min-h-screen flex flex-col items-center justify-center text-center px-6">
      
      {/* Ambient volumetric light glows */}
      <div class="hero-glow-1"></div>
      <div class="hero-glow-2"></div>
      <div class="hero-glow-3"></div>

      <div class="relative z-10 mx-auto max-w-4xl pt-24 pb-20 sm:pb-28 space-y-10">
        
        {/* Eyebrow */}
        <div class="animate-fade-up">
          <span class="inline-flex items-center gap-2.5 rounded-full border border-edrops-border/60 bg-white/60 backdrop-blur-md px-4 py-2 text-xs font-semibold text-edrops-primary tracking-wide">
            <span class="w-1.5 h-1.5 rounded-full bg-edrops-aqua animate-pulse"></span>
            The water subscription engine
          </span>
        </div>
        
        {/* Headline — The Hero */}
        <div class="animate-fade-up-delay-1 space-y-6">
          <h1 class="text-[clamp(2.5rem,7vw,5.5rem)] font-extrabold leading-[1.04] tracking-[-0.035em] text-edrops-ocean">
            Water subscriptions,<br>
            <span class="text-gradient-water">beautifully managed.</span>
          </h1>
        </div>

        {/* Subline */}
        <p class="animate-fade-up-delay-2 text-lg sm:text-xl text-edrops-slate font-normal leading-relaxed max-w-2xl mx-auto">
          Edrops is the calm, intelligent platform where prepaid wallets, recurring deliveries, and customer trust come together — built specifically for 20L water jar businesses.
        </p>

        {/* CTAs */}
        <div class="animate-fade-up-delay-3 flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
          <a
            href="http://localhost:5173/login"
            class="inline-flex items-center justify-center rounded-full bg-edrops-secondary text-white text-[15px] font-bold px-9 py-4 btn-glow"
          >
            Start Free
          </a>
          <a
            href="/features"
            class="inline-flex items-center justify-center rounded-full bg-white border border-edrops-border text-edrops-ocean text-[15px] font-bold px-9 py-4 btn-glass"
          >
            Explore Platform
          </a>
        </div>

        {/* Trust Indicators */}
        <div class="animate-fade-up-delay-4 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs font-medium text-edrops-muted pt-4">
          <span class="flex items-center gap-1.5"><span class="text-edrops-aqua">✓</span> Subscription Ready</span>
          <span class="flex items-center gap-1.5"><span class="text-edrops-aqua">✓</span> Prepaid Wallets</span>
          <span class="flex items-center gap-1.5"><span class="text-edrops-aqua">✓</span> Real-time Dispatch</span>
          <span class="flex items-center gap-1.5"><span class="text-edrops-aqua">✓</span> Customer Portal</span>
        </div>

      </div>

      {/* Scroll indicator */}
      <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 animate-fade-up-delay-5">
        <div class="w-6 h-10 rounded-full border-2 border-edrops-muted/40 flex items-start justify-center pt-2">
          <div class="w-1 h-2.5 rounded-full bg-edrops-muted/50 animate-bounce"></div>
        </div>
      </div>
    </section>


    {/* ═══════════════════════════════════════
        METRICS — IMMEDIATE PROOF
        ═══════════════════════════════════════ */}
    <section class="py-20 px-6">
      <div class="mx-auto max-w-5xl">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          {metrics.map(([value, label]) => (
            <div class="text-center space-y-2 py-6">
              <p class="text-3xl sm:text-4xl font-extrabold tracking-tight text-edrops-ocean">{value}</p>
              <p class="text-sm font-medium text-edrops-slate">{label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>


    {/* ═══════════════════════════════════════
        CAPABILITIES — WHY EDROPS
        ═══════════════════════════════════════ */}
    <section class="capabilities-section py-28 sm:py-36 px-6" id="capabilities-section">
      
      {/* Ambient background elements */}
      <div class="capabilities-caustic"></div>
      <div class="capabilities-shape capabilities-shape--1"></div>
      <div class="capabilities-shape capabilities-shape--2"></div>
      <div class="capabilities-shape capabilities-shape--3"></div>

      <div class="mx-auto max-w-6xl space-y-20 sm:space-y-28">
        
        {/* Editorial Header */}
        <div class="capabilities-header">
          <div class="capabilities-eyebrow">
            <span class="text-xs font-bold uppercase tracking-[0.2em] text-edrops-primary">
              Purpose-built
            </span>
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-[3.25rem] font-extrabold tracking-tight text-edrops-ocean leading-[1.08]">
            Not ERP. Not a delivery clone.<br>
            <span class="text-gradient-water">Water subscription intelligence.</span>
          </h2>
        </div>

        {/* Asymmetric Feature Grid */}
        <div class="capabilities-grid">
          
          {/* Feature 1 — Hero Card (largest, introduces the idea) */}
          <article class="capability-card capability-card--hero" data-capability="0">
            <div class="capability-card__light"></div>
            <span class="capability-card__number" aria-hidden="true">01</span>
            <h3 class="capability-card__title">Subscription Intelligence</h3>
            <p class="capability-card__text">Recurring delivery schedules that adapt to customer rhythms. Pause, skip, reschedule — without losing a single subscription.</p>
          </article>

          {/* Feature 2 — Secondary Card (expands the idea) */}
          <article class="capability-card capability-card--secondary capability-card--delay-1" data-capability="1">
            <div class="capability-card__light"></div>
            <span class="capability-card__number" aria-hidden="true">02</span>
            <h3 class="capability-card__title">Prepaid Wallet Engine</h3>
            <p class="capability-card__text">Customers recharge their jar balance upfront. Every delivery consumes balance automatically. Zero chasing. Zero invoices.</p>
          </article>

          {/* Feature 3 — Tertiary Card (completes the story) */}
          <article class="capability-card capability-card--tertiary capability-card--delay-2" data-capability="2">
            <div class="capability-card__light"></div>
            <span class="capability-card__number" aria-hidden="true">03</span>
            <h3 class="capability-card__title">Operational Clarity</h3>
            <p class="capability-card__text">Routes optimized. Drivers dispatched. Exceptions flagged. Low-balance customers notified — before they run out.</p>
          </article>

        </div>
      </div>
    </section>

    <script>
      // ─── Capabilities: Scroll Reveal + Cursor Light ───
      {
        const section = document.getElementById('capabilities-section');
        if (section) {
          // Intersection Observer for scroll-triggered reveals
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                section.classList.add('capabilities--visible');
                // Reveal each card with stagger
                const cards = section.querySelectorAll('.capability-card');
                cards.forEach((card) => {
                  card.classList.add('capability-card--visible');
                });
                observer.unobserve(entry.target);
              }
            });
          }, {
            threshold: 0.15,
            rootMargin: '0px 0px -60px 0px'
          });

          observer.observe(section);

          // Cursor-tracking light effect on cards
          const cards = section.querySelectorAll('.capability-card');
          cards.forEach((card) => {
            card.addEventListener('mousemove', (e) => {
              const rect = card.getBoundingClientRect();
              const x = ((e.clientX - rect.left) / rect.width) * 100;
              const y = ((e.clientY - rect.top) / rect.height) * 100;
              const light = card.querySelector('.capability-card__light');
              if (light) {
                light.style.setProperty('--mouse-x', x + '%');
                light.style.setProperty('--mouse-y', y + '%');
              }
            });
          });
        }
      }
    </script>



    {/* ═══════════════════════════════════════
        HOW IT WORKS — TIMELINE STORYTELLING
        ═══════════════════════════════════════ */}
    <section class="py-24 sm:py-32 px-6">
      <div class="mx-auto max-w-5xl">
        <div class="journey-section p-10 sm:p-16 lg:p-20 text-white" id="journey-section">
          
          {/* Ambient glows */}
          <div class="journey-glow journey-glow--1"></div>
          <div class="journey-glow journey-glow--2"></div>
          <div class="journey-glow journey-glow--3"></div>
          
          {/* Completion glow */}
          <div class="journey-completion"></div>

          <div class="relative z-10 space-y-16 sm:space-y-24">
            
            {/* Editorial Header */}
            <div class="journey-header">
              <div class="journey-header__eyebrow">
                <span class="text-xs font-bold uppercase tracking-[0.2em] text-edrops-aqua">
                  How it works
                </span>
              </div>
              <h2 class="text-3xl sm:text-4xl lg:text-[2.75rem] font-extrabold tracking-tight leading-[1.1]">
                Three steps to recurring water revenue.
              </h2>
            </div>

            {/* ═══════════════════════════════════════════════════════════════
                DESKTOP TIMELINE EXPERIENCE (>= 768px)
                ═══════════════════════════════════════════════════════════════ */}
            <div class="journey-timeline">
              
              {/* The Flowing Path */}
              <div class="journey-path">
                <div class="journey-path__track"></div>
                <div class="journey-path__fill"></div>
                <div class="journey-path__light"></div>
              </div>

              {/* ── Step 01: Recharge ── */}
              <div class="journey-milestone" data-step="1">
                <div class="journey-visual journey-visual--recharge">
                  <div class="journey-visual__icon">
                    <div class="journey-visual__pulse"></div>
                  </div>
                </div>
                
                <div class="journey-node">
                  <div class="journey-node__dot">
                    <span>01</span>
                    <div class="journey-node__ring"></div>
                  </div>
                </div>
                
                <article class="journey-step-card">
                  <div class="journey-step-card__light"></div>
                  <h3 class="journey-step-card__title">Recharge</h3>
                  <p class="journey-step-card__text">Customers purchase jar passes upfront via UPI, card, or wallet top-up.</p>
                </article>
              </div>

              {/* ── Step 02: Deliver ── */}
              <div class="journey-milestone" data-step="2">
                <div class="journey-visual journey-visual--deliver">
                  <div class="journey-visual__icon"></div>
                </div>
                
                <div class="journey-node">
                  <div class="journey-node__dot">
                    <span>02</span>
                    <div class="journey-node__ring"></div>
                  </div>
                </div>
                
                <article class="journey-step-card">
                  <div class="journey-step-card__light"></div>
                  <h3 class="journey-step-card__title">Deliver</h3>
                  <p class="journey-step-card__text">Drivers receive optimized routes. Each delivery auto-deducts from balance.</p>
                </article>
              </div>

              {/* ── Step 03: Predict ── */}
              <div class="journey-milestone" data-step="3">
                <div class="journey-visual journey-visual--predict">
                  <div class="journey-visual__icon">
                    <div class="journey-visual__pulse"></div>
                  </div>
                </div>
                
                <div class="journey-node">
                  <div class="journey-node__dot">
                    <span>03</span>
                    <div class="journey-node__ring"></div>
                  </div>
                </div>
                
                <article class="journey-step-card">
                  <div class="journey-step-card__light"></div>
                  <h3 class="journey-step-card__title">Predict</h3>
                  <p class="journey-step-card__text">Edrops forecasts recharge timing and notifies customers before supply runs low.</p>
                </article>
              </div>

            </div>

            {/* ═══════════════════════════════════════════════════════════════
                PURPOSE-BUILT MOBILE STACKED EXPERIENCE (< 768px)
                Apple Wallet / iOS Settings style interactive cards
                ═══════════════════════════════════════════════════════════════ */}
            <div class="journey-mobile-cards" id="journey-mobile-cards">
              
              {/* Mobile Card 1: Recharge */}
              <div class="journey-mobile-card journey-mobile-card--active" data-mobile-step="1">
                <div class="journey-mobile-card__header">
                  <div class="journey-mobile-card__left">
                    <div class="journey-mobile-badge">
                      <span>01</span>
                    </div>
                    <div>
                      <h3 class="journey-mobile-title">Recharge</h3>
                      <div class="journey-mobile-subtitle">Step 01</div>
                    </div>
                  </div>
                  <div class="journey-mobile-chevron" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </div>
                </div>
                <div class="journey-mobile-card__content">
                  <div class="journey-mobile-card__inner">
                    <p class="journey-mobile-text">Customers purchase jar passes upfront via UPI, card, or wallet top-up.</p>
                  </div>
                </div>
              </div>

              {/* Mobile Card 2: Deliver */}
              <div class="journey-mobile-card" data-mobile-step="2">
                <div class="journey-mobile-card__header">
                  <div class="journey-mobile-card__left">
                    <div class="journey-mobile-badge">
                      <span>02</span>
                    </div>
                    <div>
                      <h3 class="journey-mobile-title">Deliver</h3>
                      <div class="journey-mobile-subtitle">Step 02</div>
                    </div>
                  </div>
                  <div class="journey-mobile-chevron" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </div>
                </div>
                <div class="journey-mobile-card__content">
                  <div class="journey-mobile-card__inner">
                    <p class="journey-mobile-text">Drivers receive optimized routes. Each delivery auto-deducts from balance.</p>
                  </div>
                </div>
              </div>

              {/* Mobile Card 3: Predict */}
              <div class="journey-mobile-card" data-mobile-step="3">
                <div class="journey-mobile-card__header">
                  <div class="journey-mobile-card__left">
                    <div class="journey-mobile-badge">
                      <span>03</span>
                    </div>
                    <div>
                      <h3 class="journey-mobile-title">Predict</h3>
                      <div class="journey-mobile-subtitle">Step 03</div>
                    </div>
                  </div>
                  <div class="journey-mobile-chevron" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </div>
                </div>
                <div class="journey-mobile-card__content">
                  <div class="journey-mobile-card__inner">
                    <p class="journey-mobile-text">Edrops forecasts recharge timing and notifies customers before supply runs low.</p>
                  </div>
                </div>
              </div>

            </div>

          </div>
        </div>
      </div>
    </section>

    <script>
      // ─── Journey Storytelling Experience (Desktop + Mobile) ───
      {
        const journeySection = document.getElementById('journey-section');
        if (journeySection) {
          // 1. Section Entrance Observer
          const sectionObserver = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                journeySection.classList.add('journey--visible');
                sectionObserver.unobserve(entry.target);
              }
            });
          }, { threshold: 0.1 });
          
          sectionObserver.observe(journeySection);

          // 2. Desktop Timeline Milestone Observer
          const milestones = journeySection.querySelectorAll('.journey-milestone');
          if (milestones.length > 0) {
            const milestoneObserver = new IntersectionObserver((entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('journey-milestone--active');
                  const allActive = [...milestones].every(m => 
                    m.classList.contains('journey-milestone--active')
                  );
                  if (allActive) {
                    journeySection.classList.add('journey--step-active');
                  }
                  milestoneObserver.unobserve(entry.target);
                }
              });
            }, {
              threshold: 0.3,
              rootMargin: '0px 0px -40px 0px'
            });
            
            milestones.forEach((m) => milestoneObserver.observe(m));
          }

          // 3. Desktop Cursor-tracking light on cards
          const desktopCards = journeySection.querySelectorAll('.journey-step-card');
          desktopCards.forEach((card) => {
            card.addEventListener('mousemove', (e) => {
              const rect = card.getBoundingClientRect();
              const x = ((e.clientX - rect.left) / rect.width) * 100;
              const y = ((e.clientY - rect.top) / rect.height) * 100;
              const light = card.querySelector('.journey-step-card__light');
              if (light) {
                light.style.setProperty('--mouse-x', x + '%');
                light.style.setProperty('--mouse-y', y + '%');
              }
            });
          });

          // 4. Mobile Stacked Cards Interactive Controller
          const mobileCards = journeySection.querySelectorAll('.journey-mobile-card');
          if (mobileCards.length > 0) {
            // Tap / Click Handler
            mobileCards.forEach((mCard) => {
              mCard.addEventListener('click', () => {
                const isActive = mCard.classList.contains('journey-mobile-card--active');
                mobileCards.forEach(c => c.classList.remove('journey-mobile-card--active'));
                if (!isActive) {
                  mCard.classList.add('journey-mobile-card--active');
                }
              });
            });

            // Scroll-triggered Expansion for Mobile
            const mobileCardObserver = new IntersectionObserver((entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  // Activate card as user scrolls it into viewport focus
                  mobileCards.forEach(c => c.classList.remove('journey-mobile-card--active'));
                  entry.target.classList.add('journey-mobile-card--active');
                }
              });
            }, {
              threshold: 0.6,
              rootMargin: '-10% 0px -20% 0px'
            });

            mobileCards.forEach(mCard => mobileCardObserver.observe(mCard));
          }
        }
      }
    </script>


  </main>
</BaseLayout>

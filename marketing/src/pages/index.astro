---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import '../styles/capabilities.css';

const metrics = [
  ['99.4%', 'On-time delivery rate'],
  ['3×', 'Faster route planning'],
  ['100%', 'Prepaid cashflow'],
  ['100+', 'Outstanding invoices'],
];

const faqItems = [
  {
    question: "What is Edrops and how does 20L water jar subscription software work?",
    answer: "Edrops is an all-in-one software platform built specifically for 20L water jar delivery businesses, water plants, and distributors. It automates recurring delivery schedules, prepaid digital balances, driver route dispatch, and customer accounts in one unified interface."
  },
  {
    question: "How does the prepaid wallet and jar recharge system work?",
    answer: "Customers top up their digital jar wallet upfront. When a delivery partner completes a doorstep delivery, jar counts automatically deduct from the customer's prepaid balance in real time. Customers receive instant verification receipts without paper invoices."
  },
  {
    question: "Can offices and businesses order water jars in bulk?",
    answer: "Yes, Edrops offers dedicated bulk ordering for offices, cafes, clinics, and commercial facilities with volume-scaled rates, customized delivery calendars, monthly consumption reports, and single-point-of-contact support."
  },
  {
    question: "Can customers pause, skip, or modify delivery days?",
    answer: "Yes. Customers have 24/7 access to their self-service portal to pause deliveries during vacations, skip a drop, adjust jar quantities, or place one-time ad-hoc orders anytime without phone calls."
  },
  {
    question: "How do delivery partners track routes and verify jar swaps?",
    answer: "Delivery partners use mobile-first route sheets with customer address details, jar counts, and doorstep swap confirmations, ensuring zero missed deliveries and full jar inventory reconciliation."
  }
];
---

<BaseLayout
  title="Edrops — 20L Water Jar Delivery & Subscription Software"
  description="Edrops is the dedicated water jar delivery & subscription software. Automate prepaid wallets, recurring deliveries, route dispatch, and customer accounts."
  keywords="Edrops, water jar delivery app, 20L water jar subscription software, water delivery business software, bulk water delivery platform, mineral water delivery app, packaged drinking water distribution"
  faqItems={faqItems}
>

  <Navigation />

  <main id="main-content" class="overflow-hidden">

    {/* ═══════════════════════════════════════
        HERO — THE BRAND STATEMENT
        ═══════════════════════════════════════ */}
    <section class="hero-atmosphere relative min-h-screen flex items-center px-6 sm:px-10 lg:px-16 overflow-hidden">
      
      {/* Background Delivery Photo & Directional Fades */}
      <div class="hero-photo-container">
        <img
          src="/hero-delivery.jpg"
          alt="Edrops delivery partner handing a 20L water jar to a customer at their doorstep"
          class="hero-photo"
          loading="eager"
          fetchpriority="high"
          width="1920"
          height="1080"
          decoding="async"
        />
        {/* Desktop Horizontal Fade (Solid white on left fading to transparent by ~60%) */}
        <div class="hero-photo-fade-desktop hidden lg:block absolute inset-0"></div>
        {/* Mobile & Tablet Wash (High legibility white gradient overlay) */}
        <div class="hero-photo-fade-mobile block lg:hidden absolute inset-0"></div>
      </div>

      {/* Ambient subtle lighting */}
      <div class="hero-glow-1 opacity-60"></div>
      <div class="hero-glow-2 opacity-50"></div>

      <div class="relative z-10 w-full max-w-6xl mx-auto pt-28 pb-20 sm:pt-36 sm:pb-28">
        <div class="max-w-xl lg:max-w-2xl text-left space-y-8 sm:space-y-9">
          
          {/* Eyebrow */}
          
          
          {/* Headline — The Hero */}
          <div class="animate-fade-up-delay-1 space-y-4">
            <h1 class="text-[clamp(2.5rem,5.5vw,4.75rem)] font-extrabold leading-[1.06] tracking-[-0.035em] text-edrops-ocean">
              20L water jars,<br>
              <span class="text-[clamp(2.1rem,4.5vw,3.9rem)] text-gradient-water">delivered to your door.</span>
            </h1>
          </div>

          {/* Subline */}
          <p class="animate-fade-up-delay-2 text-base sm:text-lg lg:text-xl text-edrops-slate font-normal leading-relaxed max-w-xl">
            Edrops is the calm, intelligent platform where prepaid wallets, recurring deliveries, and customer trust come together — built specifically for 20L water jar businesses.
          </p>

          {/* CTA */}
          <div class="animate-fade-up-delay-3 flex items-center justify-start pt-2">
            <a
              href="https://app.edrops.in"
              class="inline-flex items-center justify-center rounded-full bg-edrops-secondary text-white text-[15px] font-bold px-9 py-4 btn-glow"
            >
              Start Free
            </a>
          </div>

          {/* Trust Indicators */}
          

        </div>
      </div>

      {/* Scroll indicator */}
      <div class="hidden lg:flex absolute bottom-8 left-1/2 -translate-x-1/2 z-10 animate-fade-up-delay-5">
        <div class="w-6 h-10 rounded-full border-2 border-edrops-muted/40 flex items-start justify-center pt-2 bg-white/40 backdrop-blur-xs">
          <div class="w-1 h-2.5 rounded-full bg-edrops-muted/50 animate-bounce"></div>
        </div>
      </div>
    </section>


    {/* ═══════════════════════════════════════
        METRICS — IMMEDIATE PROOF
        ═══════════════════════════════════════ */}
    <section class="py-20 px-6">
      <div class="mx-auto max-w-5xl">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          {metrics.map(([value, label]) => (
            <div class="text-center space-y-2 py-6">
              <p class="text-3xl sm:text-4xl font-extrabold tracking-tight text-edrops-ocean">{value}</p>
              <p class="text-sm font-medium text-edrops-slate">{label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>


    {/* ═══════════════════════════════════════
        HOW IT WORKS — EDITORIAL NUMBERED STEPS
        ═══════════════════════════════════════ */}
    <section class="py-24 sm:py-32 px-6 border-t border-edrops-border/40 scroll-mt-24 sm:scroll-mt-28" id="how-it-works">
      <div class="mx-auto max-w-6xl space-y-16 sm:space-y-20">
        
        {/* Editorial Header */}
        <div class="max-w-3xl">
          <div class="capabilities-eyebrow">
            <span class="text-xs font-bold uppercase tracking-[0.2em] text-edrops-primary">
              How it works
            </span>
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-[3.25rem] font-extrabold tracking-tight text-edrops-ocean leading-[1.08]">
            Subscribe, or just order once.<br>
            <span class="text-gradient-water">Either way, it arrives on time.</span>
          </h2>
        </div>

        {/* Numbered Steps: Responsive cards with soft tinted panels & flow progression */}
        <div class="relative">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 relative z-10">
            
            {/* Step 01 */}
            <div class="group relative rounded-[20px] bg-edrops-aqua/[0.045] border border-edrops-aqua/20 p-8 sm:p-9 lg:p-10 transition-all duration-300 hover:-translate-y-1 hover:shadow-md hover:shadow-edrops-primary/[0.05] hover:border-edrops-aqua/35 flex flex-col justify-between">
              <div class="relative z-10">
                <span class="text-5xl sm:text-6xl font-extrabold text-edrops-primary/[0.12] select-none tracking-tight block mb-5 leading-none">
                  01
                </span>
                <h3 class="text-xl sm:text-2xl font-bold text-edrops-ocean tracking-tight mb-3">
                  Choose how you buy
                </h3>
                <p class="text-base text-edrops-slate leading-relaxed font-normal">
                  Set up a recurring plan, or place a one-time order. No commitment required either way.
                </p>
              </div>

              {/* Desktop flow connector chevron to Step 02 */}
              <div class="hidden md:flex absolute -right-3.5 lg:-right-4.5 top-1/2 -translate-y-1/2 z-20 w-7 h-7 rounded-full bg-white border border-edrops-border/80 text-edrops-primary/60 items-center justify-center shadow-xs pointer-events-none">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </div>

            {/* Mobile vertical flow connector 1 -> 2 */}
            <div class="md:hidden flex flex-col items-center justify-center -my-2 z-10 text-edrops-primary/40">
              <div class="w-px h-5 bg-gradient-to-b from-edrops-aqua/30 to-edrops-primary/40"></div>
              <svg class="w-3.5 h-3.5 text-edrops-primary/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </div>

            {/* Step 02 */}
            <div class="group relative rounded-[20px] bg-edrops-aqua/[0.045] border border-edrops-aqua/20 p-8 sm:p-9 lg:p-10 transition-all duration-300 hover:-translate-y-1 hover:shadow-md hover:shadow-edrops-primary/[0.05] hover:border-edrops-aqua/35 flex flex-col justify-between">
              <div class="relative z-10">
                <span class="text-5xl sm:text-6xl font-extrabold text-edrops-primary/[0.12] select-none tracking-tight block mb-5 leading-none">
                  02
                </span>
                <h3 class="text-xl sm:text-2xl font-bold text-edrops-ocean tracking-tight mb-3">
                  We deliver on schedule
                </h3>
                <p class="text-base text-edrops-slate leading-relaxed font-normal">
                  Subscribers get automatic recurring drops. One-time orders arrive on your chosen date. Both tracked live.
                </p>
              </div>

              {/* Desktop flow connector chevron to Step 03 */}
              <div class="hidden md:flex absolute -right-3.5 lg:-right-4.5 top-1/2 -translate-y-1/2 z-20 w-7 h-7 rounded-full bg-white border border-edrops-border/80 text-edrops-primary/60 items-center justify-center shadow-xs pointer-events-none">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </div>

            {/* Mobile vertical flow connector 2 -> 3 */}
            <div class="md:hidden flex flex-col items-center justify-center -my-2 z-10 text-edrops-primary/40">
              <div class="w-px h-5 bg-gradient-to-b from-edrops-aqua/30 to-edrops-primary/40"></div>
              <svg class="w-3.5 h-3.5 text-edrops-primary/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </div>

            {/* Step 03 */}
            <div class="group relative rounded-[20px] bg-edrops-aqua/[0.045] border border-edrops-aqua/20 p-8 sm:p-9 lg:p-10 transition-all duration-300 hover:-translate-y-1 hover:shadow-md hover:shadow-edrops-primary/[0.05] hover:border-edrops-aqua/35 flex flex-col justify-between">
              <div class="relative z-10">
                <span class="text-5xl sm:text-6xl font-extrabold text-edrops-primary/[0.12] select-none tracking-tight block mb-5 leading-none">
                  03
                </span>
                <h3 class="text-xl sm:text-2xl font-bold text-edrops-ocean tracking-tight mb-3">
                  Stay in control
                </h3>
                <p class="text-base text-edrops-slate leading-relaxed font-normal">
                  Pause, skip, or switch between subscription and one-time anytime from your dashboard.
                </p>
              </div>
            </div>

          </div>
        </div>

      </div>
    </section>


    {/* ═══════════════════════════════════════
        CAPABILITIES — WHY EDROPS / PURPOSE BUILT
        ═══════════════════════════════════════ */}
    <section class="capabilities-section py-28 sm:py-36 px-6 scroll-mt-24 sm:scroll-mt-28" id="purpose-built">
      
      {/* Ambient background elements */}
      <div class="capabilities-caustic"></div>
      <div class="capabilities-shape capabilities-shape--1"></div>
      <div class="capabilities-shape capabilities-shape--2"></div>
      <div class="capabilities-shape capabilities-shape--3"></div>

      <div class="mx-auto max-w-6xl space-y-20 sm:space-y-28">
        
        {/* Editorial Header */}
        <div class="capabilities-header">
          <div class="capabilities-eyebrow">
            <span class="text-xs font-bold uppercase tracking-[0.2em] text-edrops-primary">
              Purpose-built
            </span>
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-[3.25rem] font-extrabold tracking-tight text-edrops-ocean leading-[1.08]">
            Built for managing<br />
            <span class="text-gradient-water">water jar deliveries.</span>
          </h2>
        </div>

        {/* 3-Column Equal Feature Grid */}
        <div class="capabilities-grid">
          
          {/* Feature 1 */}
          <article class="capability-card" data-capability="0">
            <span class="capability-card__number" aria-hidden="true">01</span>
            <h3 class="capability-card__title">Subscription Intelligence</h3>
            <p class="capability-card__text">Recurring delivery schedules that adapt to customer rhythms. Pause, skip, reschedule — without losing a single subscription.</p>
          </article>

          {/* Feature 2 */}
          <article class="capability-card capability-card--delay-1" data-capability="1">
            <span class="capability-card__number" aria-hidden="true">02</span>
            <h3 class="capability-card__title">Prepaid Wallet Engine</h3>
            <p class="capability-card__text">Customers recharge their jar balance upfront. Every delivery consumes balance automatically. Zero chasing. Zero invoices.</p>
          </article>

          {/* Feature 3 */}
          <article class="capability-card capability-card--delay-2" data-capability="2">
            <span class="capability-card__number" aria-hidden="true">03</span>
            <h3 class="capability-card__title">Operational Clarity</h3>
            <p class="capability-card__text">Routes optimized. Drivers dispatched. Exceptions flagged. Low-balance customers notified — before they run out.</p>
          </article>

        </div>
      </div>
    </section>

    <script>
      // ─── Capabilities: Scroll Reveal ───
      {
        const section = document.getElementById('purpose-built') || document.getElementById('capabilities-section');
        if (section) {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                section.classList.add('capabilities--visible');
                const cards = section.querySelectorAll('.capability-card');
                cards.forEach((card) => {
                  card.classList.add('capability-card--visible');
                });
                observer.unobserve(entry.target);
              }
            });
          }, {
            threshold: 0.15,
            rootMargin: '0px 0px -60px 0px'
          });

          observer.observe(section);
        }
      }
    </script>


    {/* ═══════════════════════════════════════
        WHY IT WORKS — CUSTOMER TRUST & VISIBILITY
        ═══════════════════════════════════════ */}
    <section class="relative overflow-hidden py-24 sm:py-32 px-6 border-t border-edrops-border/40 bg-gradient-to-b from-[#eef7fc] via-[#f3f9fd] to-[#edf6fc] scroll-mt-24 sm:scroll-mt-28" id="why-it-works">
      
      {/* Abstract organic flowing wave shapes (subtle tone-on-tone brand texture) */}
      <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
        {/* Top-right flowing wave glow */}
        <div class="absolute -top-24 -right-24 w-[480px] h-[480px] rounded-full bg-gradient-to-bl from-edrops-aqua/12 via-edrops-primary/8 to-transparent blur-3xl"></div>
        {/* Bottom-left soft wave glow */}
        <div class="absolute -bottom-28 -left-20 w-[520px] h-[520px] rounded-full bg-gradient-to-tr from-edrops-primary/10 via-edrops-aqua/8 to-transparent blur-3xl"></div>
        {/* Wavy curve vector overlay */}
        <svg class="absolute top-0 right-0 w-full h-full opacity-[0.06] text-edrops-primary" viewBox="0 0 1440 600" fill="none" preserveAspectRatio="none">
          <path d="M0,160 C320,300 480,40 800,180 C1120,320 1280,100 1440,200 L1440,600 L0,600 Z" fill="currentColor" />
          <path d="M0,280 C360,120 600,340 960,190 C1200,80 1360,260 1440,220" stroke="currentColor" stroke-width="2" fill="none" />
        </svg>
      </div>

      <div class="relative z-10 mx-auto max-w-6xl space-y-16 sm:space-y-20">
        
        {/* Editorial Header */}
        <div class="max-w-3xl space-y-4">
          <div class="capabilities-eyebrow">
            <span class="text-xs font-bold uppercase tracking-[0.2em] text-edrops-primary">
              Why it works
            </span>
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-[3.25rem] font-extrabold tracking-tight text-edrops-ocean leading-[1.08]">
            Water delivery your customers actually trust.
          </h2>
          <p class="text-lg sm:text-xl text-edrops-slate font-normal leading-relaxed">
            Every order tracked. Every jar accounted for. Every customer kept in the loop.
          </p>
        </div>

        {/* 3 Trust Cards */}
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
          
          {/* Card 1 */}
          <div class="rounded-[20px] bg-white/95 border border-white/80 shadow-[0_4px_24px_-4px_rgba(24,60,72,0.06)] p-8 sm:p-9 lg:p-10 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_12px_32px_-4px_rgba(24,60,72,0.12)] hover:border-edrops-primary/20 flex flex-col justify-between">
            <div>
              {/* Icon Badge */}
              <div class="w-12 h-12 rounded-xl bg-edrops-aqua/10 text-edrops-primary flex items-center justify-center mb-6">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>

              <h3 class="text-xl sm:text-2xl font-bold text-edrops-ocean tracking-tight mb-3">
                Verified deliveries, every time
              </h3>
              <p class="text-base text-edrops-slate leading-relaxed font-normal mb-6">
                Every jar is logged the moment it leaves the depot and confirmed the moment it arrives. Nothing gets missed.
              </p>
            </div>

            {/* Checklist */}
            <div class="pt-6 border-t border-edrops-border/60">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-xs font-semibold text-edrops-ocean">
                <div class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-edrops-aqua shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>Delivery time</span>
                </div>
                <div class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-edrops-aqua shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>Jar count</span>
                </div>
                <div class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-edrops-aqua shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>Payment status</span>
                </div>
                <div class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-edrops-aqua shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>Driver details</span>
                </div>
              </div>
            </div>
          </div>

          {/* Card 2 */}
          <div class="rounded-[20px] bg-white/95 border border-white/80 shadow-[0_4px_24px_-4px_rgba(24,60,72,0.06)] p-8 sm:p-9 lg:p-10 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_12px_32px_-4px_rgba(24,60,72,0.12)] hover:border-edrops-secondary/30 flex flex-col justify-start">
            {/* Icon Badge */}
            <div class="w-12 h-12 rounded-xl bg-edrops-secondary/10 text-edrops-secondary flex items-center justify-center mb-6">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>

            <h3 class="text-xl sm:text-2xl font-bold text-edrops-ocean tracking-tight mb-3">
              Reorder in one tap
            </h3>
            <p class="text-base text-edrops-slate leading-relaxed font-normal">
              No phone calls, no waiting on hold. Customers top up their wallet or place an order straight from the app, any time.
            </p>
          </div>

          {/* Card 3 */}
          <div class="rounded-[20px] bg-white/95 border border-white/80 shadow-[0_4px_24px_-4px_rgba(24,60,72,0.06)] p-8 sm:p-9 lg:p-10 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_12px_32px_-4px_rgba(24,60,72,0.12)] hover:border-edrops-primary/20 flex flex-col justify-start">
            {/* Icon Badge */}
            <div class="w-12 h-12 rounded-xl bg-edrops-aqua/10 text-edrops-primary flex items-center justify-center mb-6">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
              </svg>
            </div>

            <h3 class="text-xl sm:text-2xl font-bold text-edrops-ocean tracking-tight mb-3">
              Doorstep swap, zero hassle
            </h3>
            <p class="text-base text-edrops-slate leading-relaxed font-normal">
              Your delivery partner brings the full jar in and takes the empty one out. Customers never have to lift a thing.
            </p>
          </div>

        </div>

      </div>
    </section>

    {/* ═══════════════════════════════════════
        FOR BUSINESSES — BULK WORKPLACE WATER
        ═══════════════════════════════════════ */}
    <section class="py-24 sm:py-32 lg:py-36 px-6 border-t border-edrops-border/50 bg-[#f9fcfe] scroll-mt-24 sm:scroll-mt-28" id="for-business">
      <div class="mx-auto max-w-6xl space-y-16 sm:space-y-20 text-center">
        
        {/* Centered Header & Subheading */}
        <div class="max-w-3xl mx-auto space-y-4">
          <div class="capabilities-eyebrow justify-center">
            <span class="text-xs font-bold uppercase tracking-[0.2em] text-edrops-primary">
              For Businesses
            </span>
          </div>
          
          <h2 class="text-3xl sm:text-4xl lg:text-[3rem] font-extrabold tracking-tight text-edrops-ocean leading-[1.12]">
            Your office shouldn't run dry. We make sure it doesn't.
          </h2>
          
          <p class="text-base sm:text-lg text-edrops-slate font-normal leading-relaxed max-w-2xl mx-auto">
            Bulk water jar delivery for offices, cafes, clinics, and stores — better rates the more you order, and one dashboard to manage it all.
          </p>
        </div>

        {/* 4-Item Content Grid (1 row of 4 desktop, 2x2 tablet, 1 col mobile) - plain text */}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10 text-center pt-2">
          
          {/* Item 1 */}
          <div class="space-y-2.5 flex flex-col items-center">

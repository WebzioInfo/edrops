---
import BaseLayout from '../layouts/BaseLayout.astro';

const capabilities = [
  ['Subscription Intelligence', 'Recurring delivery schedules that adapt to customer rhythms. Pause, skip, reschedule — without losing a single subscription.'],
  ['Prepaid Wallet Engine', 'Customers recharge their jar balance upfront. Every delivery consumes balance automatically. Zero chasing. Zero invoices.'],
  ['Operational Clarity', 'Routes optimized. Drivers dispatched. Exceptions flagged. Low-balance customers notified — before they run out.'],
];

const metrics = [
  ['99.4%', 'On-time delivery rate'],
  ['3×', 'Faster route planning'],
  ['100%', 'Prepaid cashflow'],
  ['0', 'Outstanding invoices'],
];

const steps = [
  ['01', 'Recharge', 'Customers purchase jar passes upfront via UPI, card, or wallet top-up.'],
  ['02', 'Deliver', 'Drivers receive optimized routes. Each delivery auto-deducts from balance.'],
  ['03', 'Predict', 'Edrops forecasts recharge timing and notifies customers before supply runs low.'],
];
---

<BaseLayout
  title="Edrops — The Operating System for Modern Water Businesses"
  description="Edrops is the premium platform for 20L water subscription businesses. Prepaid wallets, automated deliveries, route intelligence, and customer trust — beautifully unified."
>

  {/* ═══════════════════════════════════════
      NAVIGATION
      ═══════════════════════════════════════ */}
  <header class="fixed inset-x-0 top-0 z-50 bg-white/70 backdrop-blur-2xl border-b border-edrops-border/40">
    <div class="mx-auto flex h-[72px] max-w-6xl items-center justify-between px-6">
      <a href="/" class="flex items-center gap-2.5 group">
        <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-edrops-primary to-edrops-aqua text-white shadow-sm group-hover:shadow-md transition-shadow">
          <span class="text-sm font-extrabold">E</span>
        </div>
        <span class="text-lg font-extrabold tracking-tight text-edrops-ocean">Edrops</span>
      </a>

      <nav class="hidden items-center gap-8 text-[13px] font-semibold text-edrops-slate md:flex">
        <a href="/features" class="hover:text-edrops-ocean transition-colors duration-200">Features</a>
        <a href="/pricing" class="hover:text-edrops-ocean transition-colors duration-200">Pricing</a>
        <a href="/how-it-works" class="hover:text-edrops-ocean transition-colors duration-200">How it works</a>
        <a href="/about" class="hover:text-edrops-ocean transition-colors duration-200">About</a>
      </nav>

      <div class="flex items-center gap-3">
        <a 
          href="http://localhost:5173/login" 
          class="hidden sm:inline-flex text-[13px] font-semibold text-edrops-slate hover:text-edrops-ocean transition-colors px-3 py-2"
        >
          Sign in
        </a>
        <a 
          href="http://localhost:5173/login" 
          class="inline-flex items-center rounded-full bg-edrops-ocean text-white text-[13px] font-bold px-5 py-2 hover:bg-edrops-navy transition-colors"
        >
          Open App
        </a>
      </div>
    </div>
  </header>

  <main class="overflow-hidden">

    {/* ═══════════════════════════════════════
        HERO — THE BRAND STATEMENT
        ═══════════════════════════════════════ */}
    <section class="hero-atmosphere relative min-h-screen flex flex-col items-center justify-center text-center px-6">
      
      {/* Ambient volumetric light glows */}
      <div class="hero-glow-1"></div>
      <div class="hero-glow-2"></div>
      <div class="hero-glow-3"></div>

      <div class="relative z-10 mx-auto max-w-4xl pt-24 pb-20 sm:pb-28 space-y-10">
        
        {/* Eyebrow */}
        <div class="animate-fade-up">
          <span class="inline-flex items-center gap-2.5 rounded-full border border-edrops-border/60 bg-white/60 backdrop-blur-md px-4 py-2 text-xs font-semibold text-edrops-primary tracking-wide">
            <span class="w-1.5 h-1.5 rounded-full bg-edrops-aqua animate-pulse"></span>
            The water subscription engine
          </span>
        </div>
        
        {/* Headline — The Hero */}
        <div class="animate-fade-up-delay-1 space-y-6">
          <h1 class="text-[clamp(2.5rem,7vw,5.5rem)] font-extrabold leading-[1.04] tracking-[-0.035em] text-edrops-ocean">
            Water subscriptions,<br>
            <span class="text-gradient-water">beautifully managed.</span>
          </h1>
        </div>

        {/* Subline */}
        <p class="animate-fade-up-delay-2 text-lg sm:text-xl text-edrops-slate font-normal leading-relaxed max-w-2xl mx-auto">
          Edrops is the calm, intelligent platform where prepaid wallets, recurring deliveries, and customer trust come together — built specifically for 20L water jar businesses.
        </p>

        {/* CTAs */}
        <div class="animate-fade-up-delay-3 flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
          <a
            href="http://localhost:5173/login"
            class="inline-flex items-center justify-center rounded-full bg-edrops-secondary text-white text-[15px] font-bold px-9 py-4 btn-glow"
          >
            Start Free
          </a>
          <a
            href="/features"
            class="inline-flex items-center justify-center rounded-full bg-white border border-edrops-border text-edrops-ocean text-[15px] font-bold px-9 py-4 btn-glass"
          >
            Explore Platform
          </a>
        </div>

        {/* Trust Indicators */}
        <div class="animate-fade-up-delay-4 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs font-medium text-edrops-muted pt-4">
          <span class="flex items-center gap-1.5"><span class="text-edrops-aqua">✓</span> Subscription Ready</span>
          <span class="flex items-center gap-1.5"><span class="text-edrops-aqua">✓</span> Prepaid Wallets</span>
          <span class="flex items-center gap-1.5"><span class="text-edrops-aqua">✓</span> Real-time Dispatch</span>
          <span class="flex items-center gap-1.5"><span class="text-edrops-aqua">✓</span> Customer Portal</span>
        </div>

      </div>

      {/* Scroll indicator */}
      <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 animate-fade-up-delay-5">
        <div class="w-6 h-10 rounded-full border-2 border-edrops-muted/40 flex items-start justify-center pt-2">
          <div class="w-1 h-2.5 rounded-full bg-edrops-muted/50 animate-bounce"></div>
        </div>
      </div>
    </section>


    {/* ═══════════════════════════════════════
        METRICS — IMMEDIATE PROOF
        ═══════════════════════════════════════ */}
    <section class="py-20 px-6">
      <div class="mx-auto max-w-5xl">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          {metrics.map(([value, label]) => (
            <div class="text-center space-y-2 py-6">
              <p class="text-3xl sm:text-4xl font-extrabold tracking-tight text-edrops-ocean">{value}</p>
              <p class="text-sm font-medium text-edrops-slate">{label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>


    {/* ═══════════════════════════════════════
        CAPABILITIES — WHY EDROPS
        ═══════════════════════════════════════ */}
    <section class="py-24 px-6">
      <div class="mx-auto max-w-5xl space-y-20">
        
        <div class="max-w-2xl space-y-4">
          <span class="text-xs font-bold uppercase tracking-[0.2em] text-edrops-primary">
            Purpose-built
          </span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-edrops-ocean leading-[1.1]">
            Not ERP. Not a delivery clone.<br>
            <span class="text-gradient-water">Water subscription intelligence.</span>
          </h2>
        </div>

        <div class="grid gap-6 lg:grid-cols-3">
          {capabilities.map(([title, text]) => (
            <article class="glass-card glass-card-hover rounded-2xl p-8 space-y-4">
              <h3 class="text-lg font-bold text-edrops-ocean">{title}</h3>
              <p class="text-sm text-edrops-slate leading-relaxed">{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>


    {/* ═══════════════════════════════════════
        HOW IT WORKS
        ═══════════════════════════════════════ */}
    <section class="py-24 px-6">
      <div class="mx-auto max-w-5xl">
        <div class="rounded-3xl bg-edrops-ocean p-10 sm:p-16 text-white relative overflow-hidden">
          <div class="absolute inset-0 opacity-20 pointer-events-none" style="background-image: url('/hero-caustics.png'); background-size: cover; background-position: center; mix-blend-mode: overlay;"></div>
          
          <div class="relative z-10 space-y-14">
            <div class="max-w-xl space-y-4">
              <span class="text-xs font-bold uppercase tracking-[0.2em] text-edrops-aqua">
                How it works
              </span>
              <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight leading-[1.1]">
                Three steps to recurring water revenue.
              </h2>
            </div>

            <div class="grid gap-8 md:grid-cols-3">
              {steps.map(([num, title, text]) => (
                <div class="space-y-4">
                  <span class="text-sm font-extrabold text-edrops-aqua">{num}</span>
                  <h3 class="text-xl font-bold">{title}</h3>
                  <p class="text-sm text-white/65 leading-relaxed">{text}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>

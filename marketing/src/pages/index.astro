---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import '../styles/capabilities.css';
import '../styles/journey.css';

const metrics = [
  ['99.4%', 'On-time delivery rate'],
  ['3×', 'Faster route planning'],
  ['100%', 'Prepaid cashflow'],
  ['0', 'Outstanding invoices'],
];
---

<BaseLayout
  title="Edrops — The Operating System for Modern Water Businesses"
  description="Edrops is the premium platform for 20L water subscription businesses. Prepaid wallets, automated deliveries, route intelligence, and customer trust — beautifully unified."
>

  <Navigation />

  <main id="main-content" class="overflow-hidden">

    {/* ═══════════════════════════════════════
        HERO — THE BRAND STATEMENT
        ═══════════════════════════════════════ */}
    <section class="hero-atmosphere relative min-h-screen flex flex-col items-center justify-center text-center px-6">
      
      {/* Ambient volumetric light glows */}
      <div class="hero-glow-1"></div>
      <div class="hero-glow-2"></div>
      <div class="hero-glow-3"></div>

      <div class="relative z-10 mx-auto max-w-4xl pt-24 pb-20 sm:pb-28 space-y-10">
        
        {/* Eyebrow */}
        <div class="animate-fade-up">
          <span class="inline-flex items-center gap-2.5 rounded-full border border-edrops-border/60 bg-white/60 backdrop-blur-md px-4 py-2 text-xs font-semibold text-edrops-primary tracking-wide">
            <span class="w-1.5 h-1.5 rounded-full bg-edrops-aqua animate-pulse"></span>
            The water subscription engine
          </span>
        </div>
        
        {/* Headline — The Hero */}
        <div class="animate-fade-up-delay-1 space-y-6">
          <h1 class="text-[clamp(2.5rem,7vw,5.5rem)] font-extrabold leading-[1.04] tracking-[-0.035em] text-edrops-ocean">
            Water subscriptions,<br>
            <span class="text-gradient-water">beautifully managed.</span>
          </h1>
        </div>

        {/* Subline */}
        <p class="animate-fade-up-delay-2 text-lg sm:text-xl text-edrops-slate font-normal leading-relaxed max-w-2xl mx-auto">
          Edrops is the calm, intelligent platform where prepaid wallets, recurring deliveries, and customer trust come together — built specifically for 20L water jar businesses.
        </p>

        {/* CTAs */}
        <div class="animate-fade-up-delay-3 flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
          <a
            href="http://localhost:5173/login"
            class="inline-flex items-center justify-center rounded-full bg-edrops-secondary text-white text-[15px] font-bold px-9 py-4 btn-glow"
          >
            Start Free
          </a>
          <a
            href="/features"
            class="inline-flex items-center justify-center rounded-full bg-white border border-edrops-border text-edrops-ocean text-[15px] font-bold px-9 py-4 btn-glass"
          >
            Explore Platform
          </a>
        </div>

        {/* Trust Indicators */}
        <div class="animate-fade-up-delay-4 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs font-medium text-edrops-muted pt-4">
          <span class="flex items-center gap-1.5"><span class="text-edrops-aqua">✓</span> Subscription Ready</span>
          <span class="flex items-center gap-1.5"><span class="text-edrops-aqua">✓</span> Prepaid Wallets</span>
          <span class="flex items-center gap-1.5"><span class="text-edrops-aqua">✓</span> Real-time Dispatch</span>
          <span class="flex items-center gap-1.5"><span class="text-edrops-aqua">✓</span> Customer Portal</span>
        </div>

      </div>

      {/* Scroll indicator */}
      <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 animate-fade-up-delay-5">
        <div class="w-6 h-10 rounded-full border-2 border-edrops-muted/40 flex items-start justify-center pt-2">
          <div class="w-1 h-2.5 rounded-full bg-edrops-muted/50 animate-bounce"></div>
        </div>
      </div>
    </section>


    {/* ═══════════════════════════════════════
        METRICS — IMMEDIATE PROOF
        ═══════════════════════════════════════ */}
    <section class="py-20 px-6">
      <div class="mx-auto max-w-5xl">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          {metrics.map(([value, label]) => (
            <div class="text-center space-y-2 py-6">
              <p class="text-3xl sm:text-4xl font-extrabold tracking-tight text-edrops-ocean">{value}</p>
              <p class="text-sm font-medium text-edrops-slate">{label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>


    {/* ═══════════════════════════════════════
        CAPABILITIES — WHY EDROPS
        ═══════════════════════════════════════ */}
    <section class="capabilities-section py-28 sm:py-36 px-6" id="capabilities-section">
      
      {/* Ambient background elements */}
      <div class="capabilities-caustic"></div>
      <div class="capabilities-shape capabilities-shape--1"></div>
      <div class="capabilities-shape capabilities-shape--2"></div>
      <div class="capabilities-shape capabilities-shape--3"></div>

      <div class="mx-auto max-w-6xl space-y-20 sm:space-y-28">
        
        {/* Editorial Header */}
        <div class="capabilities-header">
          <div class="capabilities-eyebrow">
            <span class="text-xs font-bold uppercase tracking-[0.2em] text-edrops-primary">
              Purpose-built
            </span>
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-[3.25rem] font-extrabold tracking-tight text-edrops-ocean leading-[1.08]">
            Not ERP. Not a delivery clone.<br>
            <span class="text-gradient-water">Water subscription intelligence.</span>
          </h2>
        </div>

        {/* Asymmetric Feature Grid */}
        <div class="capabilities-grid">
          
          {/* Feature 1 — Hero Card (largest, introduces the idea) */}
          <article class="capability-card capability-card--hero" data-capability="0">
            <div class="capability-card__light"></div>
            <span class="capability-card__number" aria-hidden="true">01</span>
            <h3 class="capability-card__title">Subscription Intelligence</h3>
            <p class="capability-card__text">Recurring delivery schedules that adapt to customer rhythms. Pause, skip, reschedule — without losing a single subscription.</p>
          </article>

          {/* Feature 2 — Secondary Card (expands the idea) */}
          <article class="capability-card capability-card--secondary capability-card--delay-1" data-capability="1">
            <div class="capability-card__light"></div>
            <span class="capability-card__number" aria-hidden="true">02</span>
            <h3 class="capability-card__title">Prepaid Wallet Engine</h3>
            <p class="capability-card__text">Customers recharge their jar balance upfront. Every delivery consumes balance automatically. Zero chasing. Zero invoices.</p>
          </article>

          {/* Feature 3 — Tertiary Card (completes the story) */}
          <article class="capability-card capability-card--tertiary capability-card--delay-2" data-capability="2">
            <div class="capability-card__light"></div>
            <span class="capability-card__number" aria-hidden="true">03</span>
            <h3 class="capability-card__title">Operational Clarity</h3>
            <p class="capability-card__text">Routes optimized. Drivers dispatched. Exceptions flagged. Low-balance customers notified — before they run out.</p>
          </article>

        </div>
      </div>
    </section>

    <script>
      // ─── Capabilities: Scroll Reveal + Cursor Light ───
      {
        const section = document.getElementById('capabilities-section');
        if (section) {
          // Intersection Observer for scroll-triggered reveals
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                section.classList.add('capabilities--visible');
                // Reveal each card with stagger
                const cards = section.querySelectorAll('.capability-card');
                cards.forEach((card) => {
                  card.classList.add('capability-card--visible');
                });
                observer.unobserve(entry.target);
              }
            });
          }, {
            threshold: 0.15,
            rootMargin: '0px 0px -60px 0px'
          });

          observer.observe(section);

          // Cursor-tracking light effect on cards
          const cards = section.querySelectorAll('.capability-card');
          cards.forEach((card) => {
            card.addEventListener('mousemove', (e) => {
              const rect = card.getBoundingClientRect();
              const x = ((e.clientX - rect.left) / rect.width) * 100;
              const y = ((e.clientY - rect.top) / rect.height) * 100;
              const light = card.querySelector('.capability-card__light');
              if (light) {
                light.style.setProperty('--mouse-x', x + '%');
                light.style.setProperty('--mouse-y', y + '%');
              }
            });
          });
        }
      }
    </script>



    {/* ═══════════════════════════════════════
        HOW IT WORKS — TIMELINE STORYTELLING
        ═══════════════════════════════════════ */}
    {/* ═══════════════════════════════════════
        HOW IT WORKS — EDITORIAL STORY EXPERIENCE
        Bright, Airy, Luxury Storytelling
        ═══════════════════════════════════════ */}
    {/* ═══════════════════════════════════════
        HOW IT WORKS — THE LIQUID MONOLITH EXPERIENCE
        A Signature Kinetic Fluid Product Launch
        ═══════════════════════════════════════ */}
    {/* ═══════════════════════════════════════
        HOW IT WORKS — THE UNBOXED HYDRO-CINEMATIC GALLERY
        Museum Installation Experience. Zero Cards. Zero Containers. Zero Boxes.
        ═══════════════════════════════════════ */}
    <section class="hydro-canvas" id="hydro-canvas">
      
      {/* Hydro-optic atmosphere & light pools */}
      <div class="hydro-caustic-layer"></div>
      <div class="hydro-light-pool hydro-light-pool--1"></div>
      <div class="hydro-light-pool hydro-light-pool--2"></div>
      <div class="hydro-light-pool hydro-light-pool--3"></div>

      {/* Main Gallery Title Header */}
      <div class="hydro-header">
        <div class="hydro-status-pill">
          <span class="hydro-status-dot"></span>
          How it works
        </div>
        <h2 class="hydro-main-title">
          Three steps to recurring water revenue.
        </h2>
      </div>

      <div class="mx-auto max-w-6xl space-y-32 sm:space-y-44 lg:space-y-56">
        
        {/* SCENE I: RECHARGE */}
        <div class="hydro-scene" data-scene="1">
          <div class="hydro-scene-composition">
            {/* Unboxed Floating Artwork (Left) */}
            <div class="hydro-art-space">
              <div class="art-recharge">
                <div class="art-recharge__ring-1"></div>
                <div class="art-recharge__ring-2"></div>
                <div class="art-recharge__drop-orb">
                  <div class="art-recharge__drop"></div>
                </div>
              </div>
            </div>

            {/* Unboxed Editorial Typography (Right) */}
            <div class="hydro-typography">
              <div class="hydro-ghost-num">01</div>
              <h3 class="hydro-scene-title">Recharge</h3>
              <p class="hydro-scene-text">Customers purchase jar passes upfront via UPI, card, or wallet top-up.</p>
            </div>
          </div>
        </div>

        {/* SCENE II: DELIVER */}
        <div class="hydro-scene hydro-scene--reverse" data-scene="2">
          <div class="hydro-scene-composition">
            {/* Unboxed Floating Artwork (Right on Desktop) */}
            <div class="hydro-art-space">
              <div class="art-deliver">
                <svg class="art-deliver__svg" viewBox="0 0 340 220">
                  <defs>
                    <linearGradient id="hydro-stream-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                      <stop offset="0%" stop-color="#2D79A8" />
                      <stop offset="100%" stop-color="#33BFD0" />
                    </linearGradient>
                  </defs>
                  <path class="art-deliver__path-bg" d="M 30,60 Q 170,210 310,60" />
                  <path class="art-deliver__path-glow" d="M 30,60 Q 170,210 310,60" />
                </svg>
                <div class="art-deliver__particle"></div>
              </div>
            </div>

            {/* Unboxed Editorial Typography (Left on Desktop) */}
            <div class="hydro-typography">
              <div class="hydro-ghost-num">02</div>
              <h3 class="hydro-scene-title">Deliver</h3>
              <p class="hydro-scene-text">Drivers receive optimized routes. Each delivery auto-deducts from balance.</p>
            </div>
          </div>
        </div>

        {/* SCENE III: PREDICT */}
        <div class="hydro-scene" data-scene="3">
          <div class="hydro-scene-composition">
            {/* Unboxed Floating Artwork (Left) */}
            <div class="hydro-art-space">
              <div class="art-predict">
                <div class="art-predict__wave art-predict__wave--1"></div>
                <div class="art-predict__wave art-predict__wave--2"></div>
                <div class="art-predict__wave art-predict__wave--3"></div>
                <div class="art-predict__infinity-core">
                  <span>&infin;</span>
                </div>
              </div>
            </div>

            {/* Unboxed Editorial Typography (Right) */}
            <div class="hydro-typography">
              <div class="hydro-ghost-num">03</div>
              <h3 class="hydro-scene-title">Predict</h3>
              <p class="hydro-scene-text">Edrops forecasts recharge timing and notifies customers before supply runs low.</p>
            </div>
          </div>
        </div>

      </div>
    </section>

    <script>
      // ─── Hydro-Cinematic Gallery Controller ───
      {
        const canvas = document.getElementById('hydro-canvas');
        if (canvas) {
          // 1. Entrance Observer
          const canvasObserver = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                canvas.classList.add('hydro-canvas--visible');
                canvasObserver.unobserve(entry.target);
              }
            });
          }, { threshold: 0.08 });
          
          canvasObserver.observe(canvas);

          // 2. Scene Reveal Observer
          const scenes = canvas.querySelectorAll('.hydro-scene');
          const sceneObserver = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('hydro-scene--active');
                sceneObserver.unobserve(entry.target);
              }
            });
          }, {
            threshold: 0.25,
            rootMargin: '0px 0px -50px 0px'
          });

          scenes.forEach(scene => sceneObserver.observe(scene));
        }
      }
    </script>


  </main>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import '../styles/capabilities.css';

const faqItems = [
  {
    question: "What is eDrops?",
    answer: "eDrops is a 20L water jar delivery app. Customers order jars online, subscribe to recurring deliveries, top up a prepaid wallet, and get doorstep jar swaps — all from one app. No phone calls needed."
  },
  {
    question: "How do I order a 20L water jar?",
    answer: "Open eDrops at app.edrops.in, choose a one-time order or set up a recurring subscription, select how many jars you need, and pay via UPI, card, or your prepaid wallet. Your jars are delivered to your doorstep on the scheduled date."
  },
  {
    question: "How does the jar swap work?",
    answer: "Our delivery partner brings full 20L jars to your door and takes the empty ones back. You don't need to carry or return anything yourself — the swap happens right at your doorstep during every delivery."
  },
  {
    question: "How does the prepaid wallet work?",
    answer: "You top up your eDrops wallet in advance using UPI, credit/debit card, or net banking. Each time a delivery is completed, the jar cost deducts automatically from your balance. You get an instant digital receipt with every delivery."
  },
  {
    question: "Can I pause, skip, or change my subscription?",
    answer: "Yes. You can pause your subscription during vacations, skip an upcoming delivery, change the number of jars, or reschedule a delivery date — all from your eDrops dashboard, any time, without calling anyone."
  },
  {
    question: "Which areas do you deliver to?",
    answer: "eDrops currently delivers in Kondotty and Malappuram, Kerala. We are expanding to more areas. Check the app for the latest delivery availability in your pincode."
  },
  {
    question: "What payment methods are accepted?",
    answer: "eDrops accepts UPI, credit cards, debit cards, and net banking. You can also pay from your prepaid eDrops wallet balance."
  },
  {
    question: "How do I track my order?",
    answer: "After placing an order, you can track its status live from your eDrops dashboard. You'll see when your jars are out for delivery and when they've been delivered."
  },
  {
    question: "Can offices and businesses order in bulk?",
    answer: "Yes. eDrops offers bulk water jar delivery for offices, cafes, clinics, and other workplaces. Businesses get volume-based pricing, flexible scheduling, and a single dashboard to manage all orders."
  }
];

const howToData = {
  title: 'How to Order 20L Water Jars with eDrops',
  description: 'Order 20L water jars online in a few simple steps: choose your plan, top up your wallet, and get doorstep delivery with jar swap.',
  steps: [
    {
      name: 'Choose your plan',
      text: 'Open eDrops and select a recurring subscription or place a one-time order. Pick how many 20L jars you need.',
      url: '/#how-to-order'
    },
    {
      name: 'Top up your wallet',
      text: 'Add money to your prepaid eDrops wallet using UPI, card, or net banking. Your balance is used automatically for each delivery.',
      url: '/#how-to-order'
    },
    {
      name: 'Get doorstep delivery',
      text: 'Our delivery partner brings full jars to your door and swaps out the empties. Track the delivery live from your dashboard.',
      url: '/#how-to-order'
    },
    {
      name: 'Manage anytime',
      text: 'Pause, skip, reschedule, or adjust jar quantities from your dashboard whenever you need to. No phone calls required.',
      url: '/#how-to-order'
    }
  ]
};
---

<BaseLayout
  title="20L Water Jar Delivery App – eDrops"
  description="Order 20L water jars online with eDrops. Subscribe or order once, top up a prepaid wallet, and get doorstep jar swaps on time. Start ordering today."
  keywords="20L water jar delivery, water jar delivery app, order water jar online, water can subscription, eDrops, doorstep water delivery, water jar Kondotty, water jar Malappuram"
  faqItems={faqItems}
  howToData={howToData}
  isHome={true}
>

  <Navigation />

  <main id="main-content" class="overflow-hidden">

    {/* ═══════════════════════════════════════
        HERO — THE BRAND STATEMENT
        ═══════════════════════════════════════ */}
    <section class="hero-atmosphere relative min-h-screen flex items-center px-6 sm:px-10 lg:px-16 overflow-hidden">
      
      {/* Background Delivery Photo & Directional Fades */}
      <div class="hero-photo-container">
        <img
          src="/hero-delivery.jpg"
          alt="eDrops delivery partner handing a 20L water jar to a customer at their doorstep"
          class="hero-photo"
          loading="eager"
          fetchpriority="high"
          width="1920"
          height="1080"
          decoding="async"
        />
        {/* Desktop Horizontal Fade (Solid white on left fading to transparent by ~60%) */}
        <div class="hero-photo-fade-desktop hidden lg:block absolute inset-0" aria-hidden="true"></div>
        {/* Mobile & Tablet Wash (High legibility white gradient overlay) */}
        <div class="hero-photo-fade-mobile block lg:hidden absolute inset-0" aria-hidden="true"></div>
      </div>

      {/* Ambient subtle lighting */}
      <div class="hero-glow-1 opacity-60" aria-hidden="true"></div>
      <div class="hero-glow-2 opacity-50" aria-hidden="true"></div>

      <div class="relative z-10 w-full max-w-6xl mx-auto pt-28 pb-20 sm:pt-36 sm:pb-28">
        <div class="max-w-xl lg:max-w-2xl text-left space-y-8 sm:space-y-9">
          
          {/* Headline — The Hero */}
          <div class="animate-fade-up-delay-1 space-y-4">
            <h1 class="text-[clamp(2.5rem,5.5vw,4.75rem)] font-extrabold leading-[1.06] tracking-[-0.035em] text-edrops-ocean">
              20L water jar delivery,<br>
              <span class="text-[clamp(2.1rem,4.5vw,3.9rem)] text-gradient-water">ordered in seconds.</span>
            </h1>
          </div>

          {/* Answer-first definition for AEO / GEO */}
          <p class="animate-fade-up-delay-2 text-base sm:text-lg lg:text-xl text-edrops-slate font-normal leading-relaxed max-w-xl">
            eDrops (edrops.in) is a 20L water jar delivery app serving Kondotty and Malappuram, Kerala. Order jars online, subscribe to recurring deliveries, and pay from a prepaid wallet — with doorstep jar swap, every time.
          </p>

          {/* CTA */}
          <div class="animate-fade-up-delay-3 flex items-center justify-start pt-2">
            <a
              href="https://app.edrops.in"
              class="inline-flex items-center justify-center rounded-full bg-edrops-secondary text-white text-[15px] font-bold px-9 py-4 btn-glow"
            >
              Order 20L water jars on the eDrops app
            </a>
          </div>

        </div>
      </div>

      {/* Scroll indicator */}
      <div class="hidden lg:flex absolute bottom-8 left-1/2 -translate-x-1/2 z-10 animate-fade-up-delay-5" aria-hidden="true">
        <div class="w-6 h-10 rounded-full border-2 border-edrops-muted/40 flex items-start justify-center pt-2 bg-white/40 backdrop-blur-xs">
          <div class="w-1 h-2.5 rounded-full bg-edrops-muted/50 animate-bounce"></div>
        </div>
      </div>
    </section>


    {/* ═══════════════════════════════════════
        BENEFITS STRIP — REPLACES UNVERIFIED METRICS
        ═══════════════════════════════════════ */}
    


    {/* ═══════════════════════════════════════
        HOW TO ORDER — STRUCTURED OL STEPS
        ═══════════════════════════════════════ */}
    <section class="py-24 sm:py-32 px-6 border-t border-edrops-border/40 scroll-mt-24 sm:scroll-mt-28" id="how-to-order">
      <div class="mx-auto max-w-6xl space-y-16 sm:space-y-20">
        
        {/* Editorial Header */}
        <div class="max-w-3xl">
          <div class="capabilities-eyebrow">
            <span class="text-xs font-bold uppercase tracking-[0.2em] text-edrops-primary">
              How to order
            </span>
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-[3.25rem] font-extrabold tracking-tight text-edrops-ocean leading-[1.08]">
            Subscribe, or just order once.<br>
            <span class="text-gradient-water">Either way, it arrives on time.</span>
          </h2>
        </div>

        {/* Ordered steps in semantic HTML */}
        <ol class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 relative z-10 list-none p-0 m-0">
          
          {/* Step 01 */}
          <li class="group relative rounded-[20px] bg-edrops-aqua/[0.045] border border-edrops-aqua/20 p-8 sm:p-9 lg:p-10 transition-all duration-300 hover:-translate-y-1 hover:shadow-md hover:shadow-edrops-primary/[0.05] hover:border-edrops-aqua/35 flex flex-col justify-between">
            <div class="relative z-10">
              <span class="text-5xl sm:text-6xl font-extrabold text-edrops-primary/[0.12] select-none tracking-tight block mb-5 leading-none" aria-hidden="true">
                01
              </span>
              <h3 class="text-xl sm:text-2xl font-bold text-edrops-ocean tracking-tight mb-3">
                Choose how you buy
              </h3>
              <p class="text-base text-edrops-slate leading-relaxed font-normal">
                Set up a recurring subscription or place a one-time order. No commitment required either way.
              </p>
            </div>

            {/* Desktop flow connector chevron to Step 02 */}
            <div class="hidden md:flex absolute -right-3.5 lg:-right-4.5 top-1/2 -translate-y-1/2 z-20 w-7 h-7 rounded-full bg-white border border-edrops-border/80 text-edrops-primary/60 items-center justify-center shadow-xs pointer-events-none" aria-hidden="true">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </li>

          {/* Mobile vertical flow connector 1 -> 2 */}
          <li class="md:hidden flex flex-col items-center justify-center -my-2 z-10 text-edrops-primary/40 list-none" aria-hidden="true">
            <div class="w-px h-5 bg-gradient-to-b from-edrops-aqua/30 to-edrops-primary/40"></div>
            <svg class="w-3.5 h-3.5 text-edrops-primary/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </li>

          {/* Step 02 */}
          <li class="group relative rounded-[20px] bg-edrops-aqua/[0.045] border border-edrops-aqua/20 p-8 sm:p-9 lg:p-10 transition-all duration-300 hover:-translate-y-1 hover:shadow-md hover:shadow-edrops-primary/[0.05] hover:border-edrops-aqua/35 flex flex-col justify-between">
            <div class="relative z-10">
              <span class="text-5xl sm:text-6xl font-extrabold text-edrops-primary/[0.12] select-none tracking-tight block mb-5 leading-none" aria-hidden="true">
                02
              </span>
              <h3 class="text-xl sm:text-2xl font-bold text-edrops-ocean tracking-tight mb-3">
                We deliver on schedule
              </h3>
              <p class="text-base text-edrops-slate leading-relaxed font-normal">
                Subscribers get automatic recurring deliveries. One-time orders arrive on your chosen date. Both tracked live.
              </p>
            </div>

            {/* Desktop flow connector chevron to Step 03 */}
            <div class="hidden md:flex absolute -right-3.5 lg:-right-4.5 top-1/2 -translate-y-1/2 z-20 w-7 h-7 rounded-full bg-white border border-edrops-border/80 text-edrops-primary/60 items-center justify-center shadow-xs pointer-events-none" aria-hidden="true">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </li>

          {/* Mobile vertical flow connector 2 -> 3 */}
          <li class="md:hidden flex flex-col items-center justify-center -my-2 z-10 text-edrops-primary/40 list-none" aria-hidden="true">
            <div class="w-px h-5 bg-gradient-to-b from-edrops-aqua/30 to-edrops-primary/40"></div>
            <svg class="w-3.5 h-3.5 text-edrops-primary/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </li>

          {/* Step 03 */}
          <li class="group relative rounded-[20px] bg-edrops-aqua/[0.045] border border-edrops-aqua/20 p-8 sm:p-9 lg:p-10 transition-all duration-300 hover:-translate-y-1 hover:shadow-md hover:shadow-edrops-primary/[0.05] hover:border-edrops-aqua/35 flex flex-col justify-between">
            <div class="relative z-10">
              <span class="text-5xl sm:text-6xl font-extrabold text-edrops-primary/[0.12] select-none tracking-tight block mb-5 leading-none" aria-hidden="true">
                03
              </span>
              <h3 class="text-xl sm:text-2xl font-bold text-edrops-ocean tracking-tight mb-3">
                Stay in control
              </h3>
              <p class="text-base text-edrops-slate leading-relaxed font-normal">
                Pause, skip, or switch between subscription and one-time anytime from your dashboard.
              </p>
            </div>
          </li>

        </ol>

      </div>
    </section>


    {/* ═══════════════════════════════════════
        CAPABILITIES — WHY EDROPS
        ═══════════════════════════════════════ */}
    <section class="capabilities-section py-28 sm:py-36 px-6 scroll-mt-24 sm:scroll-mt-28" id="why-edrops">
      
      {/* Ambient background elements */}
      <div class="capabilities-caustic" aria-hidden="true"></div>
      <div class="capabilities-shape capabilities-shape--1" aria-hidden="true"></div>
      <div class="capabilities-shape capabilities-shape--2" aria-hidden="true"></div>
      <div class="capabilities-shape capabilities-shape--3" aria-hidden="true"></div>

      <div class="mx-auto max-w-6xl space-y-20 sm:space-y-28">
        
        {/* Editorial Header */}
        <div class="capabilities-header">
          <div class="capabilities-eyebrow">
            <span class="text-xs font-bold uppercase tracking-[0.2em] text-edrops-primary">
              Made for water jar delivery
            </span>
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-[3.25rem] font-extrabold tracking-tight text-edrops-ocean leading-[1.08]">
            Built for how you<br />
            <span class="text-gradient-water">actually order water.</span>
          </h2>
        </div>

        {/* 3-Column Equal Feature Grid */}
        <div class="capabilities-grid">
          
          {/* Feature 1 */}
          <article class="capability-card" data-capability="0">
            <span class="capability-card__number" aria-hidden="true">01</span>
            <h3 class="capability-card__title">Flexible subscriptions</h3>
            <p class="capability-card__text">Set your own delivery schedule. Get jars weekly, every few days, or whenever you need them. Pause, skip, or reschedule without calling anyone.</p>
          </article>

          {/* Feature 2 */}
          <article class="capability-card capability-card--delay-1" data-capability="1">
            <span class="capability-card__number" aria-hidden="true">02</span>
            <h3 class="capability-card__title">Prepaid wallet</h3>
            <p class="capability-card__text">Top up your wallet once, and every delivery deducts automatically. No cash at the door, no chasing payments. You always know your balance.</p>
          </article>

          {/* Feature 3 */}
          <article class="capability-card capability-card--delay-2" data-capability="2">
            <span class="capability-card__number" aria-hidden="true">03</span>
            <h3 class="capability-card__title">Complete visibility</h3>
            <p class="capability-card__text">Track your delivery live, see your jar count, check payment history, and get instant digital receipts — all from your dashboard.</p>
          </article>

        </div>
      </div>
    </section>

    <script>
      // ─── Capabilities: Scroll Reveal ───
      {
        const section = document.getElementById('why-edrops') || document.getElementById('capabilities-section');
        if (section) {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                section.classList.add('capabilities--visible');
                const cards = section.querySelectorAll('.capability-card');
                cards.forEach((card) => {
                  card.classList.add('capability-card--visible');
                });
                observer.unobserve(entry.target);
              }
            });
          }, {
            threshold: 0.15,
            rootMargin: '0px 0px -60px 0px'
          });

          observer.observe(section);
        }
      }
    </script>


    {/* ═══════════════════════════════════════
        WHY IT WORKS — CUSTOMER TRUST & VISIBILITY
        ═══════════════════════════════════════ */}
    <section class="relative overflow-hidden py-24 sm:py-32 px-6 border-t border-edrops-border/40 bg-gradient-to-b from-[#eef7fc] via-[#f3f9fd] to-[#edf6fc] scroll-mt-24 sm:scroll-mt-28" id="why-it-works">
      
      {/* Abstract organic flowing wave shapes (subtle tone-on-tone brand texture) */}
      <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
        {/* Top-right flowing wave glow */}
        <div class="absolute -top-24 -right-24 w-[480px] h-[480px] rounded-full bg-gradient-to-bl from-edrops-aqua/12 via-edrops-primary/8 to-transparent blur-3xl"></div>
        {/* Bottom-left soft wave glow */}
        <div class="absolute -bottom-28 -left-20 w-[520px] h-[520px] rounded-full bg-gradient-to-tr from-edrops-primary/10 via-edrops-aqua/8 to-transparent blur-3xl"></div>
        {/* Wavy curve vector overlay */}
        <svg class="absolute top-0 right-0 w-full h-full opacity-[0.06] text-edrops-primary" viewBox="0 0 1440 600" fill="none" preserveAspectRatio="none">
          <path d="M0,160 C320,300 480,40 800,180 C1120,320 1280,100 1440,200 L1440,600 L0,600 Z" fill="currentColor" />
          <path d="M0,280 C360,120 600,340 960,190 C1200,80 1360,260 1440,220" stroke="currentColor" stroke-width="2" fill="none" />
        </svg>
      </div>

      <div class="relative z-10 mx-auto max-w-6xl space-y-16 sm:space-y-20">
        
        {/* Editorial Header */}
        <div class="max-w-3xl space-y-4">
          <div class="capabilities-eyebrow">
            <span class="text-xs font-bold uppercase tracking-[0.2em] text-edrops-primary">
              Why customers trust eDrops
            </span>
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-[3.25rem] font-extrabold tracking-tight text-edrops-ocean leading-[1.08]">
            Water delivery you can actually rely on.
          </h2>
          <p class="text-lg sm:text-xl text-edrops-slate font-normal leading-relaxed">
            Every order tracked. Every jar accounted for. Every delivery confirmed.
          </p>
        </div>

        {/* 3 Trust Cards */}
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
          
          {/* Card 1 */}
          <div class="rounded-[20px] bg-white/95 border border-white/80 shadow-[0_4px_24px_-4px_rgba(24,60,72,0.06)] p-8 sm:p-9 lg:p-10 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_12px_32px_-4px_rgba(24,60,72,0.12)] hover:border-edrops-primary/20 flex flex-col justify-between">
            <div>
              {/* Icon Badge */}
              <div class="w-12 h-12 rounded-xl bg-edrops-aqua/10 text-edrops-primary flex items-center justify-center mb-6">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>

              <h3 class="text-xl sm:text-2xl font-bold text-edrops-ocean tracking-tight mb-3">
                Verified deliveries, every time
              </h3>
              <p class="text-base text-edrops-slate leading-relaxed font-normal mb-6">
                Every jar is logged the moment it leaves the depot and confirmed the moment it arrives. Nothing gets missed.
              </p>
            </div>

            {/* Checklist */}
            <div class="pt-6 border-t border-edrops-border/60">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-xs font-semibold text-edrops-ocean">
                <div class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-edrops-aqua shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>Delivery time</span>
                </div>
                <div class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-edrops-aqua shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>Jar count</span>
                </div>
                <div class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-edrops-aqua shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>Payment status</span>
                </div>
                <div class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-edrops-aqua shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>Delivery partner details</span>
                </div>
              </div>
            </div>
          </div>

          {/* Card 2 */}
          <div class="rounded-[20px] bg-white/95 border border-white/80 shadow-[0_4px_24px_-4px_rgba(24,60,72,0.06)] p-8 sm:p-9 lg:p-10 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_12px_32px_-4px_rgba(24,60,72,0.12)] hover:border-edrops-secondary/30 flex flex-col justify-start">
            {/* Icon Badge */}
            <div class="w-12 h-12 rounded-xl bg-edrops-secondary/10 text-edrops-secondary flex items-center justify-center mb-6">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>

            <h3 class="text-xl sm:text-2xl font-bold text-edrops-ocean tracking-tight mb-3">
              Reorder in one tap
            </h3>
            <p class="text-base text-edrops-slate leading-relaxed font-normal">
              No phone calls, no waiting on hold. Top up your wallet or place an order straight from the app, any time.
            </p>
          </div>

          {/* Card 3 */}
          <div class="rounded-[20px] bg-white/95 border border-white/80 shadow-[0_4px_24px_-4px_rgba(24,60,72,0.06)] p-8 sm:p-9 lg:p-10 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_12px_32px_-4px_rgba(24,60,72,0.12)] hover:border-edrops-primary/20 flex flex-col justify-start">
            {/* Icon Badge */}
            <div class="w-12 h-12 rounded-xl bg-edrops-aqua/10 text-edrops-primary flex items-center justify-center mb-6">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
              </svg>
            </div>

            <h3 class="text-xl sm:text-2xl font-bold text-edrops-ocean tracking-tight mb-3">
              Doorstep jar swap, zero hassle
            </h3>
            <p class="text-base text-edrops-slate leading-relaxed font-normal">
              Our delivery partner brings the full jar and takes the empty one. You never have to carry or return anything.
            </p>
          </div>

        </div>

      </div>
    </section>

    {/* ═══════════════════════════════════════
        FOR BUSINESSES — BULK WORKPLACE WATER

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Features', url: '/features/' },
  { name: 'Customer Portal', url: '/features/customer-management/' }
];

const serviceData = {
  name: 'eDrops Self-Service Customer Portal',
  description: 'Manage water jar deliveries, subscriptions, delivery addresses, and prepaid wallet balance from one easy dashboard.',
  url: '/features/customer-management/',
  serviceType: 'Customer Portal Service'
};
---

<BaseLayout
  title="Customer Portal – 20L Water Jar Delivery – eDrops"
  description="Manage your 20L water jar orders, subscription schedules, delivery addresses, and wallet balance in one self-service customer dashboard with eDrops."
  keywords="water delivery customer dashboard, water jar account portal, delivery address manager, eDrops customer portal"
  breadcrumbs={breadcrumbs}
  serviceData={serviceData}
>
  <Navigation />

  <main class="mx-auto max-w-5xl px-5 pt-32 pb-24 text-edrops-ocean min-h-screen">
    <!-- Breadcrumb visual navigation -->
    <nav aria-label="Breadcrumb" class="mb-8">
      <ol class="flex items-center space-x-2 text-xs font-semibold text-edrops-slate">
        <li><a href="/" class="hover:text-edrops-primary transition-colors">Home</a></li>
        <li class="text-edrops-muted">/</li>
        <li><a href="/features/" class="hover:text-edrops-primary transition-colors">Features</a></li>
        <li class="text-edrops-muted">/</li>
        <li class="text-edrops-ocean font-bold" aria-current="page">Customer Portal</li>
      </ol>
    </nav>

    <div class="space-y-10 max-w-3xl">
      <header class="space-y-4">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-edrops-primary">Customer Experience</span>
        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-edrops-ocean leading-tight">
          Self-service customer portal for water jar delivery
        </h1>
        <p class="text-lg text-edrops-slate leading-relaxed">
          Manage your drinking water supply effortlessly. Check delivery dates, update addresses, track wallet balances, and review past orders without phone calls.
        </p>
      </header>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-4">
        <div class="p-6 rounded-2xl bg-white border border-edrops-border shadow-xs space-y-2">
          <h2 class="text-lg font-bold text-edrops-ocean">Multi-Address Management</h2>
          <p class="text-sm text-edrops-slate leading-relaxed">
            Manage deliveries across apartments, villas, and commercial spaces with dedicated doorstep drop instructions.
          </p>
        </div>
        <div class="p-6 rounded-2xl bg-white border border-edrops-border shadow-xs space-y-2">
          <h2 class="text-lg font-bold text-edrops-ocean">Complete Order History</h2>
          <p class="text-sm text-edrops-slate leading-relaxed">
            View every completed delivery, verify jar counts, monitor wallet transactions, and download digital receipts anytime.
          </p>
        </div>
      </div>

      <div class="pt-6">
        <a href="https://app.edrops.in" class="inline-flex rounded-full bg-edrops-secondary text-white text-sm font-bold px-8 py-3.5 shadow-md hover:bg-edrops-secondary-hover transition-colors">
          Open Customer Portal
        </a>
      </div>
    </div>
  </main>
</BaseLayout>

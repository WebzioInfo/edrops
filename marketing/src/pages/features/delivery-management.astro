---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Features', url: '/features/' },
  { name: 'Doorstep Delivery', url: '/features/delivery-management/' }
];

const serviceData = {
  name: 'eDrops Doorstep Water Jar Delivery & Swap',
  description: 'Doorstep 20L water jar delivery with verified empty jar swaps and real-time delivery notifications.',
  url: '/features/delivery-management/',
  serviceType: 'Doorstep Water Delivery Service'
};
---

<BaseLayout
  title="Doorstep Jar Swap – 20L Water Jar Delivery – eDrops"
  description="Enjoy hassle-free doorstep 20L water jar delivery and swaps with eDrops. Delivery partners bring clean full jars and take your empties right at your door."
  keywords="doorstep jar swap, 20L water jar delivery, water can replacement, empty jar collection, eDrops delivery"
  breadcrumbs={breadcrumbs}
  serviceData={serviceData}
>
  <Navigation />

  <main class="mx-auto max-w-5xl px-5 pt-32 pb-24 text-edrops-ocean min-h-screen">
    <!-- Breadcrumb visual navigation -->
    <nav aria-label="Breadcrumb" class="mb-8">
      <ol class="flex items-center space-x-2 text-xs font-semibold text-edrops-slate">
        <li><a href="/" class="hover:text-edrops-primary transition-colors">Home</a></li>
        <li class="text-edrops-muted">/</li>
        <li><a href="/features/" class="hover:text-edrops-primary transition-colors">Features</a></li>
        <li class="text-edrops-muted">/</li>
        <li class="text-edrops-ocean font-bold" aria-current="page">Doorstep Delivery</li>
      </ol>
    </nav>

    <div class="space-y-10 max-w-3xl">
      <header class="space-y-4">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-edrops-primary">Doorstep Convenience</span>
        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-edrops-ocean leading-tight">
          Doorstep 20L water jar delivery and swap
        </h1>
        <p class="text-lg text-edrops-slate leading-relaxed">
          Clean, sealed 20L water jars delivered straight to your door. Our delivery partners drop off fresh drinking water and collect your empty containers in a single visit.
        </p>
      </header>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-4">
        <div class="p-6 rounded-2xl bg-white border border-edrops-border shadow-xs space-y-2">
          <h2 class="text-lg font-bold text-edrops-ocean">Verified Doorstep Swap</h2>
          <p class="text-sm text-edrops-slate leading-relaxed">
            Full jars in, empty jars out. The swap happens right at your doorstep with verified digital confirmation.
          </p>
        </div>
        <div class="p-6 rounded-2xl bg-white border border-edrops-border shadow-xs space-y-2">
          <h2 class="text-lg font-bold text-edrops-ocean">Accurate Balance Deduction</h2>
          <p class="text-sm text-edrops-slate leading-relaxed">
            Your prepaid wallet balance is only deducted when the jar is physically delivered. Zero charges for skipped stops.
          </p>
        </div>
      </div>

      <div class="pt-6">
        <a href="https://app.edrops.in" class="inline-flex rounded-full bg-edrops-secondary text-white text-sm font-bold px-8 py-3.5 shadow-md hover:bg-edrops-secondary-hover transition-colors">
          Order Water Jar Delivery
        </a>
      </div>
    </div>
  </main>
</BaseLayout>

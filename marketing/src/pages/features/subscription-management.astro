---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Features', url: '/features/' },
  { name: 'Subscriptions', url: '/features/subscription-management/' }
];

const serviceData = {
  name: 'eDrops 20L Water Jar Subscription Delivery',
  description: 'Set up recurring water jar deliveries, pause or resume anytime, choose custom frequencies, and manage jar counts.',
  url: '/features/subscription-management/',
  serviceType: '20L Water Jar Delivery Service'
};
---

<BaseLayout
  title="Subscriptions – 20L Water Jar Delivery – eDrops"
  description="Set up flexible 20L water jar subscriptions with eDrops. Choose delivery days, pause during vacations, adjust jar counts, and get doorstep swaps."
  keywords="water jar subscription, 20L water delivery plan, recurring water delivery, pause water delivery, eDrops subscription"
  breadcrumbs={breadcrumbs}
  serviceData={serviceData}
>
  <Navigation />

  <main class="mx-auto max-w-5xl px-5 pt-32 pb-24 text-edrops-ocean min-h-screen">
    <!-- Breadcrumb visual navigation -->
    <nav aria-label="Breadcrumb" class="mb-8">
      <ol class="flex items-center space-x-2 text-xs font-semibold text-edrops-slate">
        <li><a href="/" class="hover:text-edrops-primary transition-colors">Home</a></li>
        <li class="text-edrops-muted">/</li>
        <li><a href="/features/" class="hover:text-edrops-primary transition-colors">Features</a></li>
        <li class="text-edrops-muted">/</li>
        <li class="text-edrops-ocean font-bold" aria-current="page">Subscriptions</li>
      </ol>
    </nav>

    <div class="space-y-10 max-w-3xl">
      <header class="space-y-4">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-edrops-primary">Recurring Convenience</span>
        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-edrops-ocean leading-tight">
          Flexible subscriptions for 20L water jar delivery
        </h1>
        <p class="text-lg text-edrops-slate leading-relaxed">
          Set up a recurring schedule that matches your household or office drinking water needs. Pause, skip, or adjust jar counts anytime — with zero lock-in.
        </p>
      </header>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-4">
        <div class="p-6 rounded-2xl bg-white border border-edrops-border shadow-xs space-y-2">
          <h2 class="text-lg font-bold text-edrops-ocean">Zero-Lockin Flexibility</h2>
          <p class="text-sm text-edrops-slate leading-relaxed">
            Adjust delivery dates, request extra jars for family events, or pause deliveries during holidays straight from your phone.
          </p>
        </div>
        <div class="p-6 rounded-2xl bg-white border border-edrops-border shadow-xs space-y-2">
          <h2 class="text-lg font-bold text-edrops-ocean">Low-Balance Reminders</h2>
          <p class="text-sm text-edrops-slate leading-relaxed">
            Receive helpful alerts when your prepaid balance is low so your recurring deliveries arrive on time without interruption.
          </p>
        </div>
      </div>

      <div class="pt-6">
        <a href="https://app.edrops.in" class="inline-flex rounded-full bg-edrops-secondary text-white text-sm font-bold px-8 py-3.5 shadow-md hover:bg-edrops-secondary-hover transition-colors">
          Start Your Water Subscription
        </a>
      </div>
    </div>
  </main>
</BaseLayout>

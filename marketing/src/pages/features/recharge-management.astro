---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Features', url: '/features/' },
  { name: 'Recharge Management', url: '/features/recharge-management/' }
];

const serviceData = {
  name: 'eDrops Prepaid Water Jar Wallet & Recharge Management System',
  description: 'Recharge prepaid water jar balances, manage jar packs, volume offers, digital payments, and instant transaction receipts.',
  url: '/features/recharge-management/',
  serviceType: 'Prepaid Wallet Software'
};
---

<BaseLayout
  title="Prepaid Water Jar Wallet & Recharge Management System | eDrops™"
  description="Recharge prepaid water jar balances, manage jar packs, offers, payments, and transaction history with automated balance tracking."
  keywords="Water jar recharge software, prepaid water wallet, water delivery payment gateway, jar pack offers"
  breadcrumbs={breadcrumbs}
  serviceData={serviceData}
>
  <Navigation />

  <main class="mx-auto max-w-5xl px-5 pt-32 pb-24 text-edrops-ocean min-h-screen">
    <!-- Breadcrumb visual navigation -->
    <nav aria-label="Breadcrumb" class="mb-8">
      <ol class="flex items-center space-x-2 text-xs font-semibold text-edrops-slate">
        <li><a href="/" class="hover:text-edrops-primary transition-colors">Home</a></li>
        <li class="text-edrops-muted">/</li>
        <li><a href="/features/" class="hover:text-edrops-primary transition-colors">Features</a></li>
        <li class="text-edrops-muted">/</li>
        <li class="text-edrops-ocean font-bold" aria-current="page">Recharge Management</li>
      </ol>
    </nav>

    <div class="space-y-10 max-w-3xl">
      <header class="space-y-4">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-edrops-primary">Prepaid Security</span>
        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-edrops-ocean leading-tight">
          Recharge management that customers can see.
        </h1>
        <p class="text-lg text-edrops-slate leading-relaxed">
          When customers recharge, eDrops fills the smart jar, updates prepaid balance, logs the transaction, and recommends the next pack based on consumption.
        </p>
      </header>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-4">
        <div class="p-6 rounded-2xl bg-white border border-edrops-border shadow-xs space-y-2">
          <h2 class="text-lg font-bold text-edrops-ocean">Instant UPI & Cards</h2>
          <p class="text-sm text-edrops-slate leading-relaxed">
            Zero gateway delays. Wallet credits appear instantly on customer screens with downloadable tax invoices.
          </p>
        </div>
        <div class="p-6 rounded-2xl bg-white border border-edrops-border shadow-xs space-y-2">
          <h2 class="text-lg font-bold text-edrops-ocean">Volume Promo Engine</h2>
          <p class="text-sm text-edrops-slate leading-relaxed">
            Offer tiered incentives (e.g., buy 10 jars, get 1 free) to secure predictable upfront operating cashflow.
          </p>
        </div>
      </div>

      <div class="pt-6">
        <a href="https://app.edrops.in" class="inline-flex rounded-full bg-edrops-secondary text-white text-sm font-bold px-8 py-3.5 shadow-md hover:bg-edrops-secondary-hover transition-colors">
          Explore Recharge Engine
        </a>
      </div>
    </div>
  </main>
</BaseLayout>

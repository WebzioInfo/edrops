---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Contact', url: '/contact/' }
];
---

<BaseLayout
  title="Contact eDrops™ | Sales, Customer Support & Water Plant Onboarding"
  description="Contact the eDrops team for customer support, enterprise workplace delivery plans, or water plant onboarding inquiries across India."
  keywords="Contact eDrops, water delivery customer support, water plant software sales, bulk water jar delivery contact"
  breadcrumbs={breadcrumbs}
>
  <Navigation />

  <main id="main-content" class="pt-32 pb-24 px-5 max-w-5xl mx-auto min-h-screen">
    <!-- Breadcrumb visual navigation -->
    <nav aria-label="Breadcrumb" class="mb-8">
      <ol class="flex items-center space-x-2 text-xs font-semibold text-edrops-slate">
        <li><a href="/" class="hover:text-edrops-primary transition-colors">Home</a></li>
        <li class="text-edrops-muted">/</li>
        <li class="text-edrops-ocean font-bold" aria-current="page">Contact</li>
      </ol>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
      <div class="space-y-6">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-edrops-primary">Get in Touch</span>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-edrops-ocean tracking-tight">
          We’re here to help you flow.
        </h1>
        <p class="text-lg text-edrops-slate leading-relaxed">
          Have questions about residential subscriptions, bulk office orders, or onboarding your water bottling plant onto the eDrops platform? Reach out to our dedicated support team.
        </p>

        <div class="space-y-4 pt-4">
          <div class="p-6 rounded-2xl bg-white border border-edrops-border shadow-xs space-y-1">
            <span class="text-xs font-bold uppercase tracking-wider text-edrops-primary">Direct Phone & WhatsApp</span>
            <div>
              <a href="tel:+917907805620" class="text-2xl font-bold text-edrops-ocean hover:text-edrops-primary transition-colors">
                +91 7907805620
              </a>
            </div>
            <p class="text-xs text-edrops-muted">Available Monday to Saturday, 7:00 AM – 8:00 PM IST</p>
          </div>

          <div class="p-6 rounded-2xl bg-white border border-edrops-border shadow-xs space-y-1">
            <span class="text-xs font-bold uppercase tracking-wider text-edrops-primary">Email Support</span>
            <div>
              <a href="mailto:support@edrops.in" class="text-xl font-bold text-edrops-ocean hover:text-edrops-primary transition-colors">
                support@edrops.in
              </a>
            </div>
            <p class="text-xs text-edrops-muted">Rapid response within 2 business hours</p>
          </div>

          <div class="p-6 rounded-2xl bg-white border border-edrops-border shadow-xs space-y-1">
            <span class="text-xs font-bold uppercase tracking-wider text-edrops-primary">Headquarters & Operating Hub</span>
            <p class="text-sm font-semibold text-edrops-ocean">
              eDrops Technologies Private Limited
            </p>
            <p class="text-xs text-edrops-slate leading-relaxed">
              Kondotty, Malappuram, Kerala 673638, India
            </p>
          </div>
        </div>
      </div>

      <!-- Quick Platform Actions Card -->
      <div class="p-8 sm:p-10 rounded-3xl bg-white border border-edrops-border shadow-md space-y-6">
        <h2 class="text-2xl font-bold text-edrops-ocean">Need Immediate Access?</h2>
        <p class="text-sm text-edrops-slate leading-relaxed">
          Access your self-service portals instantly without waiting for an email response:
        </p>
        <div class="space-y-3">
          <a href="https://app.edrops.in/login" class="w-full flex items-center justify-between p-4 rounded-xl bg-edrops-light/60 hover:bg-edrops-light text-edrops-ocean font-bold text-sm border border-edrops-border/60 transition-colors">
            <span>Customer Portal Login</span>
            <span>→</span>
          </a>
          <a href="https://app.edrops.in/login" class="w-full flex items-center justify-between p-4 rounded-xl bg-edrops-light/60 hover:bg-edrops-light text-edrops-ocean font-bold text-sm border border-edrops-border/60 transition-colors">
            <span>Delivery Partner Dispatch</span>
            <span>→</span>
          </a>
          <a href="https://app.edrops.in/login" class="w-full flex items-center justify-between p-4 rounded-xl bg-edrops-light/60 hover:bg-edrops-light text-edrops-ocean font-bold text-sm border border-edrops-border/60 transition-colors">
            <span>Distributor & Plant Portal</span>
            <span>→</span>
          </a>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
---

<BaseLayout
  title="Contact Us | Edrops — Water Delivery Support & Sales"
  description="Contact the Edrops team for customer support, enterprise workplace delivery plans, or water plant onboarding inquiries."
  keywords="Contact Edrops, water delivery support, water plant software sales"
>
  <Navigation />

  <main id="main-content" class="pt-32 pb-20 px-5 max-w-7xl mx-auto min-h-screen">
    <div class="max-w-3xl space-y-6">
      <h1 class="text-4xl sm:text-5xl font-extrabold text-edrops-ocean tracking-tight">Contact Edrops</h1>
      <p class="text-lg text-edrops-slate leading-relaxed">
        Have questions about residential subscriptions, office bulk water orders, or plant management software? Reach out to our team.
      </p>
      <div class="p-8 rounded-2xl bg-white border border-edrops-border shadow-xs space-y-4 pt-6">
        <div>
          <h3 class="text-sm font-semibold text-edrops-primary uppercase tracking-wider">Phone & WhatsApp Support</h3>
          <a href="tel:+917907805620" class="text-2xl font-bold text-edrops-ocean hover:text-edrops-primary transition-colors">
            +91 7907805620
          </a>
        </div>
        <div>
          <h3 class="text-sm font-semibold text-edrops-primary uppercase tracking-wider">Platform Portal</h3>
          <a href="https://app.edrops.in" class="text-lg font-bold text-edrops-secondary hover:underline">
            app.edrops.in
          </a>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

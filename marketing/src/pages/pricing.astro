---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
---

<BaseLayout
  title="Pricing & Plans | Edrops — Water Delivery Management"
  description="Transparent pricing for 20L water delivery businesses, water plants, and distributors. Free starter tier with volume scaling as your routes expand."
  keywords="Edrops pricing, water delivery software price, water jar subscription software cost"
>
  <Navigation />

  <main id="main-content" class="pt-32 pb-20 px-5 max-w-7xl mx-auto min-h-screen">
    <div class="max-w-3xl space-y-6">
      <h1 class="text-4xl sm:text-5xl font-extrabold text-edrops-ocean tracking-tight">Simple, Transparent Pricing</h1>
      <p class="text-lg text-edrops-slate leading-relaxed">
        Whether you are managing a single delivery route or multi-branch water plants, Edrops scales with your business volume with zero lock-in contracts.
      </p>
      <div class="pt-4">
        <a href="https://app.edrops.in" class="inline-flex rounded-full bg-edrops-secondary text-white font-bold px-8 py-3.5 shadow-md hover:bg-edrops-navy transition-colors">
          Start Free on Edrops
        </a>
      </div>
    </div>
  </main>
</BaseLayout>

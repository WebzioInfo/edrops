---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Pricing', url: '/pricing/' }
];
---

<BaseLayout
  title="Pricing – 20L Water Jar Delivery – eDrops"
  description="See eDrops water jar delivery pricing. Transparent per-jar rates, prepaid wallet top-ups, and bulk discounts for offices. No hidden fees."
  keywords="eDrops pricing, water jar delivery price, 20L water jar cost, water delivery rates, bulk water jar pricing"
  breadcrumbs={breadcrumbs}
  noindex={true}
>
  <Navigation />

  <main id="main-content" class="pt-32 pb-24 px-5 max-w-6xl mx-auto min-h-screen">
    <!-- Breadcrumb visual navigation -->
    <nav aria-label="Breadcrumb" class="mb-8">
      <ol class="flex items-center space-x-2 text-xs font-semibold text-edrops-slate">
        <li><a href="/" class="hover:text-edrops-primary transition-colors">Home</a></li>
        <li class="text-edrops-muted">/</li>
        <li class="text-edrops-ocean font-bold" aria-current="page">Pricing</li>
      </ol>
    </nav>

    <div class="space-y-12">
      <header class="max-w-3xl space-y-4">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-edrops-primary">Transparent pricing</span>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-edrops-ocean tracking-tight">
          Simple, fair water jar pricing
        </h1>
        <p class="text-lg text-edrops-slate leading-relaxed">
          <!-- TODO: Add actual per-jar pricing once confirmed. Pricing below is from existing codebase and needs verification. -->
          Pay per jar or subscribe for regular deliveries. Top up your prepaid wallet and never worry about cash at the door. Bulk orders for offices get volume discounts.
        </p>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4">
        <!-- Individual / Home -->
        <div class="p-8 rounded-2xl bg-white border border-edrops-border shadow-xs flex flex-col justify-between">
          <div class="space-y-4">
            <span class="text-xs font-bold uppercase tracking-wider text-edrops-primary">For homes</span>
            <h2 class="text-2xl font-bold text-edrops-ocean">Individual orders</h2>
            <p class="text-sm text-edrops-slate">Order one jar or subscribe for weekly delivery. Pay from your prepaid wallet — no minimum order required.</p>
            <ul class="space-y-2.5 pt-4 text-xs font-semibold text-edrops-ocean">
              <li class="flex items-center gap-2"><span class="text-edrops-primary">✓</span> One-time or recurring delivery</li>
              <li class="flex items-center gap-2"><span class="text-edrops-primary">✓</span> Prepaid wallet — no cash needed</li>
              <li class="flex items-center gap-2"><span class="text-edrops-primary">✓</span> Doorstep jar swap</li>
              <li class="flex items-center gap-2"><span class="text-edrops-primary">✓</span> Pause or skip anytime</li>
            </ul>
          </div>
          <div class="pt-8">
            <a href="https://app.edrops.in" class="w-full inline-flex items-center justify-center rounded-full bg-edrops-secondary text-white text-xs font-bold py-3 shadow-md hover:bg-edrops-secondary-hover transition-colors">
              Start Ordering
            </a>
          </div>
        </div>

        <!-- Bulk / Office -->
        <div class="p-8 rounded-2xl bg-white border-2 border-edrops-primary shadow-lg relative flex flex-col justify-between">
          <div class="absolute -top-3.5 right-6 px-3 py-1 rounded-full bg-edrops-primary text-white text-[11px] font-black tracking-wider uppercase">
            Best for offices
          </div>
          <div class="space-y-4">
            <span class="text-xs font-bold uppercase tracking-wider text-edrops-primary">For offices & businesses</span>
            <h2 class="text-2xl font-bold text-edrops-ocean">Bulk orders</h2>
            <p class="text-sm text-edrops-slate">Volume-based pricing for offices, cafes, clinics, and workplaces. Flexible schedules and dedicated support.</p>
            <ul class="space-y-2.5 pt-4 text-xs font-semibold text-edrops-ocean">
              <li class="flex items-center gap-2"><span class="text-edrops-primary">✓</span> Volume discounts on bulk orders</li>
              <li class="flex items-center gap-2"><span class="text-edrops-primary">✓</span> Custom delivery schedule</li>
              <li class="flex items-center gap-2"><span class="text-edrops-primary">✓</span> Single point of contact</li>
              <li class="flex items-center gap-2"><span class="text-edrops-primary">✓</span> Usage reports & billing</li>
            </ul>
          </div>
          <div class="pt-8">
            <a href="/contact/" class="w-full inline-flex items-center justify-center rounded-full bg-edrops-light text-edrops-ocean text-xs font-bold py-3 hover:bg-edrops-primary hover:text-white transition-colors">
              Contact for Bulk Pricing
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Pricing', url: '/pricing/' }
];
---

<BaseLayout
  title="eDrops™ Pricing | Transparent Software & Route Plans for Water Businesses"
  description="Transparent pricing for 20L water delivery businesses, water plants, and distributors. Free starter tier with volume scaling as your routes expand."
  keywords="eDrops pricing, water delivery software price, water jar subscription software cost, water plant ERP pricing"
  breadcrumbs={breadcrumbs}
>
  <Navigation />

  <main id="main-content" class="pt-32 pb-24 px-5 max-w-6xl mx-auto min-h-screen">
    <!-- Breadcrumb visual navigation -->
    <nav aria-label="Breadcrumb" class="mb-8">
      <ol class="flex items-center space-x-2 text-xs font-semibold text-edrops-slate">
        <li><a href="/" class="hover:text-edrops-primary transition-colors">Home</a></li>
        <li class="text-edrops-muted">/</li>
        <li class="text-edrops-ocean font-bold" aria-current="page">Pricing</li>
      </ol>
    </nav>

    <div class="space-y-12">
      <header class="max-w-3xl space-y-4">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-edrops-primary">Predictable Economics</span>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-edrops-ocean tracking-tight">
          Simple, Transparent Pricing
        </h1>
        <p class="text-lg text-edrops-slate leading-relaxed">
          Whether you are launching your first water delivery route or operating high-capacity regional water bottling plants, eDrops scales seamlessly with zero lock-in contracts.
        </p>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-4">
        <!-- Starter Plan -->
        <div class="p-8 rounded-2xl bg-white border border-edrops-border shadow-xs flex flex-col justify-between">
          <div class="space-y-4">
            <span class="text-xs font-bold uppercase tracking-wider text-edrops-primary">Starter Tier</span>
            <h2 class="text-2xl font-bold text-edrops-ocean">Free</h2>
            <p class="text-sm text-edrops-slate">Ideal for local single-vehicle operators and small distributors getting started.</p>
            <ul class="space-y-2.5 pt-4 text-xs font-semibold text-edrops-ocean">
              <li class="flex items-center gap-2"><span class="text-edrops-primary">✓</span> Up to 50 active subscribers</li>
              <li class="flex items-center gap-2"><span class="text-edrops-primary">✓</span> Digital prepaid jar wallet</li>
              <li class="flex items-center gap-2"><span class="text-edrops-primary">✓</span> Mobile route delivery sheets</li>
              <li class="flex items-center gap-2"><span class="text-edrops-primary">✓</span> Doorstep jar swap verification</li>
            </ul>
          </div>
          <div class="pt-8">
            <a href="https://app.edrops.in" class="w-full inline-flex items-center justify-center rounded-full bg-edrops-light text-edrops-ocean text-xs font-bold py-3 hover:bg-edrops-primary hover:text-white transition-colors">
              Get Started Free
            </a>
          </div>
        </div>

        <!-- Pro Route Plan -->
        <div class="p-8 rounded-2xl bg-white border-2 border-edrops-primary shadow-lg relative flex flex-col justify-between">
          <div class="absolute -top-3.5 right-6 px-3 py-1 rounded-full bg-edrops-primary text-white text-[11px] font-black tracking-wider uppercase">
            Most Popular
          </div>
          <div class="space-y-4">
            <span class="text-xs font-bold uppercase tracking-wider text-edrops-primary">Pro Fleet</span>
            <div class="flex items-baseline gap-1">
              <h2 class="text-3xl font-extrabold text-edrops-ocean">₹999</h2>
              <span class="text-xs text-edrops-slate">/ month</span>
            </div>
            <p class="text-sm text-edrops-slate">Built for growing water delivery businesses managing multiple drivers and routes.</p>
            <ul class="space-y-2.5 pt-4 text-xs font-semibold text-edrops-ocean">
              <li class="flex items-center gap-2"><span class="text-edrops-primary">✓</span> Unlimited active customers</li>
              <li class="flex items-center gap-2"><span class="text-edrops-primary">✓</span> Automated route optimization</li>
              <li class="flex items-center gap-2"><span class="text-edrops-primary">✓</span> Driver delivery staff app</li>
              <li class="flex items-center gap-2"><span class="text-edrops-primary">✓</span> Automated low-balance SMS / WhatsApp alerts</li>
              <li class="flex items-center gap-2"><span class="text-edrops-primary">✓</span> Live jar inventory & shrinkage audit</li>
            </ul>
          </div>
          <div class="pt-8">
            <a href="https://app.edrops.in" class="w-full inline-flex items-center justify-center rounded-full bg-edrops-secondary text-white text-xs font-bold py-3 shadow-md hover:bg-edrops-secondary-hover transition-colors">
              Start 14-Day Free Trial
            </a>
          </div>
        </div>

        <!-- Enterprise Plant Plan -->
        <div class="p-8 rounded-2xl bg-white border border-edrops-border shadow-xs flex flex-col justify-between">
          <div class="space-y-4">
            <span class="text-xs font-bold uppercase tracking-wider text-edrops-primary">Enterprise</span>
            <div class="flex items-baseline gap-1">
              <h2 class="text-3xl font-extrabold text-edrops-ocean">₹4,999</h2>
              <span class="text-xs text-edrops-slate">/ month</span>
            </div>
            <p class="text-sm text-edrops-slate">Designed for water manufacturing plants and multi-branch distribution franchises.</p>
            <ul class="space-y-2.5 pt-4 text-xs font-semibold text-edrops-ocean">
              <li class="flex items-center gap-2"><span class="text-edrops-primary">✓</span> Multi-branch distributor network</li>
              <li class="flex items-center gap-2"><span class="text-edrops-primary">✓</span> Plant dispatch & bottling line ledger</li>
              <li class="flex items-center gap-2"><span class="text-edrops-primary">✓</span> Custom GST invoicing & ERP sync</li>
              <li class="flex items-center gap-2"><span class="text-edrops-primary">✓</span> Dedicated account manager & SLA</li>
            </ul>
          </div>
          <div class="pt-8">
            <a href="/contact/" class="w-full inline-flex items-center justify-center rounded-full bg-edrops-light text-edrops-ocean text-xs font-bold py-3 hover:bg-edrops-primary hover:text-white transition-colors">
              Speak with Sales
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Bulk Orders', url: '/bulk-orders/' }
];
---

<BaseLayout
  title="Bulk Orders | 20L Water Jar Delivery – eDrops"
  description="Bulk purified 20L water jar delivery for offices, cafes, clinics, and homes with eDrops. Priority scheduling and volume delivery benefits."
  keywords="bulk water jar delivery, office water delivery, commercial water jars, workplace water supply, 20L water for offices, eDrops bulk orders"
  breadcrumbs={breadcrumbs}
>
  <Navigation />

  <main id="main-content" class="pt-32 pb-24 px-5 max-w-6xl mx-auto min-h-screen">
    <!-- Breadcrumb visual navigation -->
    <nav aria-label="Breadcrumb" class="mb-8">
      <ol class="flex items-center space-x-2 text-xs font-semibold text-edrops-slate">
        <li><a href="/" class="hover:text-edrops-primary transition-colors">Home</a></li>
        <li class="text-edrops-muted">/</li>
        <li class="text-edrops-ocean font-bold" aria-current="page">Bulk Orders</li>
      </ol>
    </nav>

    <div class="space-y-12">
      <header class="max-w-3xl space-y-4">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-edrops-primary">Homes & Workplaces</span>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-edrops-ocean tracking-tight">
          Bulk 20L water jar delivery for your home or workplace
        </h1>
        <p class="text-lg text-edrops-slate leading-relaxed">
          Keep your office, cafe, clinic, shop, or large household stocked with purified 20L water jars. Order in bulk for volume benefits, set your delivery schedule, and manage everything from one customer account.
        </p>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4">
        <article class="p-8 rounded-2xl bg-white border border-edrops-border shadow-xs hover:border-edrops-primary/40 hover:shadow-md transition-all">
          <div class="space-y-3">
            <h2 class="text-xl font-bold text-edrops-ocean">Offices & co-working spaces</h2>
            <p class="text-sm text-edrops-slate leading-relaxed">
              Regular water jar delivery on your schedule. Volume benefits, order receipts, and dependable doorstep delivery for your team.
            </p>
          </div>
        </article>

        <article class="p-8 rounded-2xl bg-white border border-edrops-border shadow-xs hover:border-edrops-primary/40 hover:shadow-md transition-all">
          <div class="space-y-3">
            <h2 class="text-xl font-bold text-edrops-ocean">Cafes & restaurants</h2>
            <p class="text-sm text-edrops-slate leading-relaxed">
              Keep your kitchen supplied without worrying about reordering. Automatic deliveries, adjusted to your peak operational hours.
            </p>
          </div>
        </article>

        <article class="p-8 rounded-2xl bg-white border border-edrops-border shadow-xs hover:border-edrops-primary/40 hover:shadow-md transition-all">
          <div class="space-y-3">
            <h2 class="text-xl font-bold text-edrops-ocean">Clinics & healthcare facilities</h2>
            <p class="text-sm text-edrops-slate leading-relaxed">
              Dependable purified water supply for healthcare facilities. Consistent deliveries, hygienic handling, and easy jar swap.
            </p>
          </div>
        </article>

        <article class="p-8 rounded-2xl bg-white border border-edrops-border shadow-xs hover:border-edrops-primary/40 hover:shadow-md transition-all">
          <div class="space-y-3">
            <h2 class="text-xl font-bold text-edrops-ocean">Retail stores & large homes</h2>
            <p class="text-sm text-edrops-slate leading-relaxed">
              Drinking water for your team, guests, or large family, delivered on time. Place orders directly from the eDrops app without manual phone calls.
            </p>
          </div>
        </article>
      </div>

      <div class="p-8 rounded-2xl bg-gradient-to-r from-edrops-light to-white border border-edrops-border text-center space-y-4">
        <h2 class="text-2xl font-bold text-edrops-ocean">Need bulk water delivery for your workplace?</h2>
        <p class="text-sm text-edrops-slate max-w-lg mx-auto">
          Contact our team for volume delivery benefits and a schedule tailored to your business in Kondotty and Malappuram.
        </p>
        <div class="pt-2">
          <a href="/contact/" class="inline-flex items-center justify-center rounded-full bg-edrops-secondary text-white text-sm font-bold px-8 py-3.5 shadow-md hover:bg-edrops-secondary-hover transition-colors">
            Enquire for Bulk Delivery
          </a>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

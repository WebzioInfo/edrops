---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';

const posts = await getCollection('blog');

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog/' }
];
---

<BaseLayout
  title="eDrops™ Blog & Insights | 20L Water Delivery, Logistics & Subscriptions"
  description="Expert guides and operational playbooks for 20L water delivery businesses, bottled water plants, route optimization, and subscription growth."
  keywords="Water delivery blog, water distribution business guide, 20L water jar subscription logistics, water plant growth"
  breadcrumbs={breadcrumbs}
>
  <Navigation />

  <main class="mx-auto max-w-6xl px-5 pt-32 pb-24 text-edrops-ocean min-h-screen">
    <!-- Breadcrumb visual navigation -->
    <nav aria-label="Breadcrumb" class="mb-8">
      <ol class="flex items-center space-x-2 text-xs font-semibold text-edrops-slate">
        <li><a href="/" class="hover:text-edrops-primary transition-colors">Home</a></li>
        <li class="text-edrops-muted">/</li>
        <li class="text-edrops-ocean font-bold" aria-current="page">Blog</li>
      </ol>
    </nav>

    <header class="max-w-3xl space-y-4 mb-12">
      <span class="text-xs font-bold uppercase tracking-[0.2em] text-edrops-primary">Knowledge Hub</span>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-edrops-ocean leading-tight">
        Water delivery growth insights.
      </h1>
      <p class="text-lg text-edrops-slate leading-relaxed">
        Operational strategies, subscription models, and dispatch technology for scaling modern 20L water operations.
      </p>
    </header>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => {
        const slug = post.id.replace(/\.md$/, '');
        return (
          <article class="p-7 rounded-2xl bg-white border border-edrops-border shadow-xs hover:border-edrops-primary/40 hover:shadow-md transition-all flex flex-col justify-between">
            <div>
              <span class="text-xs font-bold uppercase tracking-[0.2em] text-edrops-primary">
                {post.data.category}
              </span>
              <h2 class="mt-3 text-xl font-bold text-edrops-ocean hover:text-edrops-primary transition-colors">
                <a href={`/blog/${slug}/`}>{post.data.title}</a>
              </h2>
              <p class="mt-3 text-sm text-edrops-slate leading-relaxed">
                {post.data.description}
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-edrops-border/40 flex items-center justify-between">
              <a href={`/blog/${slug}/`} class="text-xs font-bold text-edrops-primary hover:underline">
                Read guide →
              </a>
              {post.data.publishDate && (
                <time class="text-xs text-edrops-muted">
                  {new Date(post.data.publishDate).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
                </time>
              )}
            </div>
          </article>
        );
      })}
    </div>
  </main>
</BaseLayout>

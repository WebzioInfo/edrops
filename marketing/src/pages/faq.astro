---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'FAQ', url: '/faq/' }
];

const faqItems = [
  {
    question: "What is eDrops?",
    answer: "eDrops is a 20L water jar delivery app. Customers order jars online, subscribe to recurring deliveries, top up a prepaid wallet, and get doorstep jar swaps — all from one app. No phone calls needed."
  },
  {
    question: "How do I order a 20L water jar?",
    answer: "Open eDrops at app.edrops.in, choose a one-time order or set up a recurring subscription, select how many jars you need, and pay via UPI, card, or your prepaid wallet. Your jars are delivered to your doorstep on the scheduled date."
  },
  {
    question: "How does the jar swap work?",
    answer: "Our delivery partner brings full 20L jars to your door and takes the empty ones back. You don't need to carry or return anything yourself — the swap happens right at your doorstep during every delivery."
  },
  {
    question: "How does the prepaid wallet work?",
    answer: "You top up your eDrops wallet in advance using UPI, credit/debit card, or net banking. Each time a delivery is completed, the jar cost deducts automatically from your balance. You get an instant digital receipt with every delivery."
  },
  {
    question: "Can I pause, skip, or change my subscription?",
    answer: "Yes. You can pause your subscription during vacations, skip an upcoming delivery, change the number of jars, or reschedule a delivery date — all from your eDrops dashboard, any time, without calling anyone."
  },
  {
    question: "Which areas do you deliver to?",
    answer: "eDrops currently delivers in Kondotty and Malappuram, Kerala. We are expanding to more areas. Check the app for the latest delivery availability in your pincode."
  },
  {
    question: "What payment methods are accepted?",
    answer: "eDrops accepts UPI, credit cards, debit cards, and net banking. You can also pay from your prepaid eDrops wallet balance."
  },
  {
    question: "How do I track my order?",
    answer: "After placing an order, you can track its status live from your eDrops dashboard. You'll see when your jars are out for delivery and when they've been delivered."
  },
  {
    question: "Is there a minimum order?",
    answer: "No minimum order is required for individual customers. You can order as few as one 20L water jar at a time. Bulk orders for offices may have separate volume-based pricing."
  }
];
---

<BaseLayout
  title="FAQ – 20L Water Jar Delivery – eDrops"
  description="Answers to common questions about eDrops: how to order 20L water jars, prepaid wallet, jar swap, subscriptions, delivery areas, and payments."
  keywords="eDrops FAQ, water jar delivery questions, 20L water order help, water subscription FAQ, prepaid wallet FAQ"
  faqItems={faqItems}
  breadcrumbs={breadcrumbs}
>
  <Navigation />

  <main id="main-content" class="pt-32 pb-24 px-5 max-w-4xl mx-auto min-h-screen">
    <!-- Breadcrumb visual navigation -->
    <nav aria-label="Breadcrumb" class="mb-8">
      <ol class="flex items-center space-x-2 text-xs font-semibold text-edrops-slate">
        <li><a href="/" class="hover:text-edrops-primary transition-colors">Home</a></li>
        <li class="text-edrops-muted">/</li>
        <li class="text-edrops-ocean font-bold" aria-current="page">FAQ</li>
      </ol>
    </nav>

    <div class="space-y-10">
      <header class="space-y-4">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-edrops-primary">Got Questions?</span>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-edrops-ocean tracking-tight">
          Frequently Asked Questions
        </h1>
        <p class="text-lg text-edrops-slate leading-relaxed">
          Everything you need to know about ordering 20L water jars, subscriptions, the prepaid wallet, and delivery.
        </p>
      </header>

      <div class="space-y-4 pt-2">
        {faqItems.map((item, idx) => (
          <details class="group rounded-2xl bg-white border border-edrops-border p-6 shadow-xs hover:border-edrops-primary/40 transition-all duration-200" open={idx === 0}>
            <summary class="flex justify-between items-center cursor-pointer list-none select-none gap-4">
              <h2 class="text-lg sm:text-xl font-bold text-edrops-ocean tracking-tight">
                {item.question}
              </h2>
              <span class="w-8 h-8 rounded-full bg-edrops-light text-edrops-primary flex items-center justify-center shrink-0 transition-transform duration-300 group-open:rotate-180">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <p class="mt-4 text-sm sm:text-base text-edrops-slate leading-relaxed pt-3 border-t border-edrops-border/40">
              {item.answer}
            </p>
          </details>
        ))}
      </div>

      <div class="p-8 rounded-2xl bg-edrops-light/60 border border-edrops-border text-center space-y-4">
        <h2 class="text-xl font-bold text-edrops-ocean">Still have questions?</h2>
        <p class="text-sm text-edrops-slate max-w-md mx-auto">
          Our team is here to help with orders, deliveries, or account questions.
        </p>
        <div class="flex items-center justify-center gap-4 pt-2">
          <a href="/contact/" class="inline-flex items-center justify-center rounded-full bg-edrops-primary text-white text-sm font-bold px-7 py-3 shadow-xs hover:bg-edrops-primary-hover transition-colors">
            Contact Support
          </a>
          <a href="tel:+917907805626" class="inline-flex items-center justify-center rounded-full bg-white text-edrops-ocean text-sm font-bold px-7 py-3 border border-edrops-border hover:bg-edrops-light transition-colors">
            +91 7907805626
          </a>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

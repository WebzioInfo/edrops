---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';

const faqItems = [
  {
    question: "What is Edrops and how does water jar delivery work?",
    answer: "Edrops is a specialized water jar subscription and delivery platform. Customers can set up recurring delivery schedules or place one-time orders with doorstep delivery and empty jar collection."
  },
  {
    question: "How do prepaid balances work?",
    answer: "You top up your digital jar wallet upfront. Whenever our delivery partner drops off a jar, your balance automatically updates in real time with an electronic delivery confirmation."
  },
  {
    question: "Can I order bulk water jars for my office or business?",
    answer: "Yes, we support bulk orders for corporate offices, commercial establishments, clinics, and restaurants with tiered volume discounts and monthly consolidated invoicing."
  },
  {
    question: "Can I pause my subscription when going on vacation?",
    answer: "Yes, you can pause, resume, or skip any scheduled delivery date directly from the Edrops dashboard anytime without penalty."
  }
];
---

<BaseLayout
  title="FAQ | Edrops — Water Jar Delivery & Platform Questions"
  description="Find answers to common questions about 20L water jar delivery subscriptions, prepaid recharge balances, and commercial bulk water services."
  keywords="Edrops FAQ, water delivery questions, 20L water subscription guide"
  faqItems={faqItems}
>
  <Navigation />

  <main id="main-content" class="pt-32 pb-20 px-5 max-w-4xl mx-auto min-h-screen">
    <div class="space-y-8">
      <div>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-edrops-ocean tracking-tight">Frequently Asked Questions</h1>
        <p class="mt-4 text-lg text-edrops-slate leading-relaxed">
          Clear answers about Edrops 20L water jar delivery, subscriptions, and management.
        </p>
      </div>

      <div class="space-y-4 pt-4">
        {faqItems.map((item, idx) => (
          <details class="p-6 rounded-2xl bg-white border border-edrops-border shadow-xs" open={idx === 0}>
            <summary class="text-lg font-bold text-edrops-ocean cursor-pointer list-none">
              <h3>{item.question}</h3>
            </summary>
            <p class="mt-3 text-base text-edrops-slate leading-relaxed">
              {item.answer}
            </p>
          </details>
        ))}
      </div>
    </div>
  </main>
</BaseLayout>

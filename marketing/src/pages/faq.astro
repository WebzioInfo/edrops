---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'FAQ', url: '/faq/' }
];

const faqItems = [
  {
    question: "What is eDrops and how does the 20L water jar delivery platform work?",
    answer: "eDrops is an all-in-one software platform and doorstep delivery service built specifically for 20L packaged drinking water jars. It connects water manufacturing plants, licensed distributors, delivery drivers, and consumers. Customers set up flexible recurring deliveries or place one-time orders, manage balances digitally, and receive doorstep deliveries with automatic empty bottle return."
  },
  {
    question: "How does the prepaid digital jar wallet work?",
    answer: "Customers recharge their digital water jar wallet in advance using UPI, credit/debit cards, or net banking. Whenever a verified delivery partner completes a doorstep delivery and swaps an empty jar, the exact jar amount deducts automatically in real time. Customers receive an instant digital receipt without paper invoices or cash handling."
  },
  {
    question: "Can commercial businesses, offices, and cafes place bulk water orders?",
    answer: "Yes. eDrops features a dedicated commercial portal for offices, co-working spaces, restaurants, clinics, and manufacturing facilities. Businesses receive volume-discounted jar rates, customizable delivery schedules, monthly consolidated GST tax invoices, and dedicated account support."
  },
  {
    question: "How can I pause, skip, or modify my water subscription?",
    answer: "You have 24/7 self-service control via the eDrops web app or mobile portal. If you are traveling or on vacation, you can pause your subscription with one tap, skip an upcoming delivery, or adjust the number of jars required without penalty."
  },
  {
    question: "How are 20L water jars sanitized and handled?",
    answer: "All water jars distributed through eDrops are sourced directly from licensed, certified water bottling plants that follow strict BIS and FSSAI filtration and multi-stage sanitization protocols before being sealed and dispatched."
  },
  {
    question: "How do water plants and distributors use eDrops to manage their operations?",
    answer: "Water plants and distributors use eDrops's multi-tenant cloud software to manage delivery fleets, automate driver route sheets, track bottle inventory and shrinkage, collect prepaid customer payments, and analyze branch revenues."
  },
  {
    question: "What happens if a customer has a broken jar or an incorrect delivery count?",
    answer: "Delivery partners log jar conditions and counts upon doorstep dropoff. If there is a damaged bottle or count discrepancy, customers can instantly flag the drop in their portal for rapid customer support resolution and immediate wallet adjustments."
  },
  {
    question: "Is there a long-term contract or security deposit required?",
    answer: "No long-term contracts are required. Consumers and businesses can start with flexible jar packs and cancel, pause, or adjust anytime. Standard bottle deposit policies apply only to physical jars where required by the local distributor."
  }
];
---

<BaseLayout
  title="Frequently Asked Questions | eDrops™ — Water Delivery & Subscription Platform"
  description="Clear answers about eDrops 20L water jar delivery, prepaid wallet balances, recurring subscriptions, bulk corporate water, and distribution software."
  keywords="eDrops FAQ, 20L water jar delivery questions, water subscription software guide, prepaid water wallet FAQ, mineral water delivery India"
  faqItems={faqItems}
  breadcrumbs={breadcrumbs}
>
  <Navigation />

  <main id="main-content" class="pt-32 pb-24 px-5 max-w-4xl mx-auto min-h-screen">
    <!-- Breadcrumb visual navigation -->
    <nav aria-label="Breadcrumb" class="mb-8">
      <ol class="flex items-center space-x-2 text-xs font-semibold text-edrops-slate">
        <li><a href="/" class="hover:text-edrops-primary transition-colors">Home</a></li>
        <li class="text-edrops-muted">/</li>
        <li class="text-edrops-ocean font-bold" aria-current="page">FAQ</li>
      </ol>
    </nav>

    <div class="space-y-10">
      <header class="space-y-4">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-edrops-primary">Got Questions?</span>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-edrops-ocean tracking-tight">
          Frequently Asked Questions
        </h1>
        <p class="text-lg text-edrops-slate leading-relaxed">
          Everything you need to know about 20L drinking water subscriptions, prepaid wallet recharge, commercial bulk deliveries, and plant logistics.
        </p>
      </header>

      <div class="space-y-4 pt-2">
        {faqItems.map((item, idx) => (
          <details class="group rounded-2xl bg-white border border-edrops-border p-6 shadow-xs hover:border-edrops-primary/40 transition-all duration-200" open={idx === 0}>
            <summary class="flex justify-between items-center cursor-pointer list-none select-none gap-4">
              <h2 class="text-lg sm:text-xl font-bold text-edrops-ocean tracking-tight">
                {item.question}
              </h2>
              <span class="w-8 h-8 rounded-full bg-edrops-light text-edrops-primary flex items-center justify-center shrink-0 transition-transform duration-300 group-open:rotate-180">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <p class="mt-4 text-sm sm:text-base text-edrops-slate leading-relaxed pt-3 border-t border-edrops-border/40">
              {item.answer}
            </p>
          </details>
        ))}
      </div>

      <div class="p-8 rounded-2xl bg-edrops-light/60 border border-edrops-border text-center space-y-4">
        <h2 class="text-xl font-bold text-edrops-ocean">Still have questions?</h2>
        <p class="text-sm text-edrops-slate max-w-md mx-auto">
          Our team is available to assist you with doorstep deliveries, office plans, or onboarding your water plant.
        </p>
        <div class="flex items-center justify-center gap-4 pt-2">
          <a href="/contact/" class="inline-flex items-center justify-center rounded-full bg-edrops-primary text-white text-sm font-bold px-7 py-3 shadow-xs hover:bg-edrops-primary-hover transition-colors">
            Contact Support
          </a>
          <a href="tel:+917907805620" class="inline-flex items-center justify-center rounded-full bg-white text-edrops-ocean text-sm font-bold px-7 py-3 border border-edrops-border hover:bg-edrops-light transition-colors">
            +91 7907805620
          </a>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

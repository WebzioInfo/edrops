---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'FAQ', url: '/faq/' }
];

const faqItems = [
  {
    question: "Is eDrops a software or subscription service?",
    answer: "No. eDrops is a delivery app for purified 20L water jars. You order online and the jar is delivered to your doorstep. Bulk orders and memberships are available for homes and offices."
  },
  {
    question: "What is eDrops?",
    answer: "eDrops is a delivery app for purified 20L drinking water jars. Customers order online, get doorstep jar swap, track deliveries live, and access bulk ordering with membership benefits."
  },
  {
    question: "How do I order a 20L water jar?",
    answer: "Open eDrops at app.edrops.in, choose how many 20L purified water jars you need, select one-time order or repeat delivery, and pay securely online. Your jars are delivered to your doorstep on the scheduled date."
  },
  {
    question: "How does the jar swap work?",
    answer: "Our delivery partner brings full 20L jars to your door and takes the empty ones back. You don't need to carry or return anything yourself — the swap happens right at your doorstep during every delivery."
  },
  {
    question: "How does payment work?",
    answer: "You can pay securely online via UPI, debit/credit cards, and net banking, or top up your account balance for seamless, automated doorstep checkout."
  },
  {
    question: "Can I pause or reschedule repeat deliveries?",
    answer: "Yes. You can pause repeat deliveries during vacations, skip an upcoming delivery, change the number of jars, or reschedule a delivery date anytime from your eDrops dashboard."
  },
  {
    question: "Which areas do you deliver to?",
    answer: "eDrops currently delivers in Kondotty and Malappuram, Kerala. We are expanding to more areas. Check the app for delivery availability in your location."
  },
  {
    question: "What payment methods are accepted?",
    answer: "eDrops accepts UPI, credit cards, debit cards, and net banking for quick, cashless doorstep deliveries."
  },
  {
    question: "How do I track my order?",
    answer: "After placing an order, you can track its status live from your eDrops dashboard. You'll see when your jars are out for delivery and when they've been delivered."
  },
  {
    question: "Can homes and offices order in bulk or get membership benefits?",
    answer: "Yes. eDrops supports bulk orders and memberships for homes, offices, cafes, clinics, and shops, with priority scheduling and dedicated delivery management."
  }
];
---

<BaseLayout
  title="FAQ | Purified Water Jar Delivery – eDrops"
  description="Find answers to common questions about purified 20L water jar delivery, online ordering, jar swaps, and membership benefits with eDrops."
  keywords="eDrops FAQ, water jar delivery questions, 20L water order help, jar swap FAQ, purified water FAQ"
  faqItems={faqItems}
  breadcrumbs={breadcrumbs}
>
  <Navigation />

  <main id="main-content" class="pt-32 pb-24 px-5 max-w-4xl mx-auto min-h-screen">
    <!-- Breadcrumb visual navigation -->
    <nav aria-label="Breadcrumb" class="mb-8">
      <ol class="flex items-center space-x-2 text-xs font-semibold text-edrops-slate">
        <li><a href="/" class="hover:text-edrops-primary transition-colors">Home</a></li>
        <li class="text-edrops-muted">/</li>
        <li class="text-edrops-ocean font-bold" aria-current="page">FAQ</li>
      </ol>
    </nav>

    <div class="space-y-10">
      <header class="space-y-4">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-edrops-primary">Got Questions?</span>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-edrops-ocean tracking-tight">
          Frequently Asked Questions
        </h1>
        <p class="text-lg text-edrops-slate leading-relaxed">
          Everything you need to know about ordering 20L water jars, jar swaps, payments, and delivery.
        </p>
      </header>

      <div class="space-y-4 pt-2">
        {faqItems.map((item, idx) => (
          <details class="group rounded-2xl bg-white border border-edrops-border p-6 shadow-xs hover:border-edrops-primary/40 transition-all duration-200" open={idx === 0}>
            <summary class="flex justify-between items-center cursor-pointer list-none select-none gap-4">
              <h2 class="text-lg sm:text-xl font-bold text-edrops-ocean tracking-tight">
                {item.question}
              </h2>
              <span class="w-8 h-8 rounded-full bg-edrops-light text-edrops-primary flex items-center justify-center shrink-0 transition-transform duration-300 group-open:rotate-180">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <p class="mt-4 text-sm sm:text-base text-edrops-slate leading-relaxed pt-3 border-t border-edrops-border/40">
              {item.answer}
            </p>
          </details>
        ))}
      </div>

      <div class="p-8 rounded-2xl bg-edrops-light/60 border border-edrops-border text-center space-y-4">
        <h2 class="text-xl font-bold text-edrops-ocean">Still have questions?</h2>
        <p class="text-sm text-edrops-slate max-w-md mx-auto">
          Our team is here to help with orders, deliveries, or account questions.
        </p>
        <div class="flex items-center justify-center gap-4 pt-2">
          <a href="/contact/" class="inline-flex items-center justify-center rounded-full bg-edrops-primary text-white text-sm font-bold px-7 py-3 shadow-xs hover:bg-edrops-primary-hover transition-colors">
            Contact Support
          </a>
          <a href="tel:+917907805626" class="inline-flex items-center justify-center rounded-full bg-white text-edrops-ocean text-sm font-bold px-7 py-3 border border-edrops-border hover:bg-edrops-light transition-colors">
            +91 7907805626
          </a>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

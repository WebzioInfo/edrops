---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
---

<BaseLayout
  title="Features | Edrops"
  description="Learn more about features with Edrops."
>
  <Navigation />

  <main id="main-content" class="pt-32 pb-20 px-5 max-w-7xl mx-auto min-h-screen">
    <h1 class="text-5xl font-black text-edrops-ocean capitalize">features</h1>
    <p class="mt-6 text-lg text-edrops-ocean/68 max-w-2xl">
      This is the highly optimized SEO landing page for features. Edrops provides the ultimate water jar subscription management platform.
    </p>
  </main>
</BaseLayout>

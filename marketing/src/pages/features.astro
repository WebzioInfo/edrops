---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Features', url: '/features/' }
];

const featureList = [
  {
    title: 'Flexible subscriptions',
    href: '/features/subscription-management/',
    description: 'Set your own delivery schedule — weekly, every few days, or custom. Pause, skip, or change jar quantities whenever you need to.'
  },
  {
    title: 'Prepaid wallet',
    href: '/features/recharge-management/',
    description: 'Top up your eDrops wallet via UPI or card. Each delivery deducts automatically. No cash at the door, no payment chasing.'
  },
  {
    title: 'Doorstep delivery & jar swap',
    href: '/features/delivery-management/',
    description: 'Our delivery partner brings full jars and takes the empties. Every delivery is tracked and confirmed in real time.'
  },
  {
    title: 'Live order tracking',
    href: '/features/staff-management/',
    description: 'See when your jars are out for delivery, get notified on arrival, and check delivery history from your dashboard.'
  },
  {
    title: 'Customer dashboard',
    href: '/features/customer-management/',
    description: 'Manage your subscription, check wallet balance, view delivery history, download receipts, and adjust orders — all self-service.'
  },
  {
    title: 'Delivery reports & history',
    href: '/features/analytics/',
    description: 'See your past deliveries, jar counts, wallet transactions, and monthly usage at a glance.'
  }
];
---

<BaseLayout
  title="Features – 20L Water Jar Delivery – eDrops"
  description="Explore eDrops features: subscriptions, prepaid wallet, doorstep jar swap, live order tracking, and a self-service customer dashboard."
  keywords="eDrops features, water jar delivery app features, water subscription, prepaid water wallet, doorstep jar swap"
  breadcrumbs={breadcrumbs}
>
  <Navigation />

  <main id="main-content" class="pt-32 pb-24 px-5 max-w-6xl mx-auto min-h-screen">
    <!-- Breadcrumb visual navigation -->
    <nav aria-label="Breadcrumb" class="mb-8">
      <ol class="flex items-center space-x-2 text-xs font-semibold text-edrops-slate">
        <li><a href="/" class="hover:text-edrops-primary transition-colors">Home</a></li>
        <li class="text-edrops-muted">/</li>
        <li class="text-edrops-ocean font-bold" aria-current="page">Features</li>
      </ol>
    </nav>

    <div class="space-y-12">
      <header class="max-w-3xl space-y-4">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-edrops-primary">What you get</span>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-edrops-ocean tracking-tight">
          Everything you need to order water jars
        </h1>
        <p class="text-lg text-edrops-slate leading-relaxed">
          eDrops gives you a simple way to order 20L water jars online, manage subscriptions, and track every delivery — all from one app.
        </p>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 pt-4">
        {featureList.map((feature) => (
          <article class="p-8 rounded-2xl bg-white border border-edrops-border shadow-xs hover:border-edrops-primary/40 hover:shadow-md transition-all flex flex-col justify-between">
            <div class="space-y-3">
              <h2 class="text-xl font-bold text-edrops-ocean">
                <a href={feature.href} class="hover:text-edrops-primary transition-colors">
                  {feature.title}
                </a>
              </h2>
              <p class="text-sm text-edrops-slate leading-relaxed">
                {feature.description}
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-edrops-border/40">
              <a href={feature.href} class="text-xs font-bold text-edrops-primary hover:underline inline-flex items-center gap-1">
                Learn more <span>→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </main>
</BaseLayout>

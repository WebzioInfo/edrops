---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
---

<BaseLayout
  title="Features & Capabilities | Edrops — Water Delivery Platform"
  description="Discover the core capabilities of Edrops: recurring subscription management, prepaid jar wallets, live driver dispatch, automated invoicing, and analytics."
  keywords="Edrops features, water delivery app features, water jar subscription management tools"
>
  <Navigation />

  <main id="main-content" class="pt-32 pb-20 px-5 max-w-7xl mx-auto min-h-screen">
    <div class="max-w-4xl space-y-8">
      <h1 class="text-4xl sm:text-5xl font-extrabold text-edrops-ocean tracking-tight">Platform Features</h1>
      <p class="text-lg text-edrops-slate leading-relaxed">
        Edrops combines customer subscription convenience with powerful water distribution logistics:
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4">
        <div class="p-6 rounded-2xl bg-white border border-edrops-border shadow-xs space-y-2">
          <h3 class="text-xl font-bold text-edrops-ocean">Prepaid Wallets</h3>
          <p class="text-sm text-edrops-slate leading-relaxed">Automate jar deductions on delivery with real-time balance tracking and zero payment chasing.</p>
        </div>
        <div class="p-6 rounded-2xl bg-white border border-edrops-border shadow-xs space-y-2">
          <h3 class="text-xl font-bold text-edrops-ocean">Route Optimization</h3>
          <p class="text-sm text-edrops-slate leading-relaxed">Dispatch delivery routes with live location tracking, doorstep swaps, and bottle inventory reconciliation.</p>
        </div>
        <div class="p-6 rounded-2xl bg-white border border-edrops-border shadow-xs space-y-2">
          <h3 class="text-xl font-bold text-edrops-ocean">Subscription Intelligence</h3>
          <p class="text-sm text-edrops-slate leading-relaxed">Flexible recurring delivery schedules allowing customers to pause, skip, or modify orders 24/7.</p>
        </div>
        <div class="p-6 rounded-2xl bg-white border border-edrops-border shadow-xs space-y-2">
          <h3 class="text-xl font-bold text-edrops-ocean">Operational Reports</h3>
          <p class="text-sm text-edrops-slate leading-relaxed">Monitor delivery fulfillment rates, customer retention, recharge revenue, and empty jar returns.</p>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

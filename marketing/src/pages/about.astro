---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
---

<BaseLayout
  title="About Edrops — Modern Water Jar Delivery Platform"
  description="Learn about Edrops, the dedicated operating system built to automate 20L water jar subscriptions, prepaid digital wallets, and route dispatch."
  keywords="About Edrops, water delivery company, water subscription platform story"
>
  <Navigation />

  <main id="main-content" class="pt-32 pb-20 px-5 max-w-7xl mx-auto min-h-screen">
    <div class="max-w-3xl space-y-6">
      <h1 class="text-4xl sm:text-5xl font-extrabold text-edrops-ocean tracking-tight">About Edrops</h1>
      <p class="text-lg text-edrops-slate leading-relaxed">
        Edrops was founded to eliminate the friction of notebook-managed water deliveries. We provide a calm, unified platform connecting water plants, distributors, delivery drivers, and customers.
      </p>
      <p class="text-base text-edrops-slate leading-relaxed">
        With automated recurring schedules, prepaid recharge balances, and real-time route execution, Edrops empowers 20L water operations to scale smoothly while giving customers transparent, dependable doorstep delivery.
      </p>
    </div>
  </main>
</BaseLayout>

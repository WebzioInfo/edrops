---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'About', url: '/about/' }
];
---

<BaseLayout
  title="About Us | 20L Water Jar Delivery – eDrops"
  description="About eDrops: your trusted app for purified 20L water jar delivery. Reliable doorstep service, seamless jar swap, and local drinking water access."
  keywords="about eDrops, water jar delivery company, 20L water delivery app, eDrops story"
  breadcrumbs={breadcrumbs}
>
  <Navigation />

  <main id="main-content" class="pt-32 pb-24 px-5 max-w-4xl mx-auto min-h-screen">
    <!-- Breadcrumb visual navigation -->
    <nav aria-label="Breadcrumb" class="mb-8">
      <ol class="flex items-center space-x-2 text-xs font-semibold text-edrops-slate">
        <li><a href="/" class="hover:text-edrops-primary transition-colors">Home</a></li>
        <li class="text-edrops-muted">/</li>
        <li class="text-edrops-ocean font-bold" aria-current="page">About</li>
      </ol>
    </nav>

    <div class="space-y-8">
      <header class="space-y-4">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-edrops-primary">Our Mission</span>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-edrops-ocean tracking-tight">
          About eDrops
        </h1>
        <p class="text-xl text-edrops-slate leading-relaxed font-normal">
          eDrops (edrops.in) is a delivery app for purified 20L water jars serving Kondotty and Malappuram, Kerala.
        </p>
      </header>

      <div class="space-y-6 text-base sm:text-lg text-edrops-ocean/80 leading-relaxed pt-2">
        <p>
          eDrops was built to solve an everyday problem: getting pure, reliable drinking water jars delivered to your home or office should be effortless and completely transparent.
        </p>
        <p>
          With eDrops, customers order jars online, set up scheduled repeat deliveries, top up their account balance, and enjoy contactless doorstep jar swaps. Every delivery is tracked live, payments are completely digital, and you remain in control of your delivery schedule.
        </p>
        <p>
          Currently delivering in Kondotty and Malappuram, Kerala, eDrops supports both individual homes and bulk requirements for workplaces, clinics, cafes, and shops with dedicated membership benefits.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-6">
        <div class="p-6 rounded-2xl bg-white border border-edrops-border shadow-xs text-center space-y-2">
          <p class="text-3xl font-extrabold text-edrops-primary" aria-hidden="true">💳</p>
          <p class="text-xs font-bold uppercase tracking-wider text-edrops-slate">Cashless delivery</p>
        </div>
        <div class="p-6 rounded-2xl bg-white border border-edrops-border shadow-xs text-center space-y-2">
          <p class="text-3xl font-extrabold text-edrops-primary" aria-hidden="true">📱</p>
          <p class="text-xs font-bold uppercase tracking-wider text-edrops-slate">Fully digital ordering</p>
        </div>
        <div class="p-6 rounded-2xl bg-white border border-edrops-border shadow-xs text-center space-y-2">
          <p class="text-3xl font-extrabold text-edrops-primary" aria-hidden="true">🔄</p>
          <p class="text-xs font-bold uppercase tracking-wider text-edrops-slate">Doorstep jar swap</p>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

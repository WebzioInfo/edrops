---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'How It Works', url: '/how-it-works/' }
];

const howToSteps = [
  {
    name: 'Order online in seconds',
    text: 'Open eDrops, choose how many purified 20L water jars you need, and pick one-time order or repeat delivery with no lock-in.',
    url: '/how-it-works/#step-1'
  },
  {
    name: 'Pay securely online',
    text: 'Complete checkout using UPI, cards, net banking, or your account wallet for cashless, effortless deliveries.',
    url: '/how-it-works/#step-2'
  },
  {
    name: 'Doorstep jar swap',
    text: 'Our delivery partner brings full 20L jars to your door and swaps out the empties. Every delivery is tracked live and confirmed automatically.',
    url: '/how-it-works/#step-3'
  },
  {
    name: 'Manage repeat orders anytime',
    text: 'Pause during vacations, change jar quantities, skip a delivery, or reschedule — all from your phone with no phone calls needed.',
    url: '/how-it-works/#step-4'
  }
];

const howToData = {
  title: 'How to Order 20L Water Jars with eDrops',
  description: 'A step-by-step guide to ordering purified 20L water jars online: select your jars, pay securely, and get doorstep delivery with jar swap.',
  steps: howToSteps
};
---

<BaseLayout
  title="How It Works | 20L Water Jar Delivery – eDrops"
  description="Learn how to order purified 20L water jars online with eDrops. Doorstep delivery, easy jar swap, and live order tracking for homes and offices."
  keywords="how eDrops works, order water jar online, 20L water delivery steps, purified water delivery, doorstep water delivery"
  breadcrumbs={breadcrumbs}
  howToData={howToData}
>
  <Navigation />

  <main id="main-content" class="pt-32 pb-24 px-5 max-w-5xl mx-auto min-h-screen">
    <!-- Breadcrumb visual navigation -->
    <nav aria-label="Breadcrumb" class="mb-8">
      <ol class="flex items-center space-x-2 text-xs font-semibold text-edrops-slate">
        <li><a href="/" class="hover:text-edrops-primary transition-colors">Home</a></li>
        <li class="text-edrops-muted">/</li>
        <li class="text-edrops-ocean font-bold" aria-current="page">How It Works</li>
      </ol>
    </nav>

    <div class="space-y-12">
      <header class="space-y-4 max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-edrops-primary">Simple ordering</span>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-edrops-ocean tracking-tight">
          How to order 20L water jars with eDrops
        </h1>
        <p class="text-lg text-edrops-slate leading-relaxed">
          No phone calls, no waiting. Order water jars online in a few taps and get reliable doorstep delivery.
        </p>
      </header>

      <ol class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 list-none p-0 m-0">
        {howToSteps.map((step, idx) => (
          <li id={`step-${idx + 1}`} class="p-8 rounded-2xl bg-white border border-edrops-border shadow-xs hover:border-edrops-primary/40 hover:shadow-md transition-all flex flex-col justify-between">
            <div>
              <span class="text-4xl font-extrabold text-edrops-primary/20 block mb-4" aria-hidden="true">
                0{idx + 1}
              </span>
              <h2 class="text-xl font-bold text-edrops-ocean mb-3">
                {step.name}
              </h2>
              <p class="text-sm sm:text-base text-edrops-slate leading-relaxed">
                {step.text}
              </p>
            </div>
          </li>
        ))}
      </ol>

      <div class="p-8 rounded-2xl bg-gradient-to-r from-edrops-light to-white border border-edrops-border text-center space-y-4">
        <h2 class="text-2xl font-bold text-edrops-ocean">Ready to order your water jars?</h2>
        <p class="text-sm text-edrops-slate max-w-lg mx-auto">
          Start ordering purified 20L water jars with doorstep jar swap convenience today.
        </p>
        <div class="pt-2">
          <a href="https://app.edrops.in" class="inline-flex items-center justify-center rounded-full bg-edrops-secondary text-white text-sm font-bold px-8 py-3.5 shadow-md hover:bg-edrops-secondary-hover transition-colors">
            Order Now on eDrops
          </a>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

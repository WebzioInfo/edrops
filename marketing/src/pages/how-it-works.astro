---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
---

<BaseLayout
  title="How It Works | Edrops — 20L Water Jar Subscriptions"
  description="Learn how Edrops delivers 20L drinking water jars: choose recurring subscriptions or one-time orders, get doorstep drops, and manage balances online."
  keywords="How Edrops works, water jar delivery process, 20L water subscription steps"
>
  <Navigation />

  <main id="main-content" class="pt-32 pb-20 px-5 max-w-7xl mx-auto min-h-screen">
    <div class="max-w-3xl space-y-6">
      <h1 class="text-4xl sm:text-5xl font-extrabold text-edrops-ocean tracking-tight">How Edrops Works</h1>
      <p class="text-lg text-edrops-slate leading-relaxed">
        We make drinking water delivery simple, predictable, and stress-free for both households and businesses:
      </p>
      <div class="space-y-4 pt-4">
        <div class="p-6 rounded-2xl bg-white border border-edrops-border space-y-2">
          <h3 class="text-xl font-bold text-edrops-ocean">1. Choose Your Plan</h3>
          <p class="text-sm text-edrops-slate leading-relaxed">Select weekly or customized recurring deliveries, or place quick one-time orders whenever you need extra jars.</p>
        </div>
        <div class="p-6 rounded-2xl bg-white border border-edrops-border space-y-2">
          <h3 class="text-xl font-bold text-edrops-ocean">2. Dependable Doorstep Delivery</h3>
          <p class="text-sm text-edrops-slate leading-relaxed">Our verified delivery partners bring full sanitized jars directly to your doorstep and collect empty jars with zero lifting hassle.</p>
        </div>
        <div class="p-6 rounded-2xl bg-white border border-edrops-border space-y-2">
          <h3 class="text-xl font-bold text-edrops-ocean">3. Complete Online Control</h3>
          <p class="text-sm text-edrops-slate leading-relaxed">Recharge prepaid balance, pause during trips, or change delivery slots in one tap from your phone.</p>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

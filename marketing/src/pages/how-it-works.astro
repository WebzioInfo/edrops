---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'How It Works', url: '/how-it-works/' }
];

const howToSteps = [
  {
    name: 'Choose Your Plan or Order Type',
    text: 'Select flexible weekly recurring delivery schedules or place an instant on-demand jar order through the eDrops platform without long contracts.',
    url: '/how-it-works/#step-1'
  },
  {
    name: 'Top Up Digital Jar Wallet',
    text: 'Recharge your prepaid water jar balance securely via UPI, cards, or net banking. Enjoy automatic volume discounts on bulk packs.',
    url: '/how-it-works/#step-2'
  },
  {
    name: 'Dependable Doorstep Delivery & Jar Swap',
    text: 'Our verified delivery partners arrive at your scheduled slot, swap sanitized full 20L jars for empty bottles, and automatically log the drop with zero paperwork.',
    url: '/how-it-works/#step-3'
  },
  {
    name: 'Manage & Track 24/7',
    text: 'Pause during vacations, change bottle quantities, check remaining wallet balance, and download monthly statements directly from your smartphone.',
    url: '/how-it-works/#step-4'
  }
];

const howToData = {
  title: 'How to Order & Subscribe to 20L Water Jars with eDrops',
  description: 'A step-by-step walkthrough on subscribing, prepaid digital wallet recharging, and receiving dependable doorstep 20L drinking water delivery.',
  steps: howToSteps
};
---

<BaseLayout
  title="How It Works | eDrops™ — 20L Water Jar Subscriptions & Doorstep Delivery"
  description="Discover how eDrops automates 20L drinking water delivery: set up recurring subscriptions, top up prepaid digital wallets, and enjoy reliable doorstep jar swaps."
  keywords="How eDrops works, water jar delivery process, 20L water subscription steps, prepaid water delivery app, doorstep water delivery"
  breadcrumbs={breadcrumbs}
  howToData={howToData}
>
  <Navigation />

  <main id="main-content" class="pt-32 pb-24 px-5 max-w-5xl mx-auto min-h-screen">
    <!-- Breadcrumb visual navigation -->
    <nav aria-label="Breadcrumb" class="mb-8">
      <ol class="flex items-center space-x-2 text-xs font-semibold text-edrops-slate">
        <li><a href="/" class="hover:text-edrops-primary transition-colors">Home</a></li>
        <li class="text-edrops-muted">/</li>
        <li class="text-edrops-ocean font-bold" aria-current="page">How It Works</li>
      </ol>
    </nav>

    <div class="space-y-12">
      <header class="space-y-4 max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-edrops-primary">Process & Logistics</span>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-edrops-ocean tracking-tight">
          How eDrops Works
        </h1>
        <p class="text-lg text-edrops-slate leading-relaxed">
          We engineered eDrops to replace chaotic phone calls and lost paper cards with an automated, stress-free water subscription platform.
        </p>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4">
        {howToSteps.map((step, idx) => (
          <div id={`step-${idx + 1}`} class="p-8 rounded-2xl bg-white border border-edrops-border shadow-xs hover:border-edrops-primary/40 hover:shadow-md transition-all flex flex-col justify-between">
            <div>
              <span class="text-4xl font-extrabold text-edrops-primary/20 block mb-4">
                0{idx + 1}
              </span>
              <h2 class="text-xl font-bold text-edrops-ocean mb-3">
                {step.name}
              </h2>
              <p class="text-sm sm:text-base text-edrops-slate leading-relaxed">
                {step.text}
              </p>
            </div>
          </div>
        ))}
      </div>

      <div class="p-8 rounded-2xl bg-gradient-to-r from-edrops-light to-white border border-edrops-border text-center space-y-4">
        <h2 class="text-2xl font-bold text-edrops-ocean">Ready to streamline your drinking water?</h2>
        <p class="text-sm text-edrops-slate max-w-lg mx-auto">
          Start ordering 20L water jars with automated prepaid convenience today.
        </p>
        <div class="pt-2">
          <a href="https://app.edrops.in" class="inline-flex items-center justify-center rounded-full bg-edrops-secondary text-white text-sm font-bold px-8 py-3.5 shadow-md hover:bg-edrops-secondary-hover transition-colors">
            Get Started with eDrops
          </a>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

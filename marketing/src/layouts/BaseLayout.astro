---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description: string;
  keywords?: string;
  image?: string;
  canonicalURL?: string;
  hideFooter?: boolean;
  faqItems?: Array<{ question: string; answer: string }>;
}

const {
  title,
  description,
  keywords,
  image = '/og-image.jpg',
  canonicalURL,
  hideFooter = false,
  faqItems = []
} = Astro.props;

const currentCanonical = canonicalURL || (Astro.site ? new URL(Astro.url.pathname, Astro.site).href : `https://edrops.in${Astro.url.pathname}`);
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Favicon & PWA Icons (Google & Modern Browser Compliant) -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0e7490" />
    
    <!-- Complete On-page & Technical SEO -->
    <SEO 
      title={title} 
      description={description} 
      keywords={keywords}
      image={image} 
      canonicalURL={currentCanonical}
      faqItems={faqItems}
    />
    
    <!-- Fonts Preconnect & Optimized Loading -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="font-sans antialiased overflow-x-hidden selection:bg-edrops-primary/20 selection:text-edrops-ocean">
    <slot />
    {!hideFooter && <Footer />}
  </body>
</html>

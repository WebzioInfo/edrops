generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String               @id @default(uuid())
  email                String?              @unique
  passwordHash         String
  role                 UserRole             @default(CUSTOMER)
  permissions          String[]             @default([])
  firstName            String
  lastName             String
  phone                String               @unique
  alternatePhone       String?
  avatarUrl            String?
  gender               String?
  dateOfBirth          DateTime?            @db.Date
  phoneVerified        Boolean              @default(false)
  phoneVerifiedAt      DateTime?
  isActive             Boolean              @default(true)
  accountStatus        AccountStatus        @default(ACTIVE)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  passwordSetupTokens  PasswordSetupToken[]
  admin                Admin?
  auditLogs            AuditLog[]
  customer             Customer?
  deliveryPartner      DeliveryPartner?
  distributor          Distributor?
  notifications        Notification[]
  staff                Staff?
  createdDistributors  Distributor[]        @relation("DistributorCreator")
  supportActivities    SupportActivityLog[]
  supportMessages      SupportMessage[]
  assignedTickets      SupportTicket[]      @relation("TicketAssignee")
  ticketReplies        TicketReply[]
  statusUpdates        OrderStatusHistory[]
  verifiedOrderItems   OrderItem[]          @relation("VerifiedOrderItems")
  purchases            Purchase[]           @relation("DistributorPurchases")
  suppliers            Supplier[]           @relation("DistributorSuppliers")
  drivers              Driver[]             @relation("DistributorDrivers")
  distributorOrders    Order[]              @relation("DistributorOrders")
  acceptedOrders       Order[]              @relation("AcceptedOrders")
  cancelledOrders      Order[]              @relation("CancelledOrders")
  distributorAssignments DistributorOrderAssignment[] @relation("DistributorAssignments")
  distributorOrderSkips DistributorOrderSkip[] @relation("DistributorOrderSkips")
  distributorPincodes   DistributorPincode[]   @relation("DistributorPincodes")
  verifiedDeliveries    OrderDeliveryVerification[] @relation("VerifiedDeliveries")
  pushSubscriptions     PushSubscription[]
  createdInventoryLogs  InventoryLog[]         @relation("InventoryLogCreator")
  profileUpdateVerifications ProfileUpdateVerification[]
  rawMaterialMovementsCreated RawMaterialMovement[] @relation("RawMaterialMovementCreator")
  productionBatchesCreated    DistributorProductionBatch[] @relation("ProductionBatchCreator")
  jarSettlementsCreated       DistributorJarSettlement[] @relation("JarSettlementCreator")

  @@index([email])
  @@index([phone])
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  permissions Permission[]
}

model Permission {
  id       String           @id @default(uuid())
  roleId   String
  resource String
  action   PermissionAction
  role     Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
}

model Customer {
  id                  String               @id @default(uuid())
  userId              String               @unique
  referralCode        String?              @unique
  referredById        String?
  isWalkIn            Boolean              @default(false)
  
  customerType        String?              @default("RESIDENTIAL")
  gstNumber           String?              @unique
  companyName         String?
  contactPerson       String?
  businessCategory    String?
  
  createdById         String?
  updatedById         String?
  branchId            String?
  tenantId            String?
  source              String?
  createdFrom         String?

  jarsAtCustomer      Int                  @default(0) @map("jars_at_customer")

  addresses           Address[]
  cart                Cart?
  forecast            ConsumptionForecast?
  referredBy          Customer?            @relation("ReferralRelation", fields: [referredById], references: [id])
  referrals           Customer[]           @relation("ReferralRelation")
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  healthMetrics       CustomerHealth?
  deliveries          Delivery[]
  deliverySchedule    DeliverySchedule?
  depositTransactions DepositTransaction[]
  invoices            InvoiceRecord[]
  jarBalances         JarBalance[]
  jarDeposits         JarDeposit[]
  jarLedgers          JarLedger[]
  jarOwnerships       JarOwnership[]
  orders              Order[]
  inventoryLogs       InventoryLog[]
  packagePurchases    PackagePurchase[]
  payments            Payment[]
  promoRedemptions    PromoRedemption[]
  rewardsReceived     ReferralReward[]     @relation("ReferralRewardReceiver")
  rewardsGiven        ReferralReward[]     @relation("ReferralRewardProvider")
  supportTickets      SupportTicket[]
  transactions        Transaction[]
  wallet              Wallet?

  @@index([userId])
}

model Staff {
  id               String           @id @default(uuid())
  userId           String           @unique
  branchId         String?
  vehicleType      String?
  vehiclePlate     String?
  confirmedReports DeliveryReport[]
  branch           Branch?          @relation(fields: [branchId], references: [id])
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DeliveryPartner {
  id           String               @id @default(uuid())
  userId       String               @unique
  vehicleType  String?
  vehiclePlate String?
  jarUnitPrice Decimal              @default(0.00) @db.Decimal(10, 2)
  assignments  DeliveryAssignment[]
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Distributor {
  id                   String   @id @default(uuid())
  userId               String   @unique
  referralCode         String   @unique
  agencyName           String?
  address              String?
  routeOrArea          String?
  vehicleType          String?
  vehiclePlate         String?
  jarOwnership         String?  @default("COMPANY_OWNED")
  companyOwnedJars     Int      @default(0)
  distributorOwnedJars Int      @default(0)
  canManufacture       Boolean  @default(false)
  jarDepositRate       Float    @default(150.0)
  inventoryLogs       InventoryLog[]
  jarImageUrl         String?
  createdById          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  jarItems            JarInventoryItem[]
  rawMaterialStocks   DistributorRawMaterialStock[]
  rawMaterialMovements RawMaterialMovement[]
  productionBatches   DistributorProductionBatch[]
  settlements         DistributorJarSettlement[]
  distributorSales       DistributorSale[]
  ownershipLedgerEntries DistributorOwnershipLedger[]
  accessoryStocks        DistributorAccessoryStock[]
  expenses               DistributorExpense[]

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdBy            User?    @relation("DistributorCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([referralCode])
  @@index([userId])
}

model Admin {
  id     String @id @default(uuid())
  userId String @unique
  level  Int    @default(1)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Branch {
  id          String  @id @default(uuid())
  name        String
  location    String
  contactInfo String?
  staff       Staff[]
}

model Address {
  id           String     @id @default(uuid())
  customerId   String
  label        String?
  street       String
  city         String
  state        String
  zipCode      String
  country      String     @default("India")
  isDefault    Boolean    @default(false)
  latitude     Float?
  longitude    Float?
  area         String?
  buildingName String?
  fullName     String?
  houseName    String?
  landmark     String?
  mobileNumber String?
  district     String?
  googleMapsUrl String?
  addressNotes String?
  customer     Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deliveries   Delivery[]
  orders       Order[]
}

model Package {
  id              String            @id @default(uuid())
  name            String
  description     String?
  jarCount        Int
  price           Float
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  discountPercent Float?
  displayOrder    Int               @default(0)
  endDate         DateTime?
  offerLabel      String?
  originalPrice   Float?
  packageBadge    String?
  packageColor    String?
  startDate       DateTime?
  purchases       PackagePurchase[]
  planConfig      SubscriptionPlanConfig?

  @@index([isActive])
}

model PackagePurchase {
  id            String        @id @default(uuid())
  customerId    String
  packageId     String
  amount        Float
  paymentStatus PaymentStatus @default(PENDING)
  paymentId     String?       @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  package       Package       @relation(fields: [packageId], references: [id])

  @@index([customerId])
  @@index([paymentStatus])
}

model DeliverySchedule {
  id         String                 @id @default(uuid())
  customerId String                 @unique
  isActive   Boolean                @default(true)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  customer   Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rules      DeliveryScheduleRule[]

  @@index([customerId])
}

model DeliveryScheduleRule {
  id                 String           @id @default(uuid())
  deliveryScheduleId String
  type               String
  dayOfWeek          Int?
  quantity           Int
  intervalDays       Int?
  startDate          DateTime         @default(now())
  customNotes        String?
  deliverySchedule   DeliverySchedule @relation(fields: [deliveryScheduleId], references: [id], onDelete: Cascade)
}

model Delivery {
  id               String              @id @default(uuid())
  customerId       String
  addressId        String
  scheduledFor     DateTime            @db.Date
  requiredQuantity Int
  status           OrderStatus         @default(PENDING_ASSIGNMENT)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  cancelledAt      DateTime?
  completedAt      DateTime?
  timeSlot         String?
  address          Address             @relation(fields: [addressId], references: [id])
  customer         Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignment       DeliveryAssignment?
  report           DeliveryReport?
  orderId          String?             @unique
  order            Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([customerId, scheduledFor])
  @@index([status])
}

model DeliveryAssignment {
  id                String          @id @default(uuid())
  deliveryId        String          @unique
  deliveryPartnerId String
  assignedAt        DateTime        @default(now())
  rateSnapshot      Decimal?        @db.Decimal(10, 2)
  delivery          Delivery        @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  deliveryPartner   DeliveryPartner @relation(fields: [deliveryPartnerId], references: [id])
}

model DeliveryReport {
  id                      String    @id @default(uuid())
  deliveryId              String    @unique
  partnerDeliveredQty     Int
  partnerEmptyCollected   Int
  partnerNotes            String?
  partnerSubmittedAt      DateTime  @default(now())
  confirmedDeliveredQty   Int?
  confirmedEmptyCollected Int?
  confirmedDamagedQty     Int?      @default(0)
  staffNotes              String?
  confirmedAt             DateTime?
  confirmedById           String?
  confirmedBy             Staff?    @relation(fields: [confirmedById], references: [id])
  delivery                Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  collectedJars           DeliveryCollectedJar[]
}

model JarBalance {
  id             String   @id @default(uuid())
  customerId     String
  brandId        String
  availableJars  Int      @default(0)
  totalPurchased Int      @default(0)
  updatedAt      DateTime @updatedAt
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  brand          Brand    @relation(fields: [brandId], references: [id])

  @@unique([customerId, brandId])
}

model JarDeposit {
  id            String   @id @default(uuid())
  customerId    String
  brandId       String
  maxActiveJars Int      @default(0)
  depositPaid   Float    @default(0.0)
  depositDue    Float    @default(0.0)
  updatedAt     DateTime @updatedAt
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  brand         Brand    @relation(fields: [brandId], references: [id])

  @@unique([customerId, brandId])
}

model JarOwnership {
  id              String   @id @default(uuid())
  customerId      String
  brandId         String
  companyJarsHeld Int      @default(0)
  ownedJars       Int      @default(0)
  updatedAt       DateTime @updatedAt
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  brand           Brand    @relation(fields: [brandId], references: [id])

  @@unique([customerId, brandId])
}

model Transaction {
  id            String          @id @default(uuid())
  customerId    String
  type          TransactionType
  amountJars    Int             @default(0)
  amountMoney   Float           @default(0.0)
  balanceBefore Int
  balanceAfter  Int
  referenceId   String?
  description   String?
  createdAt     DateTime        @default(now())
  customer      Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([type])
}

model Notification {
  id          String             @id @default(uuid())
  userId      String
  type        NotificationType
  title       String
  message     String
  status      NotificationStatus @default(UNREAD)
  link        String?
  orderId     String?
  orderNumber String?
  metadata    Json?
  eventKey    String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @default(now()) @updatedAt
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, eventKey])
  @@index([userId])
  @@index([userId, status])
  @@index([orderId])
  @@index([createdAt])
}

model PushSubscription {
  id         String    @id @default(uuid())
  userId     String
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  device     String?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastUsedAt DateTime?

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isActive])
  @@index([endpoint])
  @@map("push_subscriptions")
}

model Settings {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
}

model Report {
  id          String   @id @default(uuid())
  name        String
  type        String
  dateRange   String?
  data        Json
  generatedAt DateTime @default(now())
}

model AnalyticsSnapshot {
  id                 String   @id @default(uuid())
  date               DateTime @unique @db.Date
  totalCustomers     Int
  totalJarsDelivered Int
  totalRevenue       Float
  createdAt          DateTime @default(now())
  activeSchedules    Int      @default(0)
}

model Wallet {
  id           String              @id @default(uuid())
  customerId   String              @unique
  balance      Float               @default(0.0)
  currency     String              @default("INR")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  customer     Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id            String                @id @default(uuid())
  walletId      String
  type          WalletTransactionType
  amount        Float
  balanceBefore Float
  balanceAfter  Float
  referenceId   String?
  description   String?
  createdAt     DateTime              @default(now())
  wallet        Wallet                @relation(fields: [walletId], references: [id], onDelete: Cascade)
}

model Payment {
  id          String            @id @default(uuid())
  customerId  String
  amount      Float
  currency    String            @default("INR")
  status      PaymentStatus     @default(PENDING)
  provider    String            @default("RAZORPAY")
  providerId  String?
  receiptId   String?
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  orderId     String?
  customer    Customer          @relation(fields: [customerId], references: [id])
  order       Order?            @relation(fields: [orderId], references: [id])
  attempts    PaymentAttempt[]
  auditLogs   PaymentAuditLog[]
  logs        PaymentLog[]
  refunds     PaymentRefund[]
}

model PaymentLog {
  id        String   @id @default(uuid())
  paymentId String
  status    String
  payload   Json?
  createdAt DateTime @default(now())
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model PaymentAttempt {
  id           String   @id @default(uuid())
  paymentId    String
  providerId   String?
  status       String
  errorMessage String?
  errorCode    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  payment      Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model PaymentRefund {
  id              String   @id @default(uuid())
  paymentId       String
  providerId      String?
  amount          Float
  status          String
  reason          String?
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model PaymentWebhookLog {
  id           String    @id @default(uuid())
  provider     String    @default("RAZORPAY")
  eventId      String    @unique
  eventType    String
  payload      Json
  status       String    @default("PENDING")
  errorMessage String?
  createdAt    DateTime  @default(now())
  headers      Json?
  processedAt  DateTime?
  retryCount   Int       @default(0)
  signature    String?
  sourceIp     String?
}

model PaymentAuditLog {
  id             String   @id @default(uuid())
  paymentId      String
  action         String
  previousStatus String?
  newStatus      String
  notes          String?
  createdAt      DateTime @default(now())
  payment        Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model InvoiceRecord {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique
  customerId    String
  orderId       String?
  rechargeId    String?
  amount        Float
  tax           Float    @default(0.0)
  total         Float
  pdfUrl        String?
  createdAt     DateTime @default(now())
  customer      Customer @relation(fields: [customerId], references: [id])
}

model PromoCampaign {
  id          String      @id @default(uuid())
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  codes       PromoCode[]
}

model PromoCode {
  id                    String            @id @default(uuid())
  code                  String            @unique
  campaignId            String
  type                  PromoType
  discountValue         Float?
  bonusJars             Int?
  maxUses               Int?
  currentUses           Int               @default(0)
  isActive              Boolean           @default(true)
  createdAt             DateTime          @default(now())
  createdBy             String?
  description           String?
  endDate               DateTime?
  maximumDiscountAmount Float?
  minimumOrderAmount    Float             @default(0.0)
  perUserLimit          Int               @default(1)
  startDate             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  campaign              PromoCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  redemptions           PromoRedemption[]
}

model PromoRedemption {
  id          String    @id @default(uuid())
  promoCodeId String
  customerId  String
  redeemedAt  DateTime  @default(now())
  customer    Customer  @relation(fields: [customerId], references: [id])
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id])
}

model ReferralTier {
  id            String  @id @default(uuid())
  name          String
  requiredCount Int
  bonusJars     Int     @default(0)
  walletBonus   Float   @default(0.0)
  isActive      Boolean @default(true)
}

model ReferralReward {
  id          String   @id @default(uuid())
  referrerId  String
  refereeId   String
  rewardGiven Boolean  @default(false)
  jarsAdded   Int      @default(0)
  walletAdded Float    @default(0.0)
  createdAt   DateTime @default(now())
  referee     Customer @relation("ReferralRewardReceiver", fields: [refereeId], references: [id])
  referrer    Customer @relation("ReferralRewardProvider", fields: [referrerId], references: [id])
}

model SupportTicket {
  id           String               @id @default(uuid())
  customerId   String
  subject      String
  description  String
  status       TicketStatus         @default(OPEN)
  priority     TicketPriority       @default(MEDIUM)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  assignedToId String?
  category     String?
  imageUrl     String?
  invoiceUrl   String?
  activities   SupportActivityLog[]
  messages     SupportMessage[]
  assignedTo   User?                @relation("TicketAssignee", fields: [assignedToId], references: [id])
  customer     Customer             @relation(fields: [customerId], references: [id])
  replies      TicketReply[]
}

model TicketReply {
  id         String        @id @default(uuid())
  ticketId   String
  userId     String
  message    String
  isInternal Boolean       @default(false)
  createdAt  DateTime      @default(now())
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id])
}

model SupportMessage {
  id          String              @id @default(uuid())
  ticketId    String
  userId      String
  message     String
  isInternal  Boolean             @default(false)
  createdAt   DateTime            @default(now())
  attachments SupportAttachment[]
  ticket      SupportTicket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id])
}

model SupportAttachment {
  id        String         @id @default(uuid())
  messageId String
  fileUrl   String
  fileName  String
  fileType  String
  createdAt DateTime       @default(now())
  message   SupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model SupportActivityLog {
  id        String        @id @default(uuid())
  ticketId  String
  userId    String?
  action    String
  details   String?
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User?         @relation(fields: [userId], references: [id])
}

model CustomerHealth {
  id             String   @id @default(uuid())
  customerId     String   @unique
  healthScore    Int      @default(100)
  retentionRisk  String   @default("LOW")
  lastCalculated DateTime @default(now())
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model ConsumptionForecast {
  id                      String    @id @default(uuid())
  customerId              String    @unique
  avgJarsPerWeek          Float     @default(0.0)
  estimatedDepletionDate  DateTime?
  nextRecommendedRecharge DateTime?
  updatedAt               DateTime  @updatedAt
  customer                Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Inventory {
  id          String   @id @default(uuid())
  filledJars  Int      @default(0)
  emptyJars   Int      @default(0)
  damagedJars Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model InventoryLog {
  id          String   @id @default(uuid())
  sequence      Int @unique @default(autoincrement())
  distributorId String?
  ownership     String?
  jarItemId     String?
  quantity      Int?
  balanceAfter  Int?
  distributor   Distributor? @relation(fields: [distributorId], references: [id], onDelete: SetNull)
  jarItem       JarInventoryItem? @relation(fields: [jarItemId], references: [id], onDelete: SetNull)
  action      String
  filledQty   Int      @default(0)
  emptyQty    Int      @default(0)
  damagedQty  Int      @default(0)
  referenceId String?
  description String?
  fromState   String?
  toState     String?
  orderId     String?
  customerId  String?
  createdById String?
  order       Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customer    Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy   User?             @relation("InventoryLogCreator", fields: [createdById], references: [id], onDelete: SetNull)
  eventTimestamp DateTime? @default(now())
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([eventTimestamp])
  @@index([distributorId, ownership, sequence])
  @@index([jarItemId, sequence])
  @@index([orderId])
  @@index([customerId])
}

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  logoUrl     String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products      Product[]
  jarBalances   JarBalance[]
  jarDeposits            JarDeposit[]
  jarOwnerships          JarOwnership[]
  orderExpectedReturns   OrderExpectedReturn[]
  deliveryCollectedJars  DeliveryCollectedJar[]
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  imageUrl    String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id                         String                       @id @default(uuid())
  sku                        String?
  name                       String
  description                String?
  price                      Float
  brandId                    String
  categoryId                 String
  status                     ProductStatus                @default(ACTIVE)
  productType                String                       @default("WATER_PRODUCT")
  hsnCode                    String?
  gstRate                    Float                        @default(18.0)
  distributorPrice           Float?
  customerPrice              Float?
  costPrice                  Float?
  uom                        String                       @default("PCS")
  minStockLevel              Int                          @default(10)
  isJar                      Boolean                      @default(false)
  depositAmount              Float                        @default(0.0)
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  cartItems                  CartItem[]
  orderItems                 OrderItem[]
  brand                      Brand                        @relation(fields: [brandId], references: [id])
  category                   Category                     @relation(fields: [categoryId], references: [id])
  images                     ProductImage[]
  stock                      WarehouseStock[]
  purchaseItems              RawMaterialPurchaseItem[]
  saleItems                  DistributorSaleItem[]
  accessorySales             AccessorySale[]
  distributorAccessoryStocks DistributorAccessoryStock[]
  distributorPricePickup     Float?                       @default(28.0)
  distributorPriceDelivery   Float?                       @default(35.0)
  bulkPricingTiers           BulkPricingTier[]
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Warehouse {
  id          String           @id @default(uuid())
  name        String           @unique
  location    String
  managerName String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  movements   StockMovement[]
  stock       WarehouseStock[]
}

model WarehouseStock {
  id          String    @id @default(uuid())
  warehouseId String
  productId   String
  quantity    Int       @default(0)
  reservedQty Int       @default(0)
  updatedAt   DateTime  @updatedAt
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId])
}

model StockMovement {
  id          String    @id @default(uuid())
  warehouseId String
  productId   String
  type        String
  quantity    Int
  reason      String?
  referenceId String?
  createdAt   DateTime  @default(now())
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
}

model Order {
  id                    String               @id @default(uuid())
  customerId            String
  orderType             OrderType            @default(ONETIME_ORDER)
  orderSource           OrderSource          @default(CUSTOMER_APP)
  status                OrderStatus          @default(NEW)
  subTotal              Float                @default(0.0)
  depositTotal          Float                @default(0.0)
  deliveryCharge        Float                @default(0.0)
  totalAmount           Float                @default(0.0)
  deliveryAddressId     String
  scheduledDate         DateTime?
  paymentStatus         PaymentStatus        @default(PENDING)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  deliveredAt           DateTime?
  paymentMethod         String?
  hybridSecondaryMethod String?
  timeSlot              String?
  discountTotal         Float                @default(0.0)
  promoCode             String?
  adminNotes            String?
  customer              Customer             @relation(fields: [customerId], references: [id])
  address               Address              @relation(fields: [deliveryAddressId], references: [id])
  items             OrderItem[]
  payments          Payment[]
  history           OrderStatusHistory[]
  delivery          Delivery?
  expectedReturns   OrderExpectedReturn[]
  distributorId     String?
  distributor       User?                @relation("DistributorOrders", fields: [distributorId], references: [id])
  driverId          String?
  driver            Driver?              @relation("DriverOrders", fields: [driverId], references: [id], onDelete: SetNull)
  assignmentStatus  String               @default("UNASSIGNED")
  acceptedAt        DateTime?
  acceptedById      String?
  acceptedBy        User?                @relation("AcceptedOrders", fields: [acceptedById], references: [id])
  distributorSkips  DistributorOrderSkip[]
  cancelledAt           DateTime?
  cancelledById         String?
  cancelledBy           User?                @relation("CancelledOrders", fields: [cancelledById], references: [id])
  cancellationReason    String?
  distributorAssignments DistributorOrderAssignment[]
  jarAllocations        OrderJarAllocation[]
  deliveryVerification  OrderDeliveryVerification?
  inventoryLogs         InventoryLog[]

  @@index([distributorId])
  @@index([driverId])
  @@index([assignmentStatus])
  @@index([distributorId, assignmentStatus])
}

model OrderStatusHistory {
  id              String      @id @default(uuid())
  orderId         String
  changedByUserId String?
  reason          String?
  createdAt       DateTime    @default(now())
  previousStatus  OrderStatus
  newStatus       OrderStatus
  user            User?       @relation(fields: [changedByUserId], references: [id])
  order           Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
  @@map("order_status_history")
}

model OrderItem {
  id                     String    @id @default(uuid())
  orderId                String
  productId              String
  quantity               Int
  unitPrice              Float
  deposit                Float     @default(0.0)
  total                  Float
  partnerCost            Decimal?  @db.Decimal(10, 2)
  declaredReturnQuantity Int       @default(0)
  verifiedReturnQuantity Int?
  deliveryVerifiedById   String?
  verificationTime       DateTime?
  order                  Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product                Product   @relation(fields: [productId], references: [id])
  deliveryVerifiedBy     User?     @relation("VerifiedOrderItems", fields: [deliveryVerifiedById], references: [id])
}

model Cart {
  id         String     @id @default(uuid())
  customerId String     @unique
  updatedAt  DateTime   @updatedAt
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      CartItem[]
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String
  quantity  Int
  createdAt DateTime @default(now())
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])
}

model DepositTransaction {
  id            String                 @id @default(uuid())
  customerId    String
  type          DepositTransactionType
  amount        Float                  @default(0.0)
  jarsAffected  Int                    @default(0)
  balanceBefore Float
  balanceAfter  Float
  referenceId   String?
  description   String?
  createdAt     DateTime               @default(now())
  customer      Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model JarLedger {
  id          String    @id @default(uuid())
  customerId  String
  status      JarStatus @default(ISSUED)
  quantity    Int
  referenceId String?
  createdAt   DateTime  @default(now())
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model StaffNotification {
  id        String   @id @default(uuid())
  orderId   String
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  companyId String?
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([orderId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model IdempotencyRecord {
  id        String   @id @default(uuid())
  key       String   @unique
  response  Json?
  status    String   @default("SUCCESS")
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum UserRole {
  ADMIN
  STAFF
  DELIVERY_PARTNER
  CUSTOMER
  MANAGER
  DISTRIBUTOR
}

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  MANAGE
}

enum TransactionType {
  RECHARGE
  CONSUMPTION
  REFUND
  BONUS
  DEPOSIT_PAYMENT
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  CREATED
  PROCESSING
  CANCELLED
  PARTIAL_REFUND
  EXPIRED
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum NotificationType {
  ORDER_PLACED
  ORDER_ACCEPTED
  ORDER_CONFIRMED
  OUT_FOR_DELIVERY
  DELIVERY_STARTED
  DELIVERY_COMPLETED
  DELIVERY_FAILED
  ORDER_CANCELLED
  PAYMENT_PENDING
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  PAYMENT_REFUNDED
  DELIVERY_UPDATE
  LOW_BALANCE
  RECHARGE_SUCCESS
  PROMOTION
  SYSTEM
}

enum NotificationStatus {
  UNREAD
  READ
}

enum WalletTransactionType {
  TOP_UP
  DEDUCTION
  REFUND
  BONUS
  TRANSFER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  ASSIGNED
  WAITING_FOR_CUSTOMER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PromoType {
  FIXED_DISCOUNT
  PERCENTAGE
  FREE_JARS
  WALLET_BONUS
  FREE_SHIPPING
  FIRST_ORDER
  SUBSCRIPTION
}

enum OrderType {
  ONETIME_ORDER
  SUBSCRIPTION_ORDER
}

enum OrderSource {
  CUSTOMER_APP
  STAFF_CREATED
  ADMIN_CREATED
  PHONE_ORDER
  WALK_IN
}

enum OrderStatus {
  ORDER_PLACED
  CONFIRMED
  OUT_FOR_DELIVERY
  DELIVERED
  NEW
  PENDING_PAYMENT
  PAYMENT_SUCCESS
  PENDING_ASSIGNMENT
  ASSIGNED
  ACCEPTED_BY_PARTNER
  PROCESSING
  READY
  PARTIALLY_DELIVERED
  FAILED
  CUSTOMER_NOT_AVAILABLE
  RESCHEDULED
  RETURNED
  CANCELLED
  COMPLETED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum JarStatus {
  ISSUED
  ACTIVE
  RETURNED
  REFUNDED
  LOST
  DAMAGED
}

enum DepositTransactionType {
  DEPOSIT_PAID
  DEPOSIT_REFUNDED
  JAR_RETURNED
  JAR_LOST
}

model OrderExpectedReturn {
  id        String   @id @default(uuid())
  orderId   String
  brandId   String
  quantity  Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  brand     Brand    @relation(fields: [brandId], references: [id])

  @@unique([orderId, brandId])
}

model DeliveryCollectedJar {
  id        String   @id @default(uuid())
  reportId  String
  brandId   String
  quantity  Int
  report    DeliveryReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  brand     Brand    @relation(fields: [brandId], references: [id])

  @@unique([reportId, brandId])
}

model Purchase {
  id              String    @id @default(uuid())
  purchaseNumber  String    @unique
  purchaseDate    DateTime  @default(now())
  supplierName    String
  supplierId      String?
  referenceNumber String?
  items           Json
  subtotal        Float
  tax             Float     @default(0.0)
  total           Float
  paymentStatus   String    @default("PAID")
  amountPaid      Float?    @default(0.0)
  payments        Json?     @default("[]")
  distributorId   String
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  distributor     User      @relation("DistributorPurchases", fields: [distributorId], references: [id], onDelete: Cascade)
  supplier        Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([distributorId])
  @@index([supplierId])
  @@index([purchaseDate])
}

model Supplier {
  id                 String                @id @default(uuid())
  distributorId      String
  name               String
  contactPerson      String?
  phone              String?
  email              String?
  companyName        String?
  gstin              String?
  pan                String?
  supplierType       String?
  addressLine1       String?
  addressLine2       String?
  city               String?
  state              String?
  pinCode            String?
  country            String?               @default("India")
  openingBalance     Float                 @default(0.0)
  openingBalanceType String                @default("PAYABLE")
  notes              String?
  isActive           Boolean               @default(true)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  distributor        User                  @relation("DistributorSuppliers", fields: [distributorId], references: [id], onDelete: Cascade)
  purchases          Purchase[]
  transactions       SupplierTransaction[]

  @@index([distributorId])
  @@index([name])
}

model SupplierTransaction {
  id            String   @id @default(uuid())
  supplierId    String
  distributorId String
  date          DateTime @default(now())
  type          String   // "OPENING_BALANCE", "PURCHASE", "PAYMENT"
  reference     String?
  description   String?
  debit         Float    @default(0.0)
  credit        Float    @default(0.0)
  balance       Float    @default(0.0)
  purchaseId    String?
  createdAt     DateTime @default(now())

  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([distributorId])
  @@index([date])
}

model DistributorOrderSkip {
  id            String   @id @default(uuid())
  distributorId String
  orderId       String
  action        String   @default("SKIPPED")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  distributor   User     @relation("DistributorOrderSkips", fields: [distributorId], references: [id], onDelete: Cascade)
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, distributorId])
  @@index([distributorId])
  @@index([orderId])
  @@map("distributor_order_skips")
}

model DistributorPincode {
  id            String   @id @default(uuid())
  distributorId String
  pincode       String
  location      String?
  district      String?
  state         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  distributor   User     @relation("DistributorPincodes", fields: [distributorId], references: [id], onDelete: Cascade)

  @@unique([distributorId, pincode])
  @@index([pincode])
  @@index([distributorId])
  @@map("distributor_pincodes")
}

model DistributorOrderAssignment {
  id            String    @id @default(uuid())
  orderId       String
  distributorId String
  status        String    // 'ACCEPTED', 'RELEASED', 'COMPLETED'
  acceptedAt    DateTime  @default(now())
  releasedAt    DateTime?
  releaseReason String?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  distributor   User      @relation("DistributorAssignments", fields: [distributorId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([distributorId])
  @@index([status])
  @@map("distributor_order_assignments")
}

model Driver {
  id             String    @id @default(uuid())
  distributorId  String
  name           String
  phone          String
  alternatePhone String?
  routeOrArea    String?
  pincode        String    @default("682001")
  vehicleType    String    // '2 Wheeler', '3 Wheeler', '4 Wheeler', 'Other'
  vehicleNumber  String
  notes          String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  distributor    User      @relation("DistributorDrivers", fields: [distributorId], references: [id], onDelete: Cascade)
  orders         Order[]   @relation("DriverOrders")

  @@index([distributorId])
  @@index([isActive])
  @@index([phone])
  @@index([vehicleNumber])
  @@index([pincode])
  @@map("drivers")
}

model JarInventoryItem {
  id               String                 @id @default(uuid())
  distributorId    String
  name             String
  ownershipType    String                 // 'COMPANY' | 'DISTRIBUTOR'
  imageUrl         String?
  description      String?
  ownedQuantity       Int                    @default(0)
  reservedQuantity    Int                    @default(0)
  filledYardQuantity  Int                    @default(0)
  emptyYardQuantity   Int                    @default(0)
  customerQuantity    Int                    @default(0)
  washingQuantity     Int                    @default(0)
  fillingQuantity     Int                    @default(0)
  quarantineQuantity  Int                    @default(0)
  damagedQuantity     Int                    @default(0)
  lostQuantity        Int                    @default(0)
  isActive            Boolean                @default(true)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  distributor         Distributor            @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  allocations         OrderJarAllocation[]
  inventoryLogs       InventoryLog[]

  @@index([distributorId])
  @@index([distributorId, ownershipType])
  @@index([distributorId, isActive])
  @@map("jar_inventory_items")
}

model OrderJarAllocation {
  id                  String            @id @default(uuid())
  orderId             String
  jarItemId           String
  quantity            Int
  deliveredQuantity   Int?
  undeliveredQuantity Int?
  returnedQuantity    Int?              @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  order               Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  jarItem             JarInventoryItem  @relation(fields: [jarItemId], references: [id], onDelete: Restrict)

  @@unique([orderId, jarItemId])
  @@index([orderId])
  @@index([jarItemId])
  @@map("order_jar_allocations")
}

enum DeliveryVerificationStatus {
  PENDING
  VERIFIED
  FAILED
}

model OrderDeliveryVerification {
  id                  String                     @id @default(uuid())
  orderId             String                     @unique
  otp                 String
  otpGeneratedAt      DateTime                   @default(now())
  isVerified          Boolean                    @default(false)
  verifiedAt          DateTime?
  verifiedByUserId    String?
  status              DeliveryVerificationStatus @default(PENDING)
  outForDeliveryQty   Int                        @default(0)
  deliveredQty        Int                        @default(0)
  undeliveredQty      Int                        @default(0)
  returnedQty         Int                        @default(0)
  shortDeliveryReason String?
  deliveryNotes       String?
  completedAt         DateTime?
  refillRate          Float?
  depositRate         Float?
  refillAmount        Float?
  depositQty          Int?
  depositAmount       Float?
  calculatedTotal     Float?
  amountReceived      Float?
  paymentMode         String?
  paymentMethod       String?
  isManualAdjustment  Boolean?                   @default(false)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  order               Order                      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  verifiedByUser      User?                      @relation("VerifiedDeliveries", fields: [verifiedByUserId], references: [id])

  @@index([orderId])
  @@index([isVerified])
  @@map("order_delivery_verifications")
}

enum AccountStatus {
  PENDING_PASSWORD_SETUP
  ACTIVE
  DISABLED
}

model PasswordSetupToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdBy String?
  purpose   String    @default("ACCOUNT_ACTIVATION")
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("password_setup_tokens")
}

model ProfileUpdateVerification {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpHash     String
  pendingData Json
  expiresAt   DateTime
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("profile_update_verifications")
}

model RawMaterialItem {
  id           String                        @id @default(uuid())
  name         String
  code         String                        @unique
  category     String                        @default("PACKAGING") // 'PACKAGING', 'PREFORM', 'CAP', 'LABEL', 'WATER_TREATMENT'
  unit         String                        @default("PCS")
  centralStock Int                           @default(0)
  reorderLevel Int                           @default(100)
  unitCost     Float                         @default(0.0)
  isActive     Boolean                       @default(true)
  createdAt    DateTime                      @default(now())
  updatedAt    DateTime                      @updatedAt
  stocks       DistributorRawMaterialStock[]
  movements    RawMaterialMovement[]
  purchaseItems RawMaterialPurchaseItem[]
  issueItems   MaterialIssueItem[]
  mfrStocks    ManufacturerRawMaterialStock[]

  @@map("raw_material_items")
}

model DistributorRawMaterialStock {
  id            String          @id @default(uuid())
  distributorId String
  materialId    String
  quantity      Int             @default(0)
  updatedAt     DateTime        @updatedAt

  distributor   Distributor     @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  material      RawMaterialItem @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([distributorId, materialId])
  @@index([distributorId])
  @@map("distributor_raw_material_stocks")
}

model RawMaterialMovement {
  id            String           @id @default(uuid())
  materialId    String
  distributorId String?
  type          String           // 'CENTRAL_RECEIPT', 'ISSUED_TO_DISTRIBUTOR', 'CONSUMED_IN_PRODUCTION', 'WASTAGE_REJECT', 'RETURNED_TO_EDROPS', 'MANUAL_ADJUSTMENT'
  quantity      Int
  balanceAfter  Int
  referenceId   String
  batchNumber   String?
  notes         String?
  createdById   String?
  createdAt     DateTime         @default(now())

  material      RawMaterialItem  @relation(fields: [materialId], references: [id], onDelete: Cascade)
  distributor   Distributor?     @relation(fields: [distributorId], references: [id], onDelete: SetNull)
  createdBy     User?            @relation("RawMaterialMovementCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([materialId, createdAt])
  @@index([distributorId, createdAt])
  @@index([referenceId])
  @@map("raw_material_movements")
}

model DistributorProductionBatch {
  id               String       @id @default(uuid())
  batchNumber      String       @unique
  distributorId    String
  outputQuantity   Int          @default(0)
  rejectedQuantity Int          @default(0)
  status           String       @default("COMPLETED")
  consumptions     Json?
  notes            String?
  createdById      String?
  createdAt        DateTime     @default(now())

  distributor      Distributor  @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  createdBy        User?        @relation("ProductionBatchCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([distributorId, createdAt])
  @@map("distributor_production_batches")
}

model DistributorJarSettlement {
  id                    String       @id @default(uuid())
  settlementNumber      String       @unique
  distributorId         String
  jarsSettled           Int
  unitPrice             Float
  totalAmount           Float
  paymentStatus         String       @default("PAID")
  paymentMethod         String       @default("BANK_TRANSFER")
  paymentReference      String?
  companyJarsBefore     Int
  companyJarsAfter      Int
  distributorJarsBefore Int
  distributorJarsAfter  Int
  physicalJarsTotal     Int
  notes                 String?
  createdById           String?
  createdAt             DateTime     @default(now())

  distributor           Distributor  @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  createdBy             User?        @relation("JarSettlementCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([distributorId, createdAt])
  @@index([settlementNumber])
  @@map("distributor_jar_settlements")
}




// ==============================================================================
// BIODROPS PRODUCT ECOSYSTEM, PROCUREMENT & MANUFACTURING
// ==============================================================================

model Vendor {
  id               String                       @id @default(uuid())
  name             String
  contactPerson    String?
  phone            String?
  email            String?
  gstin            String?
  pan              String?
  address          String?
  city             String?
  state            String?
  pinCode          String?
  bankName         String?
  accountNumber    String?
  ifscCode         String?
  openingBalance   Float                        @default(0.0)
  currentBalance   Float                        @default(0.0)
  isActive         Boolean                      @default(true)
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  purchaseInvoices RawMaterialPurchaseInvoice[]
  ledgerEntries    VendorLedgerEntry[]

  @@map("vendors")
}

model VendorLedgerEntry {
  id              String   @id @default(uuid())
  vendorId        String
  date            DateTime @default(now())
  type            String   // 'PURCHASE_INVOICE', 'PAYMENT', 'OPENING_BALANCE', 'ADJUSTMENT'
  referenceNumber String?
  description     String?
  debit           Float    @default(0.0) // Payment made to vendor
  credit          Float    @default(0.0) // Bill received from vendor
  balance         Float    @default(0.0)
  invoiceId       String?
  createdAt       DateTime @default(now())
  vendor          Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, date])
  @@map("vendor_ledger_entries")
}

model RawMaterialPurchaseInvoice {
  id            String                    @id @default(uuid())
  invoiceNumber String                    @unique
  invoiceDate   DateTime                  @default(now())
  vendorId      String
  subtotal      Float
  cgst          Float                     @default(0.0)
  sgst          Float                     @default(0.0)
  igst          Float                     @default(0.0)
  taxAmount     Float                     @default(0.0)
  totalAmount   Float
  paymentStatus String                    @default("PENDING") // PENDING, PARTIALLY_PAID, PAID
  amountPaid    Float                     @default(0.0)
  payments      Json?                     @default("[]")
  stockUpdated  Boolean                   @default(false)
  notes         String?
  createdById   String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  vendor        Vendor                    @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  items         RawMaterialPurchaseItem[]

  @@index([vendorId, invoiceDate])
  @@index([invoiceNumber])
  @@map("raw_material_purchase_invoices")
}

model RawMaterialPurchaseItem {
  id            String                     @id @default(uuid())
  invoiceId     String
  materialId    String
  productId     String?
  quantity      Int
  unitPrice     Float
  hsnCode       String?
  gstRate       Float                      @default(0.0)
  taxableAmount Float
  cgst          Float                      @default(0.0)
  sgst          Float                      @default(0.0)
  igst          Float                      @default(0.0)
  totalAmount   Float
  invoice       RawMaterialPurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  material      RawMaterialItem            @relation(fields: [materialId], references: [id], onDelete: Restrict)
  product       Product?                   @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("raw_material_purchase_items")
}

model ManufacturingCompany {
  id                   String                         @id @default(uuid())
  name                 String
  externalTenantId     String?                        @unique // Upstream Aquora / Biofix tenant ID
  gstin                String?
  address              String?
  city                 String?
  state                String?
  contactPerson        String?
  phone                String?
  email                String?
  bankName             String?
  accountNumber        String?
  ifscCode             String?
  defaultCoPackingRate Float                          @default(15.0)
  currentPayable       Float                          @default(0.0)
  isActive             Boolean                        @default(true)
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt
  rates                ManufacturerCoPackingRate[]
  materialIssues       MaterialIssueChallan[]
  productionBatches    ManufacturingBatch[]
  invoices             ManufacturerServiceInvoice[]
  ledgerEntries        ManufacturerLedgerEntry[]
  stocks               ManufacturerRawMaterialStock[]

  @@map("manufacturing_companies")
}

model ManufacturerCoPackingRate {
  id             String               @id @default(uuid())
  manufacturerId String
  productId      String?
  rate           Float
  effectiveFrom  DateTime             @default(now())
  effectiveTo    DateTime?
  notes          String?
  createdAt      DateTime             @default(now())
  manufacturer   ManufacturingCompany @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)

  @@index([manufacturerId])
  @@map("manufacturer_copacking_rates")
}

model ManufacturerRawMaterialStock {
  id             String               @id @default(uuid())
  manufacturerId String
  materialId     String
  quantity       Int                  @default(0)
  updatedAt      DateTime             @updatedAt
  manufacturer   ManufacturingCompany @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
  material       RawMaterialItem      @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([manufacturerId, materialId])
  @@index([manufacturerId])
  @@map("manufacturer_raw_material_stocks")
}

model MaterialIssueChallan {
  id             String               @id @default(uuid())
  challanNumber  String               @unique
  issueDate      DateTime             @default(now())
  manufacturerId String
  warehouseId    String?
  status         String               @default("ISSUED") // ISSUED, RECEIVED_BY_MFR, RECONCILED, CANCELLED
  notes          String?
  createdById    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  manufacturer   ManufacturingCompany @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  items          MaterialIssueItem[]

  @@index([manufacturerId, issueDate])
  @@index([challanNumber])
  @@map("material_issue_challans")
}

model MaterialIssueItem {
  id               String               @id @default(uuid())
  challanId        String
  materialId       String
  quantity         Int
  returnedQuantity Int                  @default(0)
  consumedQuantity Int                  @default(0)
  wastedQuantity   Int                  @default(0)
  challan          MaterialIssueChallan @relation(fields: [challanId], references: [id], onDelete: Cascade)
  material         RawMaterialItem      @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@map("material_issue_items")
}

model ManufacturingBatch {
  id                   String               @id @default(uuid())
  batchNumber          String               @unique
  manufacturerId       String
  productId            String?
  challanId            String?
  productionDate       DateTime             @default(now())
  plannedQuantity      Int
  actualQuantity       Int
  rejectedQuantity     Int                  @default(0)
  acceptedQuantity     Int                  @default(0)
  qcPassedQuantity     Int                  @default(0)
  qcRejectedQuantity   Int                  @default(0)
  qcStatus             String               @default("PENDING") // PENDING, PASSED, REJECTED, PARTIALLY_PASSED
  qcNotes              String?
  qcApprovedAt         DateTime?
  qcApprovedById       String?
  goodsReceiptRecorded Boolean              @default(false)
  coPackingRate        Float                @default(15.0)
  coPackingCost        Float                @default(0.0)
  consumablesCost      Float                @default(0.0)
  totalProductionCost  Float                @default(0.0)
  unitCost             Float                @default(0.0)
  consumptions         Json?                // Array of { materialId, consumed, wasted, returned }
  notes                String?
  createdById          String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  manufacturer         ManufacturingCompany @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)

  @@index([manufacturerId, productionDate])
  @@index([batchNumber])
  @@map("manufacturing_batches")
}

model ManufacturerServiceInvoice {
  id              String               @id @default(uuid())
  invoiceNumber   String               @unique
  invoiceDate     DateTime             @default(now())
  manufacturerId  String
  batchId         String?
  sacCode         String               @default("9988")
  serviceQuantity Int
  coPackingRate   Float
  taxableAmount   Float
  gstRate         Float                @default(18.0)
  cgst            Float                @default(0.0)
  sgst            Float                @default(0.0)
  igst            Float                @default(0.0)
  totalAmount     Float
  paymentStatus   String               @default("PENDING") // PENDING, PARTIALLY_PAID, PAID
  amountPaid      Float                @default(0.0)
  payments        Json?                @default("[]")
  notes           String?
  createdById     String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  manufacturer    ManufacturingCompany @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)

  @@index([manufacturerId, invoiceDate])
  @@index([invoiceNumber])
  @@map("manufacturer_service_invoices")
}

model ManufacturerLedgerEntry {
  id              String               @id @default(uuid())
  manufacturerId  String
  date            DateTime             @default(now())
  type            String               // SERVICE_INVOICE, PAYMENT, ADJUSTMENT
  referenceNumber String?
  description     String?
  debit           Float                @default(0.0) // Payment made to manufacturer
  credit          Float                @default(0.0) // Service bill from manufacturer
  balance         Float                @default(0.0)
  invoiceId       String?
  createdAt       DateTime             @default(now())
  manufacturer    ManufacturingCompany @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)

  @@index([manufacturerId, date])
  @@map("manufacturer_ledger_entries")
}

model DistributorSale {
  id                String                @id @default(uuid())
  invoiceNumber     String                @unique
  saleDate          DateTime              @default(now())
  distributorId     String
  warehouseId       String?
  deliveryRequired  Boolean               @default(false)
  subtotal          Float
  discount          Float                 @default(0.0)
  cgst              Float                 @default(0.0)
  sgst              Float                 @default(0.0)
  igst              Float                 @default(0.0)
  taxAmount         Float                 @default(0.0)
  totalAmount       Float
  paymentStatus     String                @default("PAID") // PAID, CREDIT, PARTIAL
  paymentMethod     String                @default("BANK_TRANSFER") // CASH, BANK_TRANSFER, UPI, CREDIT
  amountPaid        Float                 @default(0.0)
  outstandingAmount Float                 @default(0.0)
  payments          Json?                 @default("[]")
  orderStage        String                @default("INVOICE") // QUOTATION, CONFIRMED, DISPATCHED, INVOICE, CANCELLED
  externalSource    String?               @default("EDROPS") // EDROPS or AQUZIO
  externalBillId    String?
  dispatchedQuantity Int?
  dispatchDate      DateTime?
  notes             String?
  createdById       String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  distributor       Distributor           @relation(fields: [distributorId], references: [id], onDelete: Restrict)
  items             DistributorSaleItem[]

  @@index([distributorId, saleDate])
  @@index([invoiceNumber])
  @@map("distributor_sales")
}

model DistributorSaleItem {
  id            String          @id @default(uuid())
  saleId        String
  productId     String
  quantity      Int
  unitPrice     Float           // 28.0 (pickup) or 35.0 (delivery-inclusive)
  discount      Float           @default(0.0)
  hsnCode       String?
  gstRate       Float           @default(18.0)
  taxableAmount Float
  cgst          Float           @default(0.0)
  sgst          Float           @default(0.0)
  igst          Float           @default(0.0)
  totalAmount   Float
  sale          DistributorSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product       Product         @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("distributor_sale_items")
}

model DistributorOwnershipLedger {
  id                    String      @id @default(uuid())
  transactionNumber     String      @unique
  distributorId         String
  type                  String      // INITIAL_ISSUE, PAYMENT_TRANSFER, RETURN_ADJUSTMENT, CORRECTION
  companyJarsBefore     Int
  distributorJarsBefore Int
  companyJarsAfter      Int
  distributorJarsAfter  Int
  jarsTransferred       Int
  ratePerJar            Float       @default(250.0)
  settlementAmount      Float
  paymentReference      String?
  paymentMethod         String?
  notes                 String?
  createdById           String?
  createdAt             DateTime    @default(now())
  distributor           Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)

  @@index([distributorId, createdAt])
  @@index([transactionNumber])
  @@map("distributor_ownership_ledgers")
}

model AccessorySale {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique
  saleDate      DateTime @default(now())
  channel       String   // EDROPS_TO_DISTRIBUTOR, DISTRIBUTOR_TO_CUSTOMER, EDROPS_TO_CUSTOMER
  distributorId String?
  customerId    String?
  productId     String
  quantity      Int
  unitPrice     Float
  discount      Float    @default(0.0)
  gstRate       Float    @default(18.0)
  taxableAmount Float
  taxAmount     Float
  totalAmount   Float
  paymentStatus String   @default("PAID")
  paymentMethod String   @default("UPI")
  notes         String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  product       Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([channel, saleDate])
  @@index([distributorId])
  @@index([customerId])
  @@map("accessory_sales")
}

model DistributorAccessoryStock {
  id            String      @id @default(uuid())
  distributorId String
  productId     String
  quantity      Int         @default(0)
  updatedAt     DateTime    @updatedAt
  distributor   Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([distributorId, productId])
  @@index([distributorId])
  @@map("distributor_accessory_stocks")
}

model SubscriptionPlanConfig {
  id                    String   @id @default(uuid())
  packageId             String   @unique
  waterQuotaPerCycle    Int      @default(30)
  freeAccessories       Json?    // array of { productId, quantity }
  discountedAccessories Json?    // array of { productId, discountedPrice }
  promotionalBadge      String?
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  package               Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@map("subscription_plan_configs")
}

model BulkPricingTier {
  id            String   @id @default(uuid())
  productId     String
  minQuantity   Int
  maxQuantity   Int?
  pickupPrice   Float
  deliveryPrice Float
  isActive      Boolean  @default(true)
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, minQuantity])
  @@map("bulk_pricing_tiers")
}

model AquzioSyncLog {
  id               String   @id @default(uuid())
  syncType         String
  status           String
  externalBatchId  String?
  acceptedQuantity Int?
  rejectedQuantity Int?
  idempotencyKey   String   @unique
  details          Json?
  syncedAt         DateTime @default(now())

  @@index([syncType, syncedAt])
  @@map("aquzio_sync_logs")
}

model Expense {
  id               String   @id @default(uuid())
  category         String   // FUEL, RENT, SALARIES, MAINTENANCE, UTILITIES, MARKETING, PACKAGING, OTHER
  title            String
  amount           Float
  expenseDate      DateTime @default(now())
  paymentMethod    String   @default("CASH") // CASH, BANK_TRANSFER, UPI, CHEQUE
  paymentStatus    String   @default("PAID") // PENDING, PAID
  status           String   @default("APPROVED") // DRAFT, PENDING_APPROVAL, APPROVED, REJECTED
  vendorName       String?
  invoiceNumber    String?
  receiptUrl       String?
  notes            String?
  createdByUserId  String?
  approvedByUserId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([category, expenseDate])
  @@index([status])
  @@map("expenses")
}

model DistributorExpense {
  id               String      @id @default(uuid())
  distributorId    String
  category         String      // FUEL, VEHICLE_MAINTENANCE, DRIVER_SALARY, HELPER_SALARY, RENT, ELECTRICITY, WATER, LOADING_UNLOADING, TRANSPORTATION, PACKAGING, INTERNET, MARKETING, REPAIRS, BANK_CHARGES, OTHER
  title            String
  amount           Float
  expenseDate      DateTime    @default(now())
  paymentMethod    String      @default("CASH") // CASH, BANK_TRANSFER, UPI, CHEQUE
  paymentStatus    String      @default("PAID") // PENDING, PAID
  status           String      @default("APPROVED") // DRAFT, PENDING_APPROVAL, APPROVED, REJECTED, CANCELLED
  vendorName       String?
  invoiceNumber    String?
  receiptUrl       String?
  description      String?
  createdById      String?
  approvedById     String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  distributor      Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)

  @@index([distributorId, expenseDate])
  @@index([distributorId, category])
  @@index([status])
  @@map("distributor_expenses")
}

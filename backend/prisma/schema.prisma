generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String               @id @default(uuid())
  email                String?              @unique
  passwordHash         String
  role                 UserRole             @default(CUSTOMER)
  firstName            String
  lastName             String
  phone                String               @unique
  alternatePhone       String?
  gender               String?
  dateOfBirth          DateTime?            @db.Date
  phoneVerified        Boolean              @default(false)
  phoneVerifiedAt      DateTime?
  isActive             Boolean              @default(true)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  admin                Admin?
  auditLogs            AuditLog[]
  customer             Customer?
  deliveryPartner      DeliveryPartner?
  notifications        Notification[]
  staff                Staff?
  supportActivities    SupportActivityLog[]
  supportMessages      SupportMessage[]
  assignedTickets      SupportTicket[]      @relation("TicketAssignee")
  ticketReplies        TicketReply[]
  statusUpdates        OrderStatusHistory[]
  verifiedOrderItems   OrderItem[]          @relation("VerifiedOrderItems")

  @@index([email])
  @@index([phone])
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  permissions Permission[]
}

model Permission {
  id       String           @id @default(uuid())
  roleId   String
  resource String
  action   PermissionAction
  role     Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
}

model Customer {
  id                  String               @id @default(uuid())
  userId              String               @unique
  referralCode        String?              @unique
  referredById        String?
  isWalkIn            Boolean              @default(false)
  
  customerType        String?              @default("RESIDENTIAL")
  gstNumber           String?              @unique
  companyName         String?
  contactPerson       String?
  businessCategory    String?
  
  createdById         String?
  updatedById         String?
  branchId            String?
  tenantId            String?
  source              String?
  createdFrom         String?

  addresses           Address[]
  cart                Cart?
  forecast            ConsumptionForecast?
  referredBy          Customer?            @relation("ReferralRelation", fields: [referredById], references: [id])
  referrals           Customer[]           @relation("ReferralRelation")
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  healthMetrics       CustomerHealth?
  deliveries          Delivery[]
  deliverySchedule    DeliverySchedule?
  depositTransactions DepositTransaction[]
  invoices            InvoiceRecord[]
  jarBalances         JarBalance[]
  jarDeposits         JarDeposit[]
  jarLedgers          JarLedger[]
  jarOwnerships       JarOwnership[]
  orders              Order[]
  packagePurchases    PackagePurchase[]
  payments            Payment[]
  promoRedemptions    PromoRedemption[]
  rewardsReceived     ReferralReward[]     @relation("ReferralRewardReceiver")
  rewardsGiven        ReferralReward[]     @relation("ReferralRewardProvider")
  supportTickets      SupportTicket[]
  transactions        Transaction[]
  wallet              Wallet?

  @@index([userId])
}

model Staff {
  id               String           @id @default(uuid())
  userId           String           @unique
  branchId         String?
  vehicleType      String?
  vehiclePlate     String?
  confirmedReports DeliveryReport[]
  branch           Branch?          @relation(fields: [branchId], references: [id])
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DeliveryPartner {
  id           String               @id @default(uuid())
  userId       String               @unique
  vehicleType  String?
  vehiclePlate String?
  assignments  DeliveryAssignment[]
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Admin {
  id     String @id @default(uuid())
  userId String @unique
  level  Int    @default(1)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Branch {
  id          String  @id @default(uuid())
  name        String
  location    String
  contactInfo String?
  staff       Staff[]
}

model Address {
  id           String     @id @default(uuid())
  customerId   String
  label        String?
  street       String
  city         String
  state        String
  zipCode      String
  country      String     @default("India")
  isDefault    Boolean    @default(false)
  latitude     Float?
  longitude    Float?
  area         String?
  buildingName String?
  fullName     String?
  houseName    String?
  landmark     String?
  mobileNumber String?
  customer     Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deliveries   Delivery[]
  orders       Order[]
}

model Package {
  id              String            @id @default(uuid())
  name            String
  description     String?
  jarCount        Int
  price           Float
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  discountPercent Float?
  displayOrder    Int               @default(0)
  endDate         DateTime?
  offerLabel      String?
  originalPrice   Float?
  packageBadge    String?
  packageColor    String?
  startDate       DateTime?
  purchases       PackagePurchase[]

  @@index([isActive])
}

model PackagePurchase {
  id            String        @id @default(uuid())
  customerId    String
  packageId     String
  amount        Float
  paymentStatus PaymentStatus @default(PENDING)
  paymentId     String?       @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  package       Package       @relation(fields: [packageId], references: [id])

  @@index([customerId])
  @@index([paymentStatus])
}

model DeliverySchedule {
  id         String                 @id @default(uuid())
  customerId String                 @unique
  isActive   Boolean                @default(true)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  customer   Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rules      DeliveryScheduleRule[]

  @@index([customerId])
}

model DeliveryScheduleRule {
  id                 String           @id @default(uuid())
  deliveryScheduleId String
  type               String
  dayOfWeek          Int?
  quantity           Int
  intervalDays       Int?
  startDate          DateTime         @default(now())
  customNotes        String?
  deliverySchedule   DeliverySchedule @relation(fields: [deliveryScheduleId], references: [id], onDelete: Cascade)
}

model Delivery {
  id               String              @id @default(uuid())
  customerId       String
  addressId        String
  scheduledFor     DateTime            @db.Date
  requiredQuantity Int
  status           OrderStatus         @default(PENDING_ASSIGNMENT)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  cancelledAt      DateTime?
  completedAt      DateTime?
  timeSlot         String?
  address          Address             @relation(fields: [addressId], references: [id])
  customer         Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignment       DeliveryAssignment?
  report           DeliveryReport?
  orderId          String?             @unique
  order            Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([customerId, scheduledFor])
  @@index([status])
}

model DeliveryAssignment {
  id                String          @id @default(uuid())
  deliveryId        String          @unique
  deliveryPartnerId String
  assignedAt        DateTime        @default(now())
  delivery          Delivery        @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  deliveryPartner   DeliveryPartner @relation(fields: [deliveryPartnerId], references: [id])
}

model DeliveryReport {
  id                      String    @id @default(uuid())
  deliveryId              String    @unique
  partnerDeliveredQty     Int
  partnerEmptyCollected   Int
  partnerNotes            String?
  partnerSubmittedAt      DateTime  @default(now())
  confirmedDeliveredQty   Int?
  confirmedEmptyCollected Int?
  confirmedDamagedQty     Int?      @default(0)
  staffNotes              String?
  confirmedAt             DateTime?
  confirmedById           String?
  confirmedBy             Staff?    @relation(fields: [confirmedById], references: [id])
  delivery                Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  collectedJars           DeliveryCollectedJar[]
}

model JarBalance {
  id             String   @id @default(uuid())
  customerId     String
  brandId        String
  availableJars  Int      @default(0)
  totalPurchased Int      @default(0)
  updatedAt      DateTime @updatedAt
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  brand          Brand    @relation(fields: [brandId], references: [id])

  @@unique([customerId, brandId])
}

model JarDeposit {
  id            String   @id @default(uuid())
  customerId    String
  brandId       String
  maxActiveJars Int      @default(0)
  depositPaid   Float    @default(0.0)
  depositDue    Float    @default(0.0)
  updatedAt     DateTime @updatedAt
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  brand         Brand    @relation(fields: [brandId], references: [id])

  @@unique([customerId, brandId])
}

model JarOwnership {
  id              String   @id @default(uuid())
  customerId      String
  brandId         String
  companyJarsHeld Int      @default(0)
  ownedJars       Int      @default(0)
  updatedAt       DateTime @updatedAt
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  brand           Brand    @relation(fields: [brandId], references: [id])

  @@unique([customerId, brandId])
}

model Transaction {
  id            String          @id @default(uuid())
  customerId    String
  type          TransactionType
  amountJars    Int             @default(0)
  amountMoney   Float           @default(0.0)
  balanceBefore Int
  balanceAfter  Int
  referenceId   String?
  description   String?
  createdAt     DateTime        @default(now())
  customer      Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([type])
}

model Notification {
  id        String             @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  status    NotificationStatus @default(UNREAD)
  link      String?
  createdAt DateTime           @default(now())
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Settings {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
}

model Report {
  id          String   @id @default(uuid())
  name        String
  type        String
  dateRange   String?
  data        Json
  generatedAt DateTime @default(now())
}

model AnalyticsSnapshot {
  id                 String   @id @default(uuid())
  date               DateTime @unique @db.Date
  totalCustomers     Int
  totalJarsDelivered Int
  totalRevenue       Float
  createdAt          DateTime @default(now())
  activeSchedules    Int      @default(0)
}

model Wallet {
  id           String              @id @default(uuid())
  customerId   String              @unique
  balance      Float               @default(0.0)
  currency     String              @default("INR")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  customer     Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id            String                @id @default(uuid())
  walletId      String
  type          WalletTransactionType
  amount        Float
  balanceBefore Float
  balanceAfter  Float
  referenceId   String?
  description   String?
  createdAt     DateTime              @default(now())
  wallet        Wallet                @relation(fields: [walletId], references: [id], onDelete: Cascade)
}

model Payment {
  id          String            @id @default(uuid())
  customerId  String
  amount      Float
  currency    String            @default("INR")
  status      PaymentStatus     @default(PENDING)
  provider    String            @default("RAZORPAY")
  providerId  String?
  receiptId   String?
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  orderId     String?
  customer    Customer          @relation(fields: [customerId], references: [id])
  order       Order?            @relation(fields: [orderId], references: [id])
  attempts    PaymentAttempt[]
  auditLogs   PaymentAuditLog[]
  logs        PaymentLog[]
  refunds     PaymentRefund[]
}

model PaymentLog {
  id        String   @id @default(uuid())
  paymentId String
  status    String
  payload   Json?
  createdAt DateTime @default(now())
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model PaymentAttempt {
  id           String   @id @default(uuid())
  paymentId    String
  providerId   String?
  status       String
  errorMessage String?
  errorCode    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  payment      Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model PaymentRefund {
  id              String   @id @default(uuid())
  paymentId       String
  providerId      String?
  amount          Float
  status          String
  reason          String?
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model PaymentWebhookLog {
  id           String    @id @default(uuid())
  provider     String    @default("RAZORPAY")
  eventId      String    @unique
  eventType    String
  payload      Json
  status       String    @default("PENDING")
  errorMessage String?
  createdAt    DateTime  @default(now())
  headers      Json?
  processedAt  DateTime?
  retryCount   Int       @default(0)
  signature    String?
  sourceIp     String?
}

model PaymentAuditLog {
  id             String   @id @default(uuid())
  paymentId      String
  action         String
  previousStatus String?
  newStatus      String
  notes          String?
  createdAt      DateTime @default(now())
  payment        Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model InvoiceRecord {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique
  customerId    String
  orderId       String?
  rechargeId    String?
  amount        Float
  tax           Float    @default(0.0)
  total         Float
  pdfUrl        String?
  createdAt     DateTime @default(now())
  customer      Customer @relation(fields: [customerId], references: [id])
}

model PromoCampaign {
  id          String      @id @default(uuid())
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  codes       PromoCode[]
}

model PromoCode {
  id                    String            @id @default(uuid())
  code                  String            @unique
  campaignId            String
  type                  PromoType
  discountValue         Float?
  bonusJars             Int?
  maxUses               Int?
  currentUses           Int               @default(0)
  isActive              Boolean           @default(true)
  createdAt             DateTime          @default(now())
  createdBy             String?
  description           String?
  endDate               DateTime?
  maximumDiscountAmount Float?
  minimumOrderAmount    Float             @default(0.0)
  perUserLimit          Int               @default(1)
  startDate             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  campaign              PromoCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  redemptions           PromoRedemption[]
}

model PromoRedemption {
  id          String    @id @default(uuid())
  promoCodeId String
  customerId  String
  redeemedAt  DateTime  @default(now())
  customer    Customer  @relation(fields: [customerId], references: [id])
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id])
}

model ReferralTier {
  id            String  @id @default(uuid())
  name          String
  requiredCount Int
  bonusJars     Int     @default(0)
  walletBonus   Float   @default(0.0)
  isActive      Boolean @default(true)
}

model ReferralReward {
  id          String   @id @default(uuid())
  referrerId  String
  refereeId   String
  rewardGiven Boolean  @default(false)
  jarsAdded   Int      @default(0)
  walletAdded Float    @default(0.0)
  createdAt   DateTime @default(now())
  referee     Customer @relation("ReferralRewardReceiver", fields: [refereeId], references: [id])
  referrer    Customer @relation("ReferralRewardProvider", fields: [referrerId], references: [id])
}

model SupportTicket {
  id           String               @id @default(uuid())
  customerId   String
  subject      String
  description  String
  status       TicketStatus         @default(OPEN)
  priority     TicketPriority       @default(MEDIUM)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  assignedToId String?
  category     String?
  imageUrl     String?
  invoiceUrl   String?
  activities   SupportActivityLog[]
  messages     SupportMessage[]
  assignedTo   User?                @relation("TicketAssignee", fields: [assignedToId], references: [id])
  customer     Customer             @relation(fields: [customerId], references: [id])
  replies      TicketReply[]
}

model TicketReply {
  id         String        @id @default(uuid())
  ticketId   String
  userId     String
  message    String
  isInternal Boolean       @default(false)
  createdAt  DateTime      @default(now())
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id])
}

model SupportMessage {
  id          String              @id @default(uuid())
  ticketId    String
  userId      String
  message     String
  isInternal  Boolean             @default(false)
  createdAt   DateTime            @default(now())
  attachments SupportAttachment[]
  ticket      SupportTicket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id])
}

model SupportAttachment {
  id        String         @id @default(uuid())
  messageId String
  fileUrl   String
  fileName  String
  fileType  String
  createdAt DateTime       @default(now())
  message   SupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model SupportActivityLog {
  id        String        @id @default(uuid())
  ticketId  String
  userId    String?
  action    String
  details   String?
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User?         @relation(fields: [userId], references: [id])
}

model CustomerHealth {
  id             String   @id @default(uuid())
  customerId     String   @unique
  healthScore    Int      @default(100)
  retentionRisk  String   @default("LOW")
  lastCalculated DateTime @default(now())
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model ConsumptionForecast {
  id                      String    @id @default(uuid())
  customerId              String    @unique
  avgJarsPerWeek          Float     @default(0.0)
  estimatedDepletionDate  DateTime?
  nextRecommendedRecharge DateTime?
  updatedAt               DateTime  @updatedAt
  customer                Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Inventory {
  id          String   @id @default(uuid())
  filledJars  Int      @default(0)
  emptyJars   Int      @default(0)
  damagedJars Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model InventoryLog {
  id          String   @id @default(uuid())
  action      String
  filledQty   Int      @default(0)
  emptyQty    Int      @default(0)
  damagedQty  Int      @default(0)
  referenceId String?
  description String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  logoUrl     String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products      Product[]
  jarBalances   JarBalance[]
  jarDeposits            JarDeposit[]
  jarOwnerships          JarOwnership[]
  orderExpectedReturns   OrderExpectedReturn[]
  deliveryCollectedJars  DeliveryCollectedJar[]
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  imageUrl    String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id            String           @id @default(uuid())
  name          String
  description   String?
  price         Float
  brandId       String
  categoryId    String
  status        ProductStatus    @default(ACTIVE)
  isJar         Boolean          @default(false)
  depositAmount Float            @default(0.0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  cartItems     CartItem[]
  orderItems    OrderItem[]
  brand         Brand            @relation(fields: [brandId], references: [id])
  category      Category         @relation(fields: [categoryId], references: [id])
  images        ProductImage[]
  stock         WarehouseStock[]
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Warehouse {
  id          String           @id @default(uuid())
  name        String           @unique
  location    String
  managerName String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  movements   StockMovement[]
  stock       WarehouseStock[]
}

model WarehouseStock {
  id          String    @id @default(uuid())
  warehouseId String
  productId   String
  quantity    Int       @default(0)
  reservedQty Int       @default(0)
  updatedAt   DateTime  @updatedAt
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId])
}

model StockMovement {
  id          String    @id @default(uuid())
  warehouseId String
  productId   String
  type        String
  quantity    Int
  reason      String?
  referenceId String?
  createdAt   DateTime  @default(now())
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
}

model Order {
  id                    String               @id @default(uuid())
  customerId            String
  orderType             OrderType            @default(ONETIME_ORDER)
  orderSource           OrderSource          @default(CUSTOMER_APP)
  status                OrderStatus          @default(NEW)
  subTotal              Float                @default(0.0)
  depositTotal          Float                @default(0.0)
  deliveryCharge        Float                @default(0.0)
  totalAmount           Float                @default(0.0)
  deliveryAddressId     String
  scheduledDate         DateTime?
  paymentStatus         PaymentStatus        @default(PENDING)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  paymentMethod         String               @default("ONLINE")
  hybridSecondaryMethod String?
  timeSlot              String?
  discountTotal         Float                @default(0.0)
  promoCode             String?
  adminNotes            String?
  customer              Customer             @relation(fields: [customerId], references: [id])
  address               Address              @relation(fields: [deliveryAddressId], references: [id])
  items             OrderItem[]
  payments          Payment[]
  history           OrderStatusHistory[]
  delivery          Delivery?
  expectedReturns   OrderExpectedReturn[]
}

model OrderStatusHistory {
  id              String      @id @default(uuid())
  orderId         String
  changedByUserId String?
  reason          String?
  createdAt       DateTime    @default(now())
  previousStatus  OrderStatus
  newStatus       OrderStatus
  user            User?       @relation(fields: [changedByUserId], references: [id])
  order           Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
  @@map("order_status_history")
}

model OrderItem {
  id                     String    @id @default(uuid())
  orderId                String
  productId              String
  quantity               Int
  unitPrice              Float
  deposit                Float     @default(0.0)
  total                  Float
  declaredReturnQuantity Int       @default(0)
  verifiedReturnQuantity Int?
  deliveryVerifiedById   String?
  verificationTime       DateTime?
  order                  Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product                Product   @relation(fields: [productId], references: [id])
  deliveryVerifiedBy     User?     @relation("VerifiedOrderItems", fields: [deliveryVerifiedById], references: [id])
}

model Cart {
  id         String     @id @default(uuid())
  customerId String     @unique
  updatedAt  DateTime   @updatedAt
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      CartItem[]
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String
  quantity  Int
  createdAt DateTime @default(now())
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])
}

model DepositTransaction {
  id            String                 @id @default(uuid())
  customerId    String
  type          DepositTransactionType
  amount        Float                  @default(0.0)
  jarsAffected  Int                    @default(0)
  balanceBefore Float
  balanceAfter  Float
  referenceId   String?
  description   String?
  createdAt     DateTime               @default(now())
  customer      Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model JarLedger {
  id          String    @id @default(uuid())
  customerId  String
  status      JarStatus @default(ISSUED)
  quantity    Int
  referenceId String?
  createdAt   DateTime  @default(now())
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model StaffNotification {
  id        String   @id @default(uuid())
  orderId   String
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  companyId String?
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([orderId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model IdempotencyRecord {
  id        String   @id @default(uuid())
  key       String   @unique
  response  Json?
  status    String   @default("SUCCESS")
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum UserRole {
  ADMIN
  STAFF
  DELIVERY_PARTNER
  CUSTOMER
  MANAGER
}

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  MANAGE
}

enum TransactionType {
  RECHARGE
  CONSUMPTION
  REFUND
  BONUS
  DEPOSIT_PAYMENT
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  CREATED
  PROCESSING
  CANCELLED
  PARTIAL_REFUND
  EXPIRED
}

enum NotificationType {
  DELIVERY_UPDATE
  LOW_BALANCE
  RECHARGE_SUCCESS
  PROMOTION
  SYSTEM
}

enum NotificationStatus {
  UNREAD
  READ
}

enum WalletTransactionType {
  TOP_UP
  DEDUCTION
  REFUND
  BONUS
  TRANSFER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  ASSIGNED
  WAITING_FOR_CUSTOMER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PromoType {
  FIXED_DISCOUNT
  PERCENTAGE
  FREE_JARS
  WALLET_BONUS
  FREE_SHIPPING
  FIRST_ORDER
  SUBSCRIPTION
}

enum OrderType {
  ONETIME_ORDER
  SUBSCRIPTION_ORDER
}

enum OrderSource {
  CUSTOMER_APP
  STAFF_CREATED
  ADMIN_CREATED
  PHONE_ORDER
  WALK_IN
}

enum OrderStatus {
  NEW
  PENDING_PAYMENT
  PAYMENT_SUCCESS
  PENDING_ASSIGNMENT
  ASSIGNED
  ACCEPTED_BY_PARTNER
  OUT_FOR_DELIVERY
  DELIVERED
  PARTIALLY_DELIVERED
  FAILED
  CUSTOMER_NOT_AVAILABLE
  RESCHEDULED
  RETURNED
  CANCELLED
  COMPLETED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum JarStatus {
  ISSUED
  ACTIVE
  RETURNED
  REFUNDED
  LOST
  DAMAGED
}

enum DepositTransactionType {
  DEPOSIT_PAID
  DEPOSIT_REFUNDED
  JAR_RETURNED
  JAR_LOST
}

model OrderExpectedReturn {
  id        String   @id @default(uuid())
  orderId   String
  brandId   String
  quantity  Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  brand     Brand    @relation(fields: [brandId], references: [id])

  @@unique([orderId, brandId])
}

model DeliveryCollectedJar {
  id        String   @id @default(uuid())
  reportId  String
  brandId   String
  quantity  Int
  report    DeliveryReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  brand     Brand    @relation(fields: [brandId], references: [id])

  @@unique([reportId, brandId])
}
